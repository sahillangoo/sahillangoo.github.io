{
  "name": "sahillangoo-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "astro": "astro",
    "audit:lighthouse": "node scripts/audit-lighthouse.mjs",
    "audit:lighthouse:ci": "node scripts/audit-lighthouse.mjs --ci",
    "audit:links": "node scripts/audit-links.mjs",
    "audit:links:all": "node scripts/audit-links.mjs --all",
    "audit:schema": "node scripts/audit-rich-results.mjs",
    "audit:seo": "node scripts/audit-rich-results.mjs && node scripts/audit-links.mjs && node scripts/verify-production.mjs",
    "prebuild": "pnpm lint:ai",
    "build": "astro build",
    "check": "astro check",
    "deploy": "wrangler pages deploy ./dist --project-name sahillangoo-portfolio --commit-dirty=true",
    "dev": "astro dev",
    "fix:ai": "node scripts/lint-ai-slop.mjs --fix",
    "format": "prettier --cache --write .",
    "format:check": "prettier --cache --check .",
    "generate:resumes": "node --experimental-strip-types scripts/resume-generator/generate.ts",
    "lint": "oxlint && knip --dependencies && eslint --cache . && pnpm lint:ai",
    "lint:ai": "node scripts/lint-ai-slop.mjs",
    "lint:ai:strict": "node scripts/lint-ai-slop.mjs --strict",
    "lint:deps": "knip --dependencies",
    "lint:eslint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix .",
    "lint:ox": "oxlint --deny-warnings",
    "pages:deploy": "wrangler pages deploy ./dist --project-name sahillangoo-portfolio --commit-dirty=true",
    "preview": "astro preview",
    "sync": "astro sync",
    "test": "node scripts/test-console-and-views.mjs",
    "test:e2e": "node scripts/test-console-and-views.mjs",
    "verify:prod": "node scripts/verify-production.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@iconify-json/line-md": "^1.2.16",
    "@iconify-json/ph": "^1.2.2",
    "astro": "^7.3.5",
    "astro-icon": "^1.2.0",
    "cnfast": "^0.2.0",
    "daisyui": "^5.7.47",
    "lenis": "^1.3.26",
    "motion": "^14.0.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@myriaddreamin/typst-ts-node-compiler": "^0.7.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro-eslint-parser": "^3.2.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-lockfile": "^2.1.0",
    "eslint-plugin-oxlint": "^1.86.0",
    "globals": "^17.13.0",
    "knip": "^6.39.0",
    "linkinator": "^8.1.0",
    "oxlint": "^1.86.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-css-order": "^2.2.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "puppeteer-core": "^25.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "unlighthouse": "^0.19.1",
    "wrangler": "^4.147.0"
  },
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d",
  "engines": {
    "node": ">=22.0.0"
  }
}
