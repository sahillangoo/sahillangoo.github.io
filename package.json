{
  "name": "sahillangoo-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "astro": "astro",
    "audit:lighthouse": "node scripts/audit-lighthouse.mjs",
    "audit:lighthouse:ci": "node scripts/audit-lighthouse.mjs --ci",
    "audit:links": "node scripts/audit-links.mjs",
    "audit:links:all": "node scripts/audit-links.mjs --all",
    "audit:og": "node scripts/audit-og-and-favicons.mjs",
    "audit:schema": "node scripts/audit-rich-results.mjs",
    "audit:seo": "node scripts/audit-og-and-favicons.mjs && node scripts/audit-rich-results.mjs && node scripts/audit-links.mjs && node scripts/verify-production.mjs",
    "prebuild": "pnpm lint:ai",
    "build": "astro build",
    "check": "astro check",
    "dev": "astro dev",
    "fix:ai": "node scripts/lint-ai-slop.mjs --fix",
    "format": "prettier --cache --write .",
    "format:check": "prettier --cache --check .",
    "generate:favicons": "node scripts/generate-favicons.mjs",
    "generate:resumes": "node --experimental-strip-types scripts/resume-generator/generate.ts",
    "lint": "oxlint && knip --dependencies && eslint --cache . && pnpm lint:ai",
    "lint:ai": "node scripts/lint-ai-slop.mjs",
    "lint:ai:strict": "node scripts/lint-ai-slop.mjs --strict",
    "lint:deps": "knip --dependencies",
    "lint:eslint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix .",
    "lint:ox": "oxlint --deny-warnings",
    "pages:deploy": "wrangler pages deploy ./dist --project-name sahillangoo-portfolio",
    "preview": "astro preview",
    "sync": "astro sync",
    "test": "node scripts/test-console-and-views.mjs",
    "test:e2e": "node scripts/test-console-and-views.mjs",
    "verify:prod": "node scripts/verify-production.mjs"
  },
  "dependencies": {
    "@astrojs/partytown": "2.1.9",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@iconify-json/line-md": "^1.2.16",
    "@iconify-json/ph": "^1.2.2",
    "astro": "^7.4.2",
    "astro-icon": "^1.2.0",
    "cnfast": "^0.2.0",
    "daisyui": "^5.7.50",
    "locomotive-scroll": "5.0.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@myriaddreamin/typst-ts-node-compiler": "^0.7.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/three": "0.186.0",
    "astro-eslint-parser": "^3.2.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-lockfile": "^2.1.0",
    "eslint-plugin-oxlint": "^1.89.0",
    "globals": "^17.13.0",
    "knip": "^6.43.0",
    "linkinator": "^8.1.0",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-css-order": "^2.2.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "puppeteer-core": "^25.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "unlighthouse": "^0.19.1",
    "wrangler": "^4.152.0"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "engines": {
    "node": ">=22.0.0"
  }
}
