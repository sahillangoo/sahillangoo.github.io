# ==============================================================================
# Environment Variables Example - Sahil Langoo Portfolio
# ==============================================================================
# The static portfolio is fully configured and driven by `src/const/site.ts`.
# Environment variables are optional and only needed if configuring external services.

# Public Site Configuration
PUBLIC_SITE_URL=https://sahillangoo.in

# Optional: Cloudflare Turnstile & Form Security
# PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
# TURNSTILE_SECRET_KEY=your_turnstile_secret_key
