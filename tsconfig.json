{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "strictNullChecks": true,
    "verbatimModuleSyntax": true,
    "allowJs": true,
    "baseUrl": "src",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "paths": {
      "@/*": ["*"],
      "@components/*": ["components/*"],
      "@layouts/*": ["layouts/*"],
      "@utils/*": ["utils/*"],
      "@const/*": ["const/*"],
      "@copy/*": ["data/copy/*"],
      "@copy": ["data/copy/index.ts"],
      "@data/*": ["data/*"],
      "@content/*": ["content/*"],
      "@assets/*": ["assets/*"],
      "@styles/*": ["styles/*"],
      "@plugins/*": ["plugins/*"],
      "@scripts/*": ["../scripts/*"]
    },
    "plugins": [
      {
        "name": "@astrojs/ts-plugin"
      }
    ],
    "jsx": "preserve",
    "types": ["astro/client"],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist"
  },
  "exclude": ["node_modules", "dist", ".astro", ".output", ".agents", ".codex", ".cursor"]
}
