---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
import { SITE } from '@const/site.ts';
import { aboutCopy } from '@copy/about.ts';
import { Icon } from 'astro-icon/components';

const siteData = await getEntry('site', 'profile');
const profile = siteData?.data;

const aboutKeywords = [
  'About Sahil Langoo',
  'Software Engineer Biography',
  'SquadCoders Co-Founder',
  'Systems Engineering Philosophy',
  'Full Stack Architect',
  'Kashmir Software Developer',
];

const aboutSchema = [
  {
    '@type': 'AboutPage',
    '@id': `${SITE.url}/about/#aboutpage`,
    name: `About ${SITE.name} | Engineering Background & Philosophy`,
    url: `${SITE.url}/about/`,
    description: aboutCopy.seo.description,
    mainEntity: {
      '@id': `${SITE.url}/#person`,
    },
  },
  {
    '@type': 'ProfilePage',
    '@id': `${SITE.url}/about/#profilepage`,
    name: `Profile of ${SITE.name}`,
    url: `${SITE.url}/about/`,
    mainEntity: {
      '@id': `${SITE.url}/#person`,
    },
  },
];

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'About', item: '/about/' },
];
---

<BaseLayout
  title={aboutCopy.seo.title}
  description={aboutCopy.seo.description}
  keywords={aboutKeywords}
  image={aboutCopy.seo.image}
  breadcrumbs={breadcrumbs}
  structuredData={aboutSchema}
  type="profile"
>
  <div class="page-sheet space-y-12 py-12 md:py-16">
    <!-- Header -->
    <header class="animate-rise border-base-300 border-b pb-8">
      <span class="label-caps">{aboutCopy.hero.eyebrow}</span>
      <h1 class="text-section mt-3">{aboutCopy.hero.headline}</h1>
    </header>

    <!-- Bio Narrative -->
    <section
      data-reveal="hidden"
      class="text-secondary space-y-4 text-base leading-relaxed sm:text-lg"
    >
      {aboutCopy.hero.paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </section>

    <!-- Principles Grid -->
    {profile?.principles && (
      <section data-reveal="hidden" class="border-base-300 space-y-4 border-t pt-8">
        <h2 class="text-base-content text-xl font-medium tracking-tight">
          {aboutCopy.principles.title}
        </h2>
        <ul class="border-base-300 divide-base-300 divide-y border-y">
          {profile.principles.map((principle) => (
            <li class="grid gap-2 py-5 sm:grid-cols-12 sm:gap-6">
              <h3 class="label-caps text-accent sm:col-span-4">{principle.title}</h3>
              <p class="text-secondary text-sm leading-relaxed sm:col-span-8">
                {principle.description}
              </p>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Workspace & Setup -->
    <section data-reveal="hidden" class="border-base-300 space-y-4 border-t pt-8">
      <h2 class="text-base-content text-xl font-medium tracking-tight">
        {aboutCopy.dailyStack.title}
      </h2>
      <dl class="border-base-300 divide-base-300 divide-y border-y text-sm">
        {aboutCopy.dailyStack.groups.map((group) => (
          <div class="grid gap-1 py-3 sm:grid-cols-12 sm:gap-6">
            <dt class="font-medium text-base-content sm:col-span-4">{group.label}</dt>
            <dd class="text-secondary sm:col-span-8">{group.value}</dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- Connect Box -->
    <section
      data-reveal="hidden"
      class="border-base-300 flex flex-col justify-between gap-4 border-t pt-8 sm:flex-row sm:items-center"
    >
      <div>
        <h2 class="text-base-content text-lg font-medium tracking-tight">
          {aboutCopy.connectCta.title}
        </h2>
        <p class="text-secondary mt-1 text-sm leading-relaxed">
          {aboutCopy.connectCta.description}
        </p>
      </div>
      <a
        href={aboutCopy.connectCta.cta.href}
        class="btn btn-primary w-full gap-2 px-4 font-mono text-xs tracking-wider uppercase sm:w-auto"
      >
        {aboutCopy.connectCta.cta.icon && (
          <Icon name={aboutCopy.connectCta.cta.icon} class="size-3.5" />
        )}
        {aboutCopy.connectCta.cta.label}
      </a>
    </section>
  </div>
</BaseLayout>
