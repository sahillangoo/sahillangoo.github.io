---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
import { SITE } from '@/const/site.ts';
import { aboutCopy } from '@/data/copy/about.ts';
import { Icon } from 'astro-icon/components';

const siteData = await getEntry('site', 'profile');
const profile = siteData?.data;

const aboutKeywords = [
  'About Sahil Langoo',
  'Software Engineer Biography',
  'SquadCoders Co-Founder',
  'Systems Engineering Philosophy',
  'Full Stack Architect',
  'Kashmir Software Developer',
];

const aboutSchema = [
  {
    '@type': 'AboutPage',
    '@id': `${SITE.url}/about/#aboutpage`,
    name: `About ${SITE.name} — Engineering Background & Philosophy`,
    url: `${SITE.url}/about/`,
    description: aboutCopy.seo.description,
    mainEntity: {
      '@id': `${SITE.url}/#person`,
    },
  },
  {
    '@type': 'ProfilePage',
    '@id': `${SITE.url}/about/#profilepage`,
    name: `Profile of ${SITE.name}`,
    url: `${SITE.url}/about/`,
    mainEntity: {
      '@id': `${SITE.url}/#person`,
    },
  },
];

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'About', item: '/about/' },
];
---

<BaseLayout
  title={aboutCopy.seo.title}
  description={aboutCopy.seo.description}
  keywords={aboutKeywords}
  image={aboutCopy.seo.image}
  breadcrumbs={breadcrumbs}
  structuredData={aboutSchema}
  type="profile"
>
  <div class="mx-auto max-w-3xl space-y-12 px-4 py-8 sm:px-6 sm:py-12">
    <!-- Header -->
    <div class="border-base-300 border-b pb-6">
      <span class="text-accent font-mono text-xs font-medium tracking-widest uppercase">
        {aboutCopy.hero.eyebrow}
      </span>
      <h1 class="text-base-content mt-1 text-3xl font-extrabold tracking-tight sm:text-4xl">
        {aboutCopy.hero.headline}
      </h1>
    </div>

    <!-- Bio Narrative -->
    <section class="text-base-content/80 space-y-4 text-base leading-relaxed sm:text-lg">
      {aboutCopy.hero.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </section>

    <!-- Principles Grid -->
    {
      profile?.principles && (
        <section class="border-base-300 space-y-4 border-t pt-8">
          <h2 class="text-base-content text-xl font-bold tracking-tight">
            {aboutCopy.principles.title}
          </h2>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            {profile.principles.map((principle) => (
              <div class="editorial-card p-5">
                <h3 class="text-accent font-mono text-sm font-bold">{principle.title}</h3>
                <p class="text-base-content/75 mt-1.5 text-xs leading-relaxed">
                  {principle.description}
                </p>
              </div>
            ))}
          </div>
        </section>
      )
    }

    <!-- Workspace & Setup -->
    <section class="border-base-300 space-y-4 border-t pt-8">
      <h2 class="text-base-content text-xl font-bold tracking-tight">
        {aboutCopy.dailyStack.title}
      </h2>
      <div class="editorial-card text-base-content/80 space-y-3 p-6 text-sm">
        {
          aboutCopy.dailyStack.groups.map((group) => (
            <div class="flex items-start gap-2">
              <span class="text-accent font-mono select-none">›</span>
              <span>
                <strong>{group.label}:</strong> {group.value}
              </span>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Connect Box -->
    <section
      class="border-base-300 flex flex-col items-center justify-between gap-4 border-t pt-8 sm:flex-row"
    >
      <div>
        <h2 class="text-base-content font-bold">{aboutCopy.connectCta.title}</h2>
        <p class="text-base-content/70 text-xs">
          {aboutCopy.connectCta.description}
        </p>
      </div>
      <a
        href={aboutCopy.connectCta.cta.href}
        class="btn bg-base-content text-base-100 hover:bg-base-content/90 hover:text-base-100 flex items-center gap-2 rounded-md border-0 px-4 font-mono text-xs tracking-wider uppercase"
      >
        {
          aboutCopy.connectCta.cta.icon && (
            <Icon name={aboutCopy.connectCta.cta.icon} class="h-3.5 w-3.5" />
          )
        }
        {aboutCopy.connectCta.cta.label}
      </a>
    </section>
  </div>
</BaseLayout>
