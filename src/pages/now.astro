---
import BaseLayout from '@layouts/BaseLayout.astro';
import TimeAvailabilityWidget from '@components/common/TimeAvailabilityWidget.astro';
import SpotifyWidget from '@components/common/SpotifyWidget.astro';
import { SITE } from '@const/site.ts';
import { nowCopy } from '@copy/now.ts';
import { Icon } from 'astro-icon/components';

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Now', item: '/now/' },
];

const nowKeywords = [
  'Now Page',
  'Current Projects',
  'Active Engineering Focus',
  'Software Systems in Progress',
  'SquadCoders Roadmap',
];

const nowSchema = {
  '@type': 'WebPage',
  '@id': `${SITE.url}/now/#webpage`,
  name: `${nowCopy.header.title} | ${SITE.name}`,
  url: `${SITE.url}/now/`,
  description: nowCopy.seo.description,
  mainEntity: {
    '@id': `${SITE.url}/#person`,
  },
};
---

<BaseLayout
  title={nowCopy.seo.title}
  description={nowCopy.seo.description}
  keywords={nowKeywords}
  image={nowCopy.seo.image}
  breadcrumbs={breadcrumbs}
  structuredData={nowSchema}
>
  <div class="page-sheet space-y-12 py-12 md:py-16">
    <!-- Header -->
    <header class="animate-rise border-base-300 space-y-4 border-b pb-8">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <span class="border-base-300 bg-base-200 text-secondary inline-flex items-center gap-2 rounded-full border px-3 py-0.5 font-mono text-xs">
          <span class="bg-success size-1.5 animate-pulse rounded-full"></span>
          {nowCopy.header.badge}
        </span>
        <p class="meta">
          Updated
          <time datetime="2026-10-01" class="tabular-nums">
            October 2026
          </time>
        </p>
      </div>
      <h1 class="text-section">{nowCopy.header.title}</h1>
      <p class="text-secondary text-base leading-relaxed">{nowCopy.header.description}</p>
      <div class="flex flex-wrap items-center gap-3 pt-2">
        <TimeAvailabilityWidget variant="compact" />
        <SpotifyWidget variant="compact" />
      </div>
    </header>

    <!-- Content Sections -->
    <div class="space-y-10">
      {nowCopy.sections.map((section) => (
        <section
          data-reveal="hidden"
          class="border-base-300 bg-base-200 space-y-4 rounded-md border p-6 sm:p-8"
        >
          <h2 class="text-accent flex items-center gap-2 font-mono text-sm font-semibold tracking-wider uppercase">
            <Icon name={section.icon} class="size-4" />
            {section.category}
          </h2>
          <ul class="text-secondary space-y-3 text-sm leading-relaxed">
            {section.items.map((item) => (
              <li class="flex items-start gap-3">
                <span class="text-accent mt-0.5 font-bold select-none">›</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <!-- Location & Status note -->
    <aside
      data-reveal="hidden"
      class="border-base-300/80 bg-base-200/50 flex flex-col justify-between gap-4 rounded-md border p-6 sm:flex-row sm:items-center"
    >
      <div>
        <h2 class="text-base-content text-sm font-medium">{nowCopy.availabilityCard.title}</h2>
        <p class="text-secondary mt-0.5 text-xs">{nowCopy.availabilityCard.description}</p>
      </div>
      <a
        href={nowCopy.availabilityCard.cta.href}
        class="btn bg-base-content text-base-100 hover:bg-base-content/90 hover:text-base-100 gap-2 self-start rounded-md border-0 px-4 font-mono text-xs font-medium tracking-wider uppercase sm:self-auto"
      >
        {nowCopy.availabilityCard.cta.icon && (
          <Icon name={nowCopy.availabilityCard.cta.icon} class="size-3.5" />
        )}
        {nowCopy.availabilityCard.cta.label}
      </a>
    </aside>
  </div>
</BaseLayout>
