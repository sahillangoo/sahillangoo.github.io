---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { Icon } from 'astro-icon/components';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;
const { data } = note;
const { Content } = await render(note);

const formattedDate = new Date(data.publishDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<BaseLayout
  title={data.title}
  description={data.description || `Digital note by Sahil Langoo on ${data.topic}`}
  publishDate={data.publishDate}
>
  <article class="mx-auto max-w-2xl space-y-8 px-4 py-8 sm:px-6 sm:py-12">
    <!-- Back Link -->
    <a
      href="/notes/"
      class="text-base-content/60 hover:text-accent inline-flex items-center gap-1.5 font-mono text-xs transition-colors"
    >
      <Icon name="ph:arrow-left-bold" class="h-3.5 w-3.5" /> Back to digital garden
    </a>

    <!-- Note Header -->
    <header class="border-base-300 space-y-3 border-b pb-6">
      <div class="text-base-content/60 flex items-center gap-2 font-mono text-xs">
        <span
          class="bg-accent/10 text-accent rounded px-2 py-0.5 font-semibold tracking-wider uppercase"
        >
          {data.topic}
        </span>
        <span>•</span>
        <time datetime={data.publishDate}>{formattedDate}</time>
      </div>

      <h1 class="text-base-content text-2xl font-extrabold tracking-tight sm:text-3xl">
        {data.title}
      </h1>

      {
        data.description && (
          <p class="text-base-content/80 text-sm leading-relaxed">{data.description}</p>
        )
      }
    </header>

    <!-- Note Content -->
    <div
      class="prose prose-invert prose-headings:font-bold prose-headings:text-base-content prose-p:text-base-content/80 prose-code:font-mono prose-code:text-accent prose-pre:border prose-pre:border-base-300 prose-pre:bg-base-200 max-w-none"
    >
      <Content />
    </div>
  </article>
</BaseLayout>
