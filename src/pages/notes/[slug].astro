---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { SITE } from '@/const/site.ts';
import { Icon } from 'astro-icon/components';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  const sorted = [...notes].sort(
    (a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
  );

  return sorted.map((note, index) => ({
    params: { slug: note.id },
    props: {
      note,
      prevNote: index < sorted.length - 1 ? sorted[index + 1] : null,
      nextNote: index > 0 ? sorted[index - 1] : null,
    },
  }));
}

const { note, prevNote, nextNote } = Astro.props;
const { data, id } = note;
const { Content } = await render(note);

const formattedDate = new Date(data.publishDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

const pageUrl = `${SITE.url}/notes/${id}/`;

const noteSchema = {
  '@type': 'TechArticle',
  '@id': `${pageUrl}#article`,
  headline: data.title,
  description: data.description || `Digital garden note by Sahil Langoo on ${data.topic}`,
  url: pageUrl,
  image: `${SITE.url}/og/notes/${id}.png`,
  datePublished: data.publishDate,
  dateModified: data.publishDate,
  author: {
    '@id': `${SITE.url}/#person`,
  },
  publisher: {
    '@id': `${SITE.url}/#person`,
  },
  keywords: data.tags.join(', '),
  inLanguage: 'en-US',
  articleSection: data.topic,
};

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Garden Notes', item: '/notes/' },
  { name: data.title, item: `/notes/${id}/` },
];
---

<BaseLayout
  title={data.title}
  description={data.description || `Digital note by Sahil Langoo on ${data.topic}`}
  image={`/og/notes/${id}.png`}
  publishDate={data.publishDate}
  breadcrumbs={breadcrumbs}
  structuredData={noteSchema}
>
  <article class="mx-auto max-w-2xl space-y-8 px-4 py-8 sm:px-6 sm:py-12">
    <!-- Back Link -->
    <a
      href="/notes/"
      class="text-base-content/60 hover:text-accent inline-flex items-center gap-1.5 font-mono text-xs transition-colors"
    >
      <Icon name="ph:arrow-left-bold" class="h-3.5 w-3.5" /> Back to digital garden
    </a>

    <!-- Note Header -->
    <header class="border-base-300 space-y-3 border-b pb-6">
      <div class="text-base-content/60 flex items-center gap-2 font-mono text-xs">
        <span
          class="bg-accent/10 text-accent rounded px-2 py-0.5 font-semibold tracking-wider uppercase"
        >
          {data.topic}
        </span>
        <span>•</span>
        <time datetime={data.publishDate}>{formattedDate}</time>
      </div>

      <h1
        transition:name={`note-title-${id}`}
        class="text-base-content text-2xl font-extrabold tracking-tight sm:text-3xl"
      >
        {data.title}
      </h1>

      {
        data.description && (
          <p class="text-base-content/80 text-sm leading-relaxed">{data.description}</p>
        )
      }
    </header>

    <!-- Note Content -->
    <div
      class="prose prose-invert prose-headings:font-bold prose-headings:text-base-content prose-p:text-base-content/80 prose-code:font-mono prose-code:text-accent prose-pre:border prose-pre:border-base-300 prose-pre:bg-base-200 max-w-none"
    >
      <Content />
    </div>

    <!-- Adjacent Note Navigation / Slug Pagination -->
    {
      (prevNote || nextNote) && (
        <nav
          aria-label="Adjacent Notes Navigation"
          class="border-base-300 grid grid-cols-1 gap-4 border-t pt-8 sm:grid-cols-2"
        >
          {prevNote ? (
            <a
              href={`/notes/${prevNote.id}/`}
              class="editorial-card group flex flex-col justify-between p-4 text-left transition-all"
              rel="prev"
            >
              <span class="text-base-content/60 flex items-center gap-1 font-mono text-[11px] tracking-wider uppercase">
                <Icon name="ph:arrow-left-bold" class="h-3 w-3" /> Previous Note
              </span>
              <span class="text-base-content group-hover:text-accent mt-1.5 text-xs font-bold transition-colors">
                {prevNote.data.title}
              </span>
            </a>
          ) : (
            <div />
          )}

          {nextNote && (
            <a
              href={`/notes/${nextNote.id}/`}
              class="editorial-card group flex flex-col justify-between p-4 text-right transition-all sm:col-start-2"
              rel="next"
            >
              <span class="text-base-content/60 flex items-center justify-end gap-1 font-mono text-[11px] tracking-wider uppercase">
                Next Note <Icon name="ph:arrow-right-bold" class="h-3 w-3" />
              </span>
              <span class="text-base-content group-hover:text-accent mt-1.5 text-xs font-bold transition-colors">
                {nextNote.data.title}
              </span>
            </a>
          )}
        </nav>
      )
    }
  </article>
</BaseLayout>
