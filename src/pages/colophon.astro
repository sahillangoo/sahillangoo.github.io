---
import BaseLayout from '@layouts/BaseLayout.astro';
import { SITE } from '@const/site.ts';
import { colophonCopy } from '@copy/colophon.ts';
import { Icon } from 'astro-icon/components';

const colophonKeywords = [
  'Website Colophon',
  'Astro 7.3 Architecture',
  'Tailwind CSS v4 Spec',
  'daisyUI 5 Theming',
  'Typography Geist Instrument Serif',
  'Cloudflare Pages Deployment',
];

const colophonSchema = {
  '@type': 'WebPage',
  '@id': `${SITE.url}/colophon/#webpage`,
  name: `${colophonCopy.header.title} | ${SITE.name}`,
  url: `${SITE.url}/colophon/`,
  description: colophonCopy.seo.description,
  mainEntity: {
    '@id': `${SITE.url}/#person`,
  },
};

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Colophon', item: '/colophon/' },
];
---

<BaseLayout
  title={colophonCopy.seo.title}
  description={colophonCopy.seo.description}
  keywords={colophonKeywords}
  image={colophonCopy.seo.image}
  breadcrumbs={breadcrumbs}
  structuredData={colophonSchema}
>
  <div class="page-sheet space-y-12 py-12 md:py-16">
    <!-- Header -->
    <header class="animate-rise border-base-300 space-y-4 border-b pb-8">
      <span class="border-base-300 bg-base-200 text-secondary inline-flex items-center rounded-full border px-3 py-0.5 font-mono text-xs">
        {colophonCopy.header.badge}
      </span>
      <h1 class="text-section">{colophonCopy.header.title}</h1>
      <p class="text-secondary text-base leading-relaxed">{colophonCopy.header.description}</p>
    </header>

    <!-- Specifications Table / Matrix -->
    <section
      data-reveal="hidden"
      class="border-base-300 bg-base-200 space-y-6 rounded-md border p-6 sm:p-8"
    >
      <h2 class="text-accent flex items-center gap-2 font-mono text-sm font-semibold tracking-wider uppercase">
        <Icon name="ph:cpu-bold" class="size-4" />
        {colophonCopy.sections.specificationsTitle}
      </h2>

      <dl class="divide-base-300 divide-y">
        {colophonCopy.sections.specifications.map((item) => (
          <div class="flex flex-col gap-1 py-3 text-xs sm:flex-row sm:items-center sm:justify-between">
            <dt class="meta text-secondary">{item.label}</dt>
            <dd class="text-base-content font-mono font-medium">{item.value}</dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- Design & Performance Principles -->
    <section data-reveal="hidden" class="space-y-4">
      <h2 class="text-accent flex items-center gap-2 font-mono text-sm font-semibold tracking-wider uppercase">
        <Icon name="ph:paint-brush-broad-bold" class="size-4" />
        {colophonCopy.sections.principlesTitle}
      </h2>

      <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        {colophonCopy.sections.principles.map((principle) => (
          <li class="border-base-300 bg-base-200 hover:border-neutral flex flex-col justify-between space-y-3 rounded-md border p-6 transition-all duration-200">
            <h3 class="label-caps text-accent">{principle.title}</h3>
            <p class="text-secondary text-xs leading-relaxed">{principle.description}</p>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
