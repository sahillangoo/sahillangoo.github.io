---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/const/site.ts';
import { colophonCopy } from '@/data/copy/colophon.ts';
import { Icon } from 'astro-icon/components';

const colophonKeywords = [
  'Website Colophon',
  'Astro 7 Architecture',
  'Tailwind CSS v4 Spec',
  'daisyUI 5 Theming',
  'Typography JetBrains Mono',
  'Cloudflare Pages Deployment',
];

const colophonSchema = {
  '@type': 'WebPage',
  '@id': `${SITE.url}/colophon/#webpage`,
  name: `${colophonCopy.header.title} — ${SITE.name}`,
  url: `${SITE.url}/colophon/`,
  description: colophonCopy.seo.description,
  mainEntity: {
    '@id': `${SITE.url}/#person`,
  },
};

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Colophon', item: '/colophon/' },
];
---

<BaseLayout
  title={colophonCopy.seo.title}
  description={colophonCopy.seo.description}
  keywords={colophonKeywords}
  image={colophonCopy.seo.image}
  breadcrumbs={breadcrumbs}
  structuredData={colophonSchema}
>
  <div class="mx-auto max-w-4xl space-y-12 px-4 py-8 sm:px-6 sm:py-12">
    <!-- Header -->
    <div class="border-base-300 space-y-4 border-b pb-8">
      <div
        class="border-base-300 bg-base-200 text-base-content/80 inline-flex items-center gap-2 rounded-full border px-3 py-0.5 font-mono text-xs"
      >
        <span>{colophonCopy.header.badge}</span>
      </div>
      <h1 class="text-base-content text-2xl font-bold tracking-tight sm:text-3xl">
        {colophonCopy.header.title}
      </h1>
      <p class="text-base-content/75 text-base leading-relaxed">
        {colophonCopy.header.description}
      </p>
    </div>

    <!-- Specifications Table / Matrix -->
    <div class="editorial-card space-y-6 p-6 sm:p-8">
      <h2
        class="text-accent flex items-center gap-2 font-mono text-sm font-semibold tracking-wider uppercase"
      >
        <Icon name="ph:cpu-bold" class="h-4 w-4" />
        {colophonCopy.sections.specificationsTitle}
      </h2>

      <div class="divide-base-300/80 divide-y">
        {
          colophonCopy.sections.specifications.map((item) => (
            <div class="flex flex-col gap-1 py-3 text-xs sm:flex-row sm:items-center sm:justify-between">
              <span class="text-base-content/60 font-mono font-medium">{item.label}</span>
              <span class="text-base-content font-mono font-semibold">{item.value}</span>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Design & Performance Principles -->
    <div class="space-y-4">
      <h2
        class="text-accent flex items-center gap-2 font-mono text-sm font-semibold tracking-wider uppercase"
      >
        <Icon name="ph:paint-brush-broad-bold" class="h-4 w-4" />
        {colophonCopy.sections.principlesTitle}
      </h2>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        {
          colophonCopy.sections.principles.map((principle) => (
            <div class="editorial-card space-y-3 p-6">
              <h3 class="text-accent font-mono text-xs font-bold tracking-wider uppercase">
                {principle.title}
              </h3>
              <p class="text-base-content/75 text-xs leading-relaxed">{principle.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</BaseLayout>
