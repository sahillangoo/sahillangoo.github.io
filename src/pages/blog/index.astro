---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/portfolio/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { SITE } from '@/const/site.ts';
import { slugify } from '@/utils/slugify';

const articles = await getCollection('blog');
const publishedArticles = articles
  .filter((a) => !a.data.draft)
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime());

// Extract all unique categories
const categories = [...new Set(publishedArticles.map((post) => post.data.category))];

const blogSchema = {
  '@type': 'Blog',
  '@id': `${SITE.url}/blog/#blog`,
  name: `Engineering Journal & Essays — ${SITE.name}`,
  url: `${SITE.url}/blog/`,
  description:
    'Technical writings, edge systems architecture, performance analysis, and minimalist software engineering principles by Sahil Langoo.',
  publisher: {
    '@id': `${SITE.url}/#person`,
  },
  blogPost: publishedArticles.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    url: `${SITE.url}/blog/${post.id}/`,
    datePublished: post.data.publishDate,
    author: {
      '@id': `${SITE.url}/#person`,
    },
  })),
};

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Writing', item: '/blog/' },
];
---

<BaseLayout
  title="Writing & Engineering Essays"
  description="Technical writings, edge systems architecture, performance benchmarks, and minimalist software engineering principles by Sahil Langoo."
  breadcrumbs={breadcrumbs}
  structuredData={blogSchema}
>
  <div class="mx-auto max-w-4xl space-y-10 px-4 py-8 sm:px-6 sm:py-12">
    <!-- Header -->
    <div class="border-base-300 border-b pb-6">
      <span class="text-accent font-mono text-xs font-medium tracking-widest uppercase">
        Articles
      </span>
      <h1 class="text-base-content mt-1 text-3xl font-extrabold tracking-tight sm:text-4xl">
        Engineering Journal & Essays
      </h1>
      <p class="text-base-content/75 mt-3 text-sm leading-relaxed sm:text-base">
        Deep dives into static architecture, type safety, performance benchmarks, and minimalist
        software engineering principles.
      </p>

      <!-- Category Filter Pills -->
      <div class="flex flex-wrap items-center gap-2 pt-6">
        <span class="text-base-content/50 font-mono text-xs tracking-wider uppercase">Topics:</span>
        {
          categories.map((category) => (
            <a
              href={`/blog/category/${slugify(category)}/`}
              class="bg-base-200 border-base-300 text-base-content/75 hover:border-accent/40 hover:text-accent rounded-full border px-3 py-1 font-mono text-xs transition-colors"
            >
              {category}
            </a>
          ))
        }
      </div>
    </div>

    <!-- Articles List -->
    <div class="space-y-6">
      {publishedArticles.map((post) => <ArticleCard post={post} />)}
    </div>
  </div>
</BaseLayout>
