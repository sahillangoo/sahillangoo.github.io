---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/portfolio/ArticleCard.astro';
import Pagination from '@/components/common/Pagination.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths, Page } from 'astro';
import { SITE } from '@/const/site.ts';
import { slugify } from '@/utils/slugify';

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const articles = await getCollection('blog');
  const publishedArticles = articles
    .filter((a) => !a.data.draft)
    .sort(
      (a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
    );

  return paginate(publishedArticles, { pageSize: 4 });
};

export interface Props {
  page: Page<CollectionEntry<'blog'>>;
}

const { page } = Astro.props;
const articles = page.data;

// Extract all unique categories for topic discoverability
const allArticles = await getCollection('blog');
const categories = [
  ...new Set(allArticles.filter((a) => !a.data.draft).map((post) => post.data.category)),
];

const isFirstPage = page.currentPage === 1;
const pageTitle = isFirstPage
  ? 'Writing & Engineering Essays'
  : `Writing & Engineering Essays — Page ${page.currentPage}`;

const pageDescription =
  'Technical writings, edge systems architecture, performance benchmarks, and minimalist software engineering principles by Sahil Langoo.';

const canonicalUrl = isFirstPage ? `${SITE.url}/blog/` : `${SITE.url}/blog/${page.currentPage}/`;

const blogSchema = {
  '@type': 'Blog',
  '@id': `${canonicalUrl}#blog`,
  name: `${pageTitle} — ${SITE.name}`,
  url: canonicalUrl,
  description: pageDescription,
  publisher: {
    '@id': `${SITE.url}/#person`,
  },
  blogPost: articles.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    url: `${SITE.url}/blog/${post.id}/`,
    image: `${SITE.url}/og/blog/${post.id}.png`,
    datePublished: post.data.publishDate,
    author: {
      '@id': `${SITE.url}/#person`,
    },
  })),
};

const breadcrumbs = [
  { name: 'Home', item: '/' },
  {
    name: isFirstPage ? 'Writing' : `Writing (Page ${page.currentPage})`,
    item: isFirstPage ? '/blog/' : `/blog/${page.currentPage}/`,
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image="/og/blog.png"
  canonicalUrl={canonicalUrl}
  breadcrumbs={breadcrumbs}
  structuredData={blogSchema}
>
  <div class="mx-auto max-w-4xl space-y-10 px-4 py-8 sm:px-6 sm:py-12">
    <!-- Header -->
    <div class="border-base-300 border-b pb-6">
      <span class="text-accent font-mono text-xs font-medium tracking-widest uppercase">
        Articles {page.lastPage > 1 && `• Page ${page.currentPage} of ${page.lastPage}`}
      </span>
      <h1 class="text-base-content mt-1 text-3xl font-extrabold tracking-tight sm:text-4xl">
        Engineering Journal & Essays
      </h1>
      <p class="text-base-content/75 mt-3 text-sm leading-relaxed sm:text-base">
        Deep dives into static architecture, type safety, performance benchmarks, and minimalist
        software engineering principles.
      </p>

      <!-- Category Filter Pills -->
      <div class="flex flex-wrap items-center gap-2 pt-6">
        <span class="text-base-content/50 font-mono text-xs tracking-wider uppercase">Topics:</span>
        {
          categories.map((category) => (
            <a
              href={`/blog/category/${slugify(category)}/`}
              class="bg-base-200 border-base-300 text-base-content/75 hover:border-accent/40 hover:text-accent rounded-full border px-3 py-1 font-mono text-xs transition-colors"
            >
              {category}
            </a>
          ))
        }
      </div>
    </div>

    <!-- Articles List -->
    <div class="space-y-6">
      {articles.map((post) => <ArticleCard post={post} />)}
    </div>

    <!-- Pagination Controls -->
    <Pagination page={page} />
  </div>
</BaseLayout>
