---
import BaseLayout from '@layouts/BaseLayout.astro';
import ReadingProgressBar from '@components/common/ReadingProgressBar.astro';
import ArticleAudioReader from '@components/blog/ArticleAudioReader.astro';
import { getCollection, render } from 'astro:content';
import { SITE } from '@const/site.ts';
import { slugify } from '@utils/slugify.ts';
import { formatIsoDateTime, formatReadingTimeIso } from '@utils/date.ts';
import { Icon } from 'astro-icon/components';
import { Image, getImage } from 'astro:assets';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const sorted = posts
    .filter((p) => !p.data.draft)
    .sort(
      (a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
    );

  return sorted.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      prevPost: index < sorted.length - 1 ? sorted[index + 1] : null,
      nextPost: index > 0 ? sorted[index - 1] : null,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { data, id } = post;
const { Content } = await render(post);

const formattedDate = new Date(data.publishDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

const pageUrl = `${SITE.url}/blog/${id}/`;
const categorySlug = slugify(data.category);

const optimizedOgImage = data.coverImage
  ? await getImage({
      src: data.coverImage,
      width: 1200,
      height: 630,
      format: 'png',
    })
  : null;

const coverImageUrl = data.coverImage
  ? `${SITE.url}${data.coverImage.src}`
  : `${SITE.url}/og/blog/${id}.png`;

const ogImageUrl = optimizedOgImage
  ? `${SITE.url}${optimizedOgImage.src}`
  : `${SITE.url}/og/blog/${id}.png`;

const isoDatePublished = formatIsoDateTime(data.publishDate);
const isoDateModified = formatIsoDateTime(data.updatedDate || data.publishDate);
const timeRequired = formatReadingTimeIso(data.readingTime);
const wordCount = typeof post.body === 'string' ? post.body.trim().split(/\s+/).length : undefined;

const faqSchema =
  data.faqs && data.faqs.length > 0
    ? {
        '@type': 'FAQPage',
        '@id': `${pageUrl}#faq`,
        name: `${data.title} FAQs`,
        url: `${pageUrl}#faq`,
        isPartOf: {
          '@id': `${pageUrl}#article`,
        },
        inLanguage: 'en-US',
        mainEntity: data.faqs.map((faq, index) => ({
          '@type': 'Question',
          '@id': `${pageUrl}#faq-q${index + 1}`,
          name: faq.question,
          url: `${pageUrl}#faq-q${index + 1}`,
          acceptedAnswer: {
            '@type': 'Answer',
            '@id': `${pageUrl}#faq-a${index + 1}`,
            text: faq.answer,
            url: `${pageUrl}#faq-q${index + 1}`,
          },
        })),
      }
    : null;

const topicEntities = [
  ...(data.tags.includes('go')
    ? [
        {
          '@type': 'Thing',
          name: 'Go (Programming Language)',
          sameAs: 'https://en.wikipedia.org/wiki/Go_(programming_language)',
        },
      ]
    : []),
  ...(data.tags.includes('ai-agents') || data.tags.includes('ai-engineering')
    ? [
        {
          '@type': 'Thing',
          name: 'Artificial Intelligence',
          sameAs: 'https://en.wikipedia.org/wiki/Artificial_intelligence',
        },
      ]
    : []),
  ...(data.tags.includes('sqlite')
    ? [
        {
          '@type': 'Thing',
          name: 'SQLite',
          sameAs: 'https://en.wikipedia.org/wiki/SQLite',
        },
      ]
    : []),
  ...(data.tags.includes('backend') || data.tags.includes('web-architecture')
    ? [
        {
          '@type': 'Thing',
          name: 'Application Programming Interface',
          sameAs: 'https://en.wikipedia.org/wiki/API',
        },
      ]
    : []),
];

const articleSchema = {
  '@type': 'TechArticle',
  '@id': `${pageUrl}#article`,
  headline: data.title,
  description: data.description,
  url: pageUrl,
  image: data.coverImage ? [ogImageUrl, coverImageUrl] : ogImageUrl,
  datePublished: isoDatePublished,
  dateModified: isoDateModified,
  author: {
    '@type': 'Person',
    '@id': `${SITE.url}/#person`,
    name: SITE.name,
    url: `${SITE.url}/about/`,
    sameAs: [
      SITE.social.github,
      SITE.social.linkedin,
      SITE.social.twitter,
      SITE.social.facebook,
      SITE.social.instagram,
      SITE.social.devto,
      SITE.social.dailydev,
      SITE.social.googleDev,
    ],
    jobTitle: 'Full Stack Systems Engineer',
  },
  publisher: {
    '@id': `${SITE.url}/#organization`,
  },
  inLanguage: 'en-US',
  articleSection: data.category,
  keywords: data.tags.join(', '),
  proficiencyLevel: 'Expert',
  isAccessibleForFree: true,
  timeRequired,
  ...(wordCount ? { wordCount } : {}),
  ...(data.tags.includes('go')
    ? { dependencies: 'Go 1.24+, SQLite (modernc.org/sqlite), Chi, Huma v2' }
    : {}),
  ...(topicEntities.length > 0 ? { about: topicEntities } : {}),
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['article header h1', 'article .prose'],
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': pageUrl,
  },
  ...(faqSchema ? { hasPart: [{ '@id': `${pageUrl}#faq` }] } : {}),
};

const structuredData = [articleSchema, ...(faqSchema ? [faqSchema] : [])];

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Writing', item: '/blog/' },
  { name: data.category, item: `/blog/category/${categorySlug}/` },
  { name: data.title, item: `/blog/${id}/` },
];
---

<BaseLayout
  title={data.title}
  description={data.description}
  keywords={data.tags}
  image={ogImageUrl}
  imageWidth={1200}
  imageHeight={630}
  imageType="image/png"
  imageAlt={data.title}
  type="article"
  publishDate={isoDatePublished}
  updatedDate={isoDateModified}
  articleSection={data.category}
  articleTags={data.tags}
  breadcrumbs={breadcrumbs}
  structuredData={structuredData}
>
  <ReadingProgressBar />

  <article class="mx-auto max-w-3xl space-y-10 px-4 py-8 sm:px-6 sm:py-12">
    <!-- Back Link -->
    <a
      href="/blog/"
      class="text-base-content/60 hover:text-accent inline-flex items-center gap-1.5 font-mono text-xs transition-colors"
    >
      <Icon name="ph:arrow-left-bold" class="h-3.5 w-3.5" />
      Back to all articles
    </a>

    <!-- Article Header -->
    <header class="border-base-300 space-y-4 border-b pb-8">
      <div class="text-base-content/60 flex flex-wrap items-center gap-3 font-mono text-xs">
        <a
          href={`/blog/category/${categorySlug}/`}
          class="badge badge-sm bg-accent/10 text-accent hover:bg-accent/20 border-0 font-semibold transition-colors"
        >
          {data.category}
        </a>
        <span>•</span>
        <time datetime={data.publishDate}>{formattedDate}</time>
        {data.readingTime && (
          <>
            <span>•</span>
            <span>{data.readingTime}</span>
          </>
        )}
      </div>

      <h1
        transition:name={`blog-title-${id}`}
        class="text-base-content text-2xl leading-tight font-bold tracking-tight sm:text-3xl lg:text-4xl"
      >
        {data.title}
      </h1>

      <p class="text-base-content/80 text-base leading-relaxed sm:text-lg">{data.description}</p>

      <!-- Tags with linked routes -->
      <div class="flex flex-wrap gap-2 pt-2">
        {data.tags.map((tag) => (
          <a
            href={`/blog/tag/${slugify(tag)}/`}
            class="bg-base-200 border-base-300 text-base-content/70 hover:border-accent/40 hover:text-accent rounded border px-2.5 py-0.5 font-mono text-xs transition-colors"
          >
            #{tag}
          </a>
        ))}
      </div>
    </header>

    <!-- Featured Cover Image -->
    {data.coverImage && (
      <figure class="border-base-300 bg-base-200 overflow-hidden rounded-xl border">
        <Image
          src={data.coverImage}
          alt={data.title}
          class="aspect-video w-full object-cover"
          loading="eager"
          decoding="async"
          width={1280}
          height={720}
        />
      </figure>
    )}

    <!-- In-Article Audio Reader -->
    <ArticleAudioReader readingTime={data.readingTime || '6 min read'} articleTitle={data.title} />

    <!-- Post Body -->
    <div
      id="article-content"
      class="prose prose-invert prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-base-content prose-p:text-base-content/80 prose-p:leading-relaxed prose-a:text-accent hover:prose-a:underline prose-code:font-mono prose-code:text-accent prose-pre:border prose-pre:border-base-300 prose-pre:bg-base-200 max-w-none"
    >
      <Content />
    </div>

    <!-- FAQ Accordion (daisyUI 5) -->
    {data.faqs && data.faqs.length > 0 && (
      <section
        id="faq"
        class="border-base-300 space-y-6 border-t pt-10"
        aria-labelledby="faq-heading"
      >
        <div class="space-y-2">
          <h2
            id="faq-heading"
            class="text-base-content text-xl font-bold tracking-tight sm:text-2xl"
          >
            Frequently Asked Questions
          </h2>
          <p class="text-base-content/70 text-sm">
            Key insights, architecture decisions, and technical trade-offs.
          </p>
        </div>

        <div class="join join-vertical border-base-300 bg-base-200/50 w-full overflow-hidden rounded-xl border">
          {data.faqs.map((faq, index) => (
            <div
              id={`faq-q${index + 1}`}
              class="collapse collapse-arrow join-item border-base-300 border-b last:border-b-0"
            >
              <input
                type="radio"
                name={`faq-accordion-${id}`}
                checked={index === 0 ? 'checked' : undefined}
                aria-label={faq.question}
              />
              <div class="collapse-title text-base-content text-base font-semibold">
                {faq.question}
              </div>
              <div class="collapse-content text-base-content/80 text-sm leading-relaxed">
                <p>{faq.answer}</p>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Adjacent Article Navigation / Slug Pagination -->
    {(prevPost || nextPost) && (
      <nav
        aria-label="Adjacent Articles Navigation"
        class="border-base-300 grid grid-cols-1 gap-4 border-t pt-8 sm:grid-cols-2"
      >
        {prevPost ? (
          <a
            href={`/blog/${prevPost.id}/`}
            class="group border-base-300 bg-base-200 hover:border-accent/40 flex flex-col justify-between rounded-xl border p-5 text-left transition-all duration-200 hover:-translate-y-0.5 active:scale-99"
            rel="prev"
          >
            <span class="text-base-content/60 flex items-center gap-1 font-mono text-xs font-medium tracking-wider uppercase">
              <Icon name="ph:arrow-left-bold" class="h-3.5 w-3.5" /> Previous Article
            </span>
            <span class="text-base-content group-hover:text-accent mt-2 text-sm font-bold transition-colors">
              {prevPost.data.title}
            </span>
          </a>
        ) : (
          <div />
        )}

        {nextPost && (
          <a
            href={`/blog/${nextPost.id}/`}
            class="group border-base-300 bg-base-200 hover:border-accent/40 flex flex-col justify-between rounded-xl border p-5 text-right transition-all duration-200 hover:-translate-y-0.5 active:scale-99 sm:col-start-2"
            rel="next"
          >
            <span class="text-base-content/60 flex items-center justify-end gap-1 font-mono text-xs font-medium tracking-wider uppercase">
              Next Article <Icon name="ph:arrow-right-bold" class="h-3.5 w-3.5" />
            </span>
            <span class="text-base-content group-hover:text-accent mt-2 text-sm font-bold transition-colors">
              {nextPost.data.title}
            </span>
          </a>
        )}
      </nav>
    )}

    <!-- Article Footer / Author Box -->
    <footer class="border-base-300 mt-12 border-t pt-8">
      <div class="border-base-300 bg-base-200 flex flex-col justify-between gap-6 rounded-xl border p-6 sm:flex-row sm:items-center sm:p-7">
        <div class="flex items-start gap-4">
          <!-- Author Avatar / Badge -->
          <div class="bg-base-300 border-base-300/80 text-accent flex h-12 w-12 shrink-0 items-center justify-center rounded-full border font-mono text-base font-bold shadow-xs">
            SL
          </div>
          <div class="space-y-1">
            <div class="flex items-center gap-2">
              <span class="text-base-content font-bold">
                <a href="/about/" class="hover:text-accent transition-colors">
                  {SITE.name}
                </a>
              </span>
              <span class="badge badge-sm bg-accent/15 text-accent border-0 font-mono text-xs font-semibold">
                Author
              </span>
            </div>
            <p class="text-base-content/70 max-w-md text-xs leading-relaxed">{SITE.bio}</p>
            <div class="flex items-center gap-3 pt-1 text-xs">
              <a
                href={SITE.social.github}
                target="_blank"
                rel="noopener noreferrer"
                class="text-base-content/60 hover:text-accent flex items-center gap-1 transition-colors"
              >
                <Icon name="ph:github-logo-bold" class="h-3.5 w-3.5" />
                GitHub
              </a>
              <a
                href={SITE.social.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="text-base-content/60 hover:text-accent flex items-center gap-1 transition-colors"
              >
                <Icon name="ph:linkedin-logo-bold" class="h-3.5 w-3.5" />
                LinkedIn
              </a>
              <a
                href={SITE.social.twitter}
                target="_blank"
                rel="noopener noreferrer"
                class="text-base-content/60 hover:text-accent flex items-center gap-1 transition-colors"
              >
                <Icon name="ph:x-logo-bold" class="h-3.5 w-3.5" />
                <span>X</span>
              </a>
            </div>
          </div>
        </div>

        <Fragment set:html="<!--email_off-->" />
        <a
          href={SITE.social.email}
          class="btn btn-sm btn-outline border-base-300 hover:bg-base-200 flex shrink-0 items-center gap-1.5 self-start rounded-md font-mono text-xs transition-all active:scale-99 sm:self-auto"
        >
          <Icon name="ph:paper-plane-tilt-bold" class="h-3.5 w-3.5" />
          Say Hello
        </a>
        <Fragment set:html="<!--/email_off-->" />
      </div>
    </footer>
  </article>
</BaseLayout>
