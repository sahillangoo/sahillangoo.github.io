---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ReadingProgressBar from '@/components/common/ReadingProgressBar.astro';
import ArticleAudioReader from '@/components/blog/ArticleAudioReader.astro';
import { getCollection, render } from 'astro:content';
import { SITE } from '@/const/site.ts';
import { slugify } from '@/utils/slugify';
import { Icon } from 'astro-icon/components';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const sorted = posts
    .filter((p) => !p.data.draft)
    .sort(
      (a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
    );

  return sorted.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      prevPost: index < sorted.length - 1 ? sorted[index + 1] : null,
      nextPost: index > 0 ? sorted[index - 1] : null,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { data, id } = post;
const { Content } = await render(post);

const formattedDate = new Date(data.publishDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

const pageUrl = `${SITE.url}/blog/${id}/`;
const categorySlug = slugify(data.category);

const articleSchema = {
  '@type': 'TechArticle',
  '@id': `${pageUrl}#article`,
  headline: data.title,
  description: data.description,
  url: pageUrl,
  image: `${SITE.url}/og/blog/${id}.png`,
  datePublished: data.publishDate,
  dateModified: data.updatedDate || data.publishDate,
  author: {
    '@type': 'Person',
    '@id': `${SITE.url}/#person`,
    name: SITE.name,
    url: `${SITE.url}/about/`,
    sameAs: [
      SITE.social.github,
      SITE.social.linkedin,
      SITE.social.twitter,
      SITE.social.facebook,
      SITE.social.instagram,
      SITE.social.devto,
    ],
    jobTitle: 'Full Stack Systems Engineer',
  },
  publisher: {
    '@id': `${SITE.url}/#person`,
  },
  inLanguage: 'en-US',
  articleSection: data.category,
  keywords: data.tags.join(', '),
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['article header h1', 'article .prose'],
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': pageUrl,
  },
};

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Writing', item: '/blog/' },
  { name: data.category, item: `/blog/category/${categorySlug}/` },
  { name: data.title, item: `/blog/${id}/` },
];
---

<BaseLayout
  title={data.title}
  description={data.description}
  keywords={data.tags}
  image={`/og/blog/${id}.png`}
  type="article"
  publishDate={data.publishDate}
  updatedDate={data.updatedDate}
  breadcrumbs={breadcrumbs}
  structuredData={articleSchema}
>
  <ReadingProgressBar />

  <article class="mx-auto max-w-3xl space-y-10 px-4 py-8 sm:px-6 sm:py-12">
    <!-- Back Link -->
    <a
      href="/blog/"
      class="text-base-content/60 hover:text-accent inline-flex items-center gap-1.5 font-mono text-xs transition-colors"
    >
      <Icon name="ph:arrow-left-bold" class="h-3.5 w-3.5" /> Back to all articles
    </a>

    <!-- Article Header -->
    <header class="border-base-300 space-y-4 border-b pb-8">
      <div class="text-base-content/60 flex flex-wrap items-center gap-3 font-mono text-xs">
        <a
          href={`/blog/category/${categorySlug}/`}
          class="bg-accent/10 text-accent hover:bg-accent/20 rounded px-2.5 py-0.5 font-semibold transition-colors"
        >
          {data.category}
        </a>
        <span>•</span>
        <time datetime={data.publishDate}>{formattedDate}</time>
        {
          data.readingTime && (
            <>
              <span>•</span>
              <span>{data.readingTime}</span>
            </>
          )
        }
      </div>

      <h1
        transition:name={`blog-title-${id}`}
        class="text-base-content text-2xl leading-tight font-bold tracking-tight sm:text-3xl lg:text-4xl"
      >
        {data.title}
      </h1>

      <p class="text-base-content/80 text-base leading-relaxed sm:text-lg">
        {data.description}
      </p>

      <!-- Tags with linked routes -->
      <div class="flex flex-wrap gap-2 pt-2">
        {
          data.tags.map((tag) => (
            <a
              href={`/blog/tag/${slugify(tag)}/`}
              class="bg-base-200 border-base-300 text-base-content/70 hover:border-accent/40 hover:text-accent rounded border px-2.5 py-0.5 font-mono text-xs transition-colors"
            >
              #{tag}
            </a>
          ))
        }
      </div>
    </header>

    <!-- In-Article Audio Reader -->
    <ArticleAudioReader readingTime={data.readingTime || '6 min read'} articleTitle={data.title} />

    <!-- Post Body -->
    <div
      id="article-content"
      class="prose prose-invert prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-base-content prose-p:text-base-content/80 prose-p:leading-relaxed prose-a:text-accent hover:prose-a:underline prose-code:font-mono prose-code:text-accent prose-pre:border prose-pre:border-base-300 prose-pre:bg-base-200 max-w-none"
    >
      <Content />
    </div>

    <!-- Adjacent Article Navigation / Slug Pagination -->
    {
      (prevPost || nextPost) && (
        <nav
          aria-label="Adjacent Articles Navigation"
          class="border-base-300 grid grid-cols-1 gap-4 border-t pt-8 sm:grid-cols-2"
        >
          {prevPost ? (
            <a
              href={`/blog/${prevPost.id}/`}
              class="editorial-card group flex flex-col justify-between p-5 text-left transition-all"
              rel="prev"
            >
              <span class="text-base-content/60 flex items-center gap-1 font-mono text-[11px] tracking-wider uppercase">
                <Icon name="ph:arrow-left-bold" class="h-3 w-3" /> Previous Article
              </span>
              <span class="text-base-content group-hover:text-accent mt-2 text-sm font-bold transition-colors">
                {prevPost.data.title}
              </span>
            </a>
          ) : (
            <div />
          )}

          {nextPost && (
            <a
              href={`/blog/${nextPost.id}/`}
              class="editorial-card group flex flex-col justify-between p-5 text-right transition-all sm:col-start-2"
              rel="next"
            >
              <span class="text-base-content/60 flex items-center justify-end gap-1 font-mono text-[11px] tracking-wider uppercase">
                Next Article <Icon name="ph:arrow-right-bold" class="h-3 w-3" />
              </span>
              <span class="text-base-content group-hover:text-accent mt-2 text-sm font-bold transition-colors">
                {nextPost.data.title}
              </span>
            </a>
          )}
        </nav>
      )
    }

    <!-- Article Footer / Author Box -->
    <footer class="border-base-300 mt-12 border-t pt-8">
      <div
        class="editorial-card flex flex-col justify-between gap-6 p-6 sm:flex-row sm:items-center"
      >
        <div class="flex items-start gap-4">
          <!-- Author Avatar / Badge -->
          <div
            class="bg-base-300 border-base-300/80 text-accent flex h-12 w-12 shrink-0 items-center justify-center rounded-full border font-mono text-base font-bold shadow-xs"
          >
            SL
          </div>
          <div class="space-y-1">
            <div class="flex items-center gap-2">
              <span class="text-base-content font-bold">
                <a href="/about/" class="hover:text-accent transition-colors">
                  {SITE.name}
                </a>
              </span>
              <span class="bg-accent/15 text-accent py-0.2 rounded px-1.5 font-mono text-[10px]">
                Author
              </span>
            </div>
            <p class="text-base-content/70 max-w-md text-xs leading-relaxed">
              {SITE.bio}
            </p>
            <div class="flex items-center gap-3 pt-1 text-xs">
              <a
                href={SITE.social.github}
                target="_blank"
                rel="noopener noreferrer"
                class="text-base-content/60 hover:text-accent flex items-center gap-1 transition-colors"
              >
                <Icon name="ph:github-logo-bold" class="h-3.5 w-3.5" /> GitHub
              </a>
              <a
                href={SITE.social.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="text-base-content/60 hover:text-accent flex items-center gap-1 transition-colors"
              >
                <Icon name="ph:linkedin-logo-bold" class="h-3.5 w-3.5" /> LinkedIn
              </a>
              <a
                href={SITE.social.twitter}
                target="_blank"
                rel="noopener noreferrer"
                class="text-base-content/60 hover:text-accent flex items-center gap-1 transition-colors"
              >
                <Icon name="ph:x-logo-bold" class="h-3.5 w-3.5" /> X
              </a>
            </div>
          </div>
        </div>

        <a
          href="/contact/"
          class="btn btn-sm btn-outline border-base-300 hover:bg-base-200 flex shrink-0 items-center gap-1.5 self-start rounded-md font-mono text-xs sm:self-auto"
        >
          <Icon name="ph:paper-plane-tilt-bold" class="h-3.5 w-3.5" />
          Say Hello
        </a>
      </div>
    </footer>
  </article>
</BaseLayout>
