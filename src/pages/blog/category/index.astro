---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { slugify } from '@utils/slugify.ts';
import { SITE } from '@const/site.ts';
import { Icon } from 'astro-icon/components';

const allPosts = await getCollection('blog');
const publishedPosts = allPosts.filter((post) => !post.data.draft);

const categoriesMap = new Map<string, typeof publishedPosts>();

for (const post of publishedPosts) {
  const cat = post.data.category;
  if (!categoriesMap.has(cat)) {
    categoriesMap.set(cat, []);
  }
  categoriesMap.get(cat)!.push(post);
}

const categories = Array.from(categoriesMap.entries())
  .map(([name, posts]) => ({
    name,
    slug: slugify(name),
    count: posts.length,
    recentPostTitle: posts.sort(
      (a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
    )[0]?.data.title,
  }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));

const pageUrl = `${SITE.url}/blog/category/`;

const categoriesSchema = {
  '@type': 'CollectionPage',
  '@id': `${pageUrl}#collectionpage`,
  name: `Article Categories | ${SITE.name}`,
  url: pageUrl,
  description:
    'Explore technical essays and engineering analyses categorized by architectural domain.',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: categories.map((cat, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: cat.name,
      url: `${SITE.url}/blog/category/${cat.slug}/`,
    })),
  },
};

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Writing', item: '/blog/' },
  { name: 'Categories', item: '/blog/category/' },
];
---

<BaseLayout
  title="Article Categories"
  description="Explore technical essays and systems architecture breakdowns across engineering domains."
  image="/og/blog.png"
  breadcrumbs={breadcrumbs}
  structuredData={categoriesSchema}
>
  <div class="page-sheet space-y-12 py-12 md:py-16">
    <!-- Back Link -->
    <a
      href="/blog/"
      class="text-secondary hover:text-accent inline-flex items-center gap-1.5 font-mono text-xs transition-colors"
    >
      <Icon name="ph:arrow-left-bold" class="size-3.5" />
      Back to all writing
    </a>

    <!-- Header -->
    <header class="animate-rise border-base-300 border-b pb-6">
      <p class="label-caps text-accent flex items-center gap-2">
        <span>Taxonomy</span>
        <span>•</span>
        <span>{`${categories.length} Categories`}</span>
      </p>
      <h1 class="text-section mt-3">Article Categories</h1>
      <p class="text-secondary mt-3 text-sm leading-relaxed sm:text-base">
        Browse systems engineering essays, edge architecture breakdowns, and performance benchmarks
        organized by topic area.
      </p>
    </header>

    <!-- Category Grid -->
    <ul class="grid gap-4 sm:grid-cols-2">
      {categories.map((cat) => (
        <li>
          <a
            href={`/blog/category/${cat.slug}/`}
            class="border-base-300 bg-base-200/30 hover:border-accent hover:bg-base-200/60 group block rounded-lg border p-5 transition-all"
          >
            <div class="flex items-center justify-between">
              <h2 class="text-base-content group-hover:text-accent text-lg font-medium tracking-tight transition-colors">
                {cat.name}
              </h2>
              <span class="badge badge-neutral font-mono text-xs">
                {cat.count} {cat.count === 1 ? 'post' : 'posts'}
              </span>
            </div>
            {cat.recentPostTitle && (
              <p class="text-secondary mt-2 line-clamp-1 text-xs">Latest: {cat.recentPostTitle}</p>
            )}
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
