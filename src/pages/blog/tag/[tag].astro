---
import BaseLayout from '@layouts/BaseLayout.astro';
import ArticleCard from '@components/portfolio/ArticleCard.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { slugify } from '@utils/slugify.ts';
import { SITE } from '@const/site.ts';
import { Icon } from 'astro-icon/components';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const publishedPosts = allPosts.filter((post) => !post.data.draft);

  // Extract all unique tags
  const tagsSet = new Set<string>();
  publishedPosts.forEach((post) => {
    post.data.tags.forEach((tag) => tagsSet.add(tag));
  });

  const tags = Array.from(tagsSet);

  return tags.map((tag) => {
    const tagSlug = slugify(tag);
    const tagPosts = publishedPosts
      .filter((post) => post.data.tags.map((t) => slugify(t)).includes(tagSlug))
      .sort(
        (a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
      );

    return {
      params: { tag: tagSlug },
      props: {
        tagName: tag,
        tagSlug,
        posts: tagPosts,
      },
    };
  });
}

export interface Props {
  tagName: string;
  tagSlug: string;
  posts: CollectionEntry<'blog'>[];
}

const { tagName, tagSlug, posts } = Astro.props;

const pageUrl = `${SITE.url}/blog/tag/${tagSlug}/`;

const tagSchema = {
  '@type': 'CollectionPage',
  '@id': `${pageUrl}#collectionpage`,
  name: `#${tagName} Articles | ${SITE.name}`,
  url: pageUrl,
  description: `Technical articles tagged #${tagName} by Sahil Langoo.`,
  about: {
    '@type': 'Thing',
    name: tagName,
  },
  mainEntity: {
    '@id': `${SITE.url}/#person`,
  },
};

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Writing', item: '/blog/' },
  { name: 'Tags', item: '/blog/tag/' },
  { name: `#${tagName}`, item: `/blog/tag/${tagSlug}/` },
];
---

<BaseLayout
  title={`#${tagName} Articles`}
  description={`Browse technical articles and engineering analyses tagged #${tagName} by Sahil Langoo.`}
  breadcrumbs={breadcrumbs}
  structuredData={tagSchema}
  noindex={true}
>
  <div class="page-sheet space-y-12 py-12 md:py-16">
    <!-- Back Link -->
    <a
      href="/blog/"
      class="text-secondary hover:text-accent inline-flex items-center gap-1.5 font-mono text-xs transition-colors"
    >
      <Icon name="ph:arrow-left-bold" class="size-3.5" />
      Back to all writing
    </a>

    <!-- Header -->
    <header class="animate-rise border-base-300 border-b pb-6">
      <p class="label-caps text-accent flex items-center gap-2">
        <span>Tag</span>
        <span>•</span>
        <span>
          {posts.length}
          {posts.length === 1 ? 'Article' : 'Articles'}
        </span>
      </p>
      <h1 class="text-section mt-3">#{tagName}</h1>
      <p class="text-secondary mt-3 text-sm leading-relaxed sm:text-base">
        All technical essays, architecture guides, and benchmarks discussing #{tagName}.
      </p>
    </header>

    <!-- Posts Grid -->
    <section aria-label={`#${tagName} articles`}>
      {posts.map((post) => (
        <ArticleCard post={post} />
      ))}
    </section>
  </div>
</BaseLayout>
