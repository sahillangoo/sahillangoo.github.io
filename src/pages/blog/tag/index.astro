---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { slugify } from '@utils/slugify.ts';
import { SITE } from '@const/site.ts';
import { Icon } from 'astro-icon/components';

const allPosts = await getCollection('blog');
const publishedPosts = allPosts.filter((post) => !post.data.draft);

const tagsMap = new Map<string, number>();

for (const post of publishedPosts) {
  for (const tag of post.data.tags) {
    tagsMap.set(tag, (tagsMap.get(tag) || 0) + 1);
  }
}

const tags = Array.from(tagsMap.entries())
  .map(([name, count]) => ({
    name,
    slug: slugify(name),
    count,
  }))
  .sort((a, b) => a.name.localeCompare(b.name));

const pageUrl = `${SITE.url}/blog/tag/`;

const tagsSchema = {
  '@type': 'CollectionPage',
  '@id': `${pageUrl}#collectionpage`,
  name: `Article Tags | ${SITE.name}`,
  url: pageUrl,
  description:
    'Alphabetical directory of topics and technologies discussed across engineering articles.',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: tags.map((tag, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: `#${tag.name}`,
      url: `${SITE.url}/blog/tag/${tag.slug}/`,
    })),
  },
};

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Writing', item: '/blog/' },
  { name: 'Tags', item: '/blog/tag/' },
];
---

<BaseLayout
  title="Article Tags"
  description="Alphabetical directory of technical topics, libraries, and architectural patterns covered in essays."
  image="/og/blog.png"
  breadcrumbs={breadcrumbs}
  structuredData={tagsSchema}
  noindex={true}
>
  <div class="page-sheet space-y-12 py-12 md:py-16">
    <!-- Back Link -->
    <a
      href="/blog/"
      class="text-secondary hover:text-accent inline-flex items-center gap-1.5 font-mono text-xs transition-colors"
    >
      <Icon name="ph:arrow-left-bold" class="size-3.5" />
      Back to all writing
    </a>

    <!-- Header -->
    <header class="animate-rise border-base-300 border-b pb-6">
      <p class="label-caps text-accent flex items-center gap-2">
        <span>Taxonomy</span>
        <span>•</span>
        <span>{`${tags.length} Tags`}</span>
      </p>
      <h1 class="text-section mt-3">Article Tags</h1>
      <p class="text-secondary mt-3 text-sm leading-relaxed sm:text-base">
        Alphabetical index of engineering topics, patterns, and technologies covered in technical
        essays.
      </p>
    </header>

    <!-- Tags Cloud / Grid -->
    <ul class="flex flex-wrap gap-2.5">
      {tags.map((tag) => (
        <li>
          <a
            href={`/blog/tag/${tag.slug}/`}
            class="border-base-300 bg-base-200/40 hover:border-accent hover:bg-base-200/80 group inline-flex items-center gap-2 rounded-md border px-3 py-1.5 font-mono text-xs transition-all"
          >
            <span class="text-base-content group-hover:text-accent font-medium transition-colors">
              #{tag.name}
            </span>
            <span class="text-secondary text-2xs">{tag.count}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
