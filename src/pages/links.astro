---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { SITE } from '@const/site.ts';
import { linksCopy } from '@copy/links.ts';
import { Icon } from 'astro-icon/components';
import { cn } from '@utils/cn.ts';

const links = await getCollection('links');
const sortedLinks = [...links].sort((a, b) => a.data.order - b.data.order);

const linksKeywords = [
  'Sahil Langoo Links',
  'Social Profiles',
  'GitHub Profile',
  'LinkedIn Profile',
  'Twitter X Profile',
  'SquadCoders Link',
];

const linksSchema = [
  {
    '@type': 'ProfilePage',
    '@id': `${SITE.url}/links/#profilepage`,
    name: `${linksCopy.seo.title}`,
    url: `${SITE.url}/links/`,
    mainEntity: {
      '@id': `${SITE.url}/#person`,
    },
  },
  {
    '@type': 'ItemList',
    '@id': `${SITE.url}/links/#itemlist`,
    name: 'Verified Social & Career Profiles',
    itemListElement: sortedLinks.map((link, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      name: link.data.title,
      url: link.data.url,
    })),
  },
];

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Links', item: '/links/' },
];
---

<BaseLayout
  title={linksCopy.seo.title}
  description={linksCopy.seo.description}
  keywords={linksKeywords}
  image={linksCopy.seo.image}
  breadcrumbs={breadcrumbs}
  structuredData={linksSchema}
>
  <div class="mx-auto max-w-lg space-y-8 px-4 py-8 text-center sm:py-12">
    <!-- Header -->
    <div class="space-y-3">
      <div
        class="bg-base-200 border-base-300 text-accent mx-auto flex h-16 w-16 items-center justify-center rounded-full border font-mono text-xl font-bold shadow-md"
      >
        {linksCopy.header.initials}
      </div>
      <h1 class="text-base-content text-2xl font-extrabold tracking-tight">
        {SITE.name}
      </h1>
      <p class="text-base-content/70 mx-auto max-w-sm text-xs sm:text-sm">
        {SITE.tagline}
      </p>
    </div>

    <!-- Link List -->
    <div class="space-y-3 text-left">
      {
        sortedLinks.map((item) => (
          <a
            href={item.data.url}
            target={item.data.url.startsWith('http') ? '_blank' : '_self'}
            rel={item.data.url.startsWith('http') ? 'noopener noreferrer' : ''}
            class={cn(
              'group border-base-300 bg-base-200 hover:border-accent/40 flex items-center justify-between rounded-xl border p-4 transition-all duration-200 hover:-translate-y-0.5 active:scale-99',
              item.data.highlight && 'border-accent/40 bg-base-200/80 shadow-xs'
            )}
          >
            <div>
              <div class="text-base-content group-hover:text-accent flex items-center gap-2 text-sm font-bold transition-colors">
                {item.data.title}
                {item.data.highlight && (
                  <span class="bg-accent/15 text-accent rounded-md px-2 py-0.5 font-mono text-xs font-semibold">
                    Featured
                  </span>
                )}
              </div>
              {item.data.description && (
                <p class="text-base-content/60 mt-0.5 text-xs">{item.data.description}</p>
              )}
            </div>
            <Icon
              name="ph:arrow-up-right-bold"
              class="text-base-content/40 group-hover:text-accent ml-2 h-4 w-4 shrink-0 transition-all group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
            />
          </a>
        ))
      }

      <a
        href={linksCopy.mainSiteCard.href}
        class="group border-base-300/80 bg-base-200 hover:border-base-300 flex items-center justify-between rounded-xl border border-dashed p-4 transition-all duration-200 hover:-translate-y-0.5 active:scale-99"
      >
        <div>
          <div
            class="text-base-content group-hover:text-accent text-sm font-semibold transition-colors"
          >
            {linksCopy.mainSiteCard.title}
          </div>
          <p class="text-base-content/60 mt-0.5 text-xs">
            {linksCopy.mainSiteCard.description}
          </p>
        </div>
        <Icon
          name="ph:arrow-right-bold"
          class="text-base-content/40 group-hover:text-accent ml-2 h-4 w-4 shrink-0"
        />
      </a>
    </div>
  </div>
</BaseLayout>
