---
import BaseLayout from '@layouts/BaseLayout.astro';
import { SITE } from '@const/site.ts';
import { privacyCopy } from '@copy/privacy.ts';
import { Icon } from 'astro-icon/components';

const privacyKeywords = [
  'Privacy Policy',
  'Data Protection',
  'Digital Personal Data Protection Act',
  'DPDPA 2023',
  'Data Fiduciary',
  'Telemetry Disclosures',
  'Cloudflare Web Analytics',
  'Google Analytics 4',
  'Google Tag Manager',
  'Microsoft Clarity',
  'Cookie Policy',
  'GDPR Compliance',
  'CCPA CPRA Disclosure',
];

const privacySchema = {
  '@type': 'WebPage',
  '@id': `${SITE.url}/privacy/#webpage`,
  name: `${privacyCopy.header.title} | ${SITE.name}`,
  url: `${SITE.url}/privacy/`,
  description: privacyCopy.seo.description,
  inLanguage: 'en-US',
  isPartOf: {
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    name: SITE.name,
    url: SITE.url,
  },
  about: {
    '@type': 'Thing',
    name: 'Privacy Policy & Telemetry Disclosures',
  },
  publisher: {
    '@id': `${SITE.url}/#person`,
  },
};

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Privacy', item: '/privacy/' },
];
---

<BaseLayout
  title={privacyCopy.seo.title}
  description={privacyCopy.seo.description}
  keywords={privacyKeywords}
  image={privacyCopy.seo.image}
  breadcrumbs={breadcrumbs}
  structuredData={privacySchema}
>
  <div class="page-sheet space-y-12 py-12 md:py-16">
    <!-- Header -->
    <header class="animate-rise border-base-300 space-y-4 border-b pb-8">
      <span class="badge badge-sm border-base-300 bg-base-200 text-secondary font-mono text-xs">
        {privacyCopy.header.badge}
      </span>
      <h1 class="text-section">{privacyCopy.header.title}</h1>
      <p class="text-secondary text-base leading-relaxed">{privacyCopy.header.description}</p>
      <div class="flex flex-wrap items-center gap-4 text-xs font-mono text-secondary">
        <span>
          Effective:
          <time datetime="2026-04-01" class="tabular-nums">
            {privacyCopy.header.effectiveDate}
          </time>
        </span>
        <span aria-hidden="true">•</span>
        <span>
          Last Updated:
          <time datetime="2026-09-24" class="tabular-nums">
            {privacyCopy.header.lastUpdated}
          </time>
        </span>
      </div>
    </header>

    <!-- Overview / Controller Card -->
    <section data-reveal="hidden" class="border-base-300 space-y-5 border-t pt-8">
      <h2 class="text-accent flex items-center gap-2 font-mono text-sm font-medium tracking-wider uppercase">
        <Icon name="ph:shield-check-bold" class="size-4" />
        {privacyCopy.overview.title}
      </h2>

      <div class="border-base-300 divide-base-300 divide-y border-y text-sm">
        <div class="flex flex-col gap-1 py-2 sm:flex-row sm:items-center sm:justify-between">
          <span class="text-base-content/60 font-mono font-medium">
            Data Fiduciary / Controller
          </span>
          <span class="text-base-content font-mono font-semibold">
            {privacyCopy.overview.controller}
          </span>
        </div>
        <div class="flex flex-col gap-1 py-2 sm:flex-row sm:items-center sm:justify-between">
          <span class="text-base-content/60 font-mono font-medium">Direct Inquiries</span>
          <a
            href={`mailto:${privacyCopy.overview.contact}`}
            class="text-accent font-medium hover:underline"
          >
            {privacyCopy.overview.contact}
          </a>
        </div>
      </div>

      <p class="text-base-content/80 text-sm leading-relaxed">{privacyCopy.overview.summary}</p>
    </section>

    <!-- Storage Identifiers Matrix -->
    <section data-reveal="hidden" class="space-y-6">
      <div class="border-base-300 border-b pb-3">
        <h2 class="text-accent flex items-center gap-2 font-mono text-sm font-medium tracking-wider uppercase">
          <Icon name="ph:cookie-bold" class="h-4 w-4" />
          {privacyCopy.cookiesTableTitle}
        </h2>
        <p class="text-base-content/75 mt-1 text-sm">{privacyCopy.cookiesTableDescription}</p>
      </div>

      <div class="border-base-300 divide-base-300 divide-y border-y">
        {privacyCopy.cookies.map((cookie) => (
          <div class="flex flex-col gap-2 py-4">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span class="font-mono text-xs font-medium text-accent">{cookie.name}</span>
              <div class="flex items-center gap-2">
                <span class="label-caps">{cookie.category}</span>
                <span class="meta">• {cookie.lifespan}</span>
              </div>
            </div>
            <p class="text-xs text-base-content/60 font-mono">Provider: {cookie.provider}</p>
            <p class="text-sm text-base-content/80 leading-relaxed">{cookie.purpose}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Detailed Disclosure Sections -->
    {privacyCopy.sections.map((section) => (
      <section data-reveal="hidden" class="space-y-6 border-base-300 border-t pt-8" id={section.id}>
        <div>
          {section.badge && <span class="label-caps">{section.badge}</span>}
          <h2 class="text-base-content mt-1 text-xl font-medium tracking-tight">{section.title}</h2>
        </div>

        {section.paragraphs.map((paragraph) => (
          <p class="text-base-content/80 text-sm leading-relaxed">{paragraph}</p>
        ))}

        {section.subsections && (
          <div class="space-y-6 pt-2">
            {section.subsections.map((sub) => (
              <div class="border-base-300 space-y-3 border-t pt-4">
                <h3 class="text-accent font-mono text-sm font-medium tracking-wide uppercase">
                  {sub.title}
                </h3>
                <p class="text-base-content/80 text-sm leading-relaxed">{sub.description}</p>
                {sub.bullets && (
                  <ul class="border-base-300/60 divide-base-300/60 divide-y border-t">
                    {sub.bullets.map((bullet) => (
                      <li class="text-base-content/75 flex items-start gap-2 py-2 text-sm leading-relaxed">
                        <span class="text-accent mt-0.5 shrink-0" aria-hidden="true">
                          •
                        </span>
                        <span>{bullet}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </div>
        )}
      </section>
    ))}

    <!-- Visitor choices -->
    <section data-reveal="hidden" class="space-y-6 border-base-300 border-t pt-8">
      <div>
        <span class="label-caps">Statutory Entitlements</span>
        <h2 class="text-base-content mt-1 text-xl font-bold tracking-tight">
          {privacyCopy.rightsTitle}
        </h2>
        <p class="text-base-content/75 mt-2 text-sm leading-relaxed">
          {privacyCopy.rightsDescription}
        </p>
      </div>

      <div class="border-base-300 divide-base-300 divide-y border-y">
        {privacyCopy.rights.map((right) => (
          <div class="grid gap-2 py-5 sm:grid-cols-12 sm:gap-6">
            <h3 class="text-accent font-mono text-xs font-medium tracking-wider uppercase sm:col-span-4">
              {right.title}
            </h3>
            <p class="text-base-content/75 text-sm leading-relaxed sm:col-span-8">
              {right.description}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Privacy contact -->
    <section data-reveal="hidden" class="border-base-300 space-y-4 border-t pt-8">
      <h2 class="text-base-content flex items-center gap-2 text-lg font-medium tracking-tight">
        <Icon name="ph:envelope-simple-bold" class="h-4 w-4 text-accent" />
        {privacyCopy.contactSection.title}
      </h2>
      <p class="text-base-content/80 text-sm leading-relaxed">
        {privacyCopy.contactSection.description}
      </p>
      <a
        href={`mailto:${privacyCopy.contactSection.email}`}
        class="btn btn-sm btn-primary mt-2 gap-2 font-mono text-xs"
      >
        <Icon name="ph:envelope-simple-bold" class="size-3.5" />
        {privacyCopy.contactSection.email}
      </a>
    </section>
  </div>
</BaseLayout>
