---
import BaseLayout from '@layouts/BaseLayout.astro';
import ProjectFilter from '@components/portfolio/ProjectFilter.astro';
import { getCollection } from 'astro:content';
import { SITE } from '@const/site.ts';
import { projectsCopy } from '@copy/projects.ts';

const projects = await getCollection('projects');
const sortedProjects = [...projects].sort((a, b) => a.data.order - b.data.order);

const projectKeywords = [
  'Full Stack Projects',
  'Software Systems Portfolio',
  'Astro Applications',
  'Cloudflare Workers Proxies',
  'smart-img-cli',
  'Hotel Akbar Sonmarg',
  'SoulMedia Platform',
  'HackForce Storefront',
  'TypeScript Web Apps',
];

const collectionSchema = [
  {
    '@type': 'CollectionPage',
    '@id': `${SITE.url}/projects/#collectionpage`,
    name: `${projectsCopy.header.title} | ${SITE.name}`,
    url: `${SITE.url}/projects/`,
    description: projectsCopy.header.description,
    mainEntity: {
      '@id': `${SITE.url}/#person`,
    },
  },
  {
    '@type': 'ItemList',
    '@id': `${SITE.url}/projects/#itemlist`,
    name: 'Engineered Systems & Open Source Projects',
    itemListElement: sortedProjects.map((p, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      name: p.data.title,
      description: p.data.description,
      url: `${SITE.url}/projects/${p.id}/`,
    })),
  },
];

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Work', item: '/projects/' },
];
---

<BaseLayout
  title={projectsCopy.seo.title}
  description={projectsCopy.seo.description}
  keywords={projectKeywords}
  image={projectsCopy.seo.image}
  breadcrumbs={breadcrumbs}
  structuredData={collectionSchema}
>
  <div class="mx-auto max-w-6xl space-y-10 px-4 py-8 sm:px-6 sm:py-12">
    <!-- Header -->
    <div class="border-base-300 max-w-3xl space-y-4 border-b pb-8">
      <div
        class="border-base-300 bg-base-200 text-base-content/80 inline-flex items-center gap-2 rounded-full border px-3 py-0.5 font-mono text-xs"
      >
        <span>{projectsCopy.header.badge}</span>
      </div>
      <h1 class="text-base-content text-2xl font-bold tracking-tight sm:text-3xl">
        {projectsCopy.header.title}
      </h1>
      <p class="text-base-content/75 text-base leading-relaxed">
        {projectsCopy.header.description}
      </p>
    </div>

    <!-- Filter & Grid -->
    <ProjectFilter />
  </div>
</BaseLayout>
