---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/portfolio/ProjectCard.astro';
import ArticleCard from '@/components/portfolio/ArticleCard.astro';
import NoteCard from '@/components/portfolio/NoteCard.astro';
import ExperienceTimeline from '@/components/portfolio/ExperienceTimeline.astro';
import GitHubActivityWidget from '@/components/portfolio/GitHubActivityWidget.astro';
import { getCollection, getEntry } from 'astro:content';
import { SITE } from '@/const/site.ts';
import { Icon } from 'astro-icon/components';

const projects = await getCollection('projects');
const featuredProjects = projects
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const articles = await getCollection('blog');
const recentArticles = articles
  .filter((a) => !a.data.draft)
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime())
  .slice(0, 2);

const notes = await getCollection('notes');
const recentNotes = notes
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime())
  .slice(0, 2);

const experiences = await getCollection('experience');
const siteData = await getEntry('site', 'profile');
const principles = siteData?.data.principles || [];
---

<BaseLayout>
  <div class="mx-auto max-w-6xl space-y-20 px-4 py-8 sm:space-y-28 sm:px-6 sm:py-12">
    <!-- Hero Section -->
    <section class="max-w-3xl space-y-6 pt-4 sm:pt-8">
      <div
        class="border-base-300 bg-base-200/80 text-base-content/80 inline-flex items-center gap-2 rounded-full border px-3 py-1 font-mono text-xs"
      >
        <span class="bg-accent h-1.5 w-1.5 animate-pulse rounded-full"></span>
        <span>Software Engineer & Creative Technologist</span>
      </div>

      <h1
        class="text-base-content text-4xl leading-[1.1] font-extrabold tracking-tight sm:text-5xl lg:text-6xl"
      >
        Building resilient web systems & crafted digital interfaces.
      </h1>

      <p class="text-base-content/75 text-base leading-relaxed sm:text-lg">
        I am <strong class="text-base-content font-semibold">{SITE.name}</strong>, based in {
          SITE.location
        }. I engineer high-performance web applications, developer tooling, and distributed edge
        architectures with <a
          href="https://github.com/SquadCoders"
          target="_blank"
          rel="noopener noreferrer"
          class="text-accent font-semibold hover:underline"
        >
          @SquadCoders
        </a> and open source.
      </p>

      <div class="flex flex-wrap items-center gap-3 pt-2">
        <a
          href="/projects/"
          class="btn bg-base-content text-base-100 hover:bg-base-content/90 flex items-center gap-2 rounded-md border-0 px-5 font-mono text-xs tracking-wider uppercase"
        >
          <Icon name="ph:folder-notch-bold" class="h-3.5 w-3.5" />
          View Projects
        </a>
        <a
          href="/resume/"
          class="btn btn-outline border-base-300 hover:bg-base-200 hover:text-base-content flex items-center gap-2 rounded-md px-5 font-mono text-xs tracking-wider uppercase"
        >
          <Icon name="ph:file-text-bold" class="h-3.5 w-3.5" />
          Resume & CV
        </a>
        <a
          href="/contact/"
          class="btn btn-ghost hover:bg-base-200/60 text-base-content/80 flex items-center gap-2 rounded-md px-4 font-mono text-xs tracking-wider uppercase"
        >
          <Icon name="ph:paper-plane-tilt-bold" class="h-3.5 w-3.5" />
          Get in Touch
        </a>
      </div>
    </section>

    <!-- Selected Projects Section -->
    <section class="space-y-8">
      <div class="border-base-300 flex items-end justify-between border-b pb-4">
        <div>
          <span class="text-accent font-mono text-xs font-medium tracking-widest uppercase">
            Selected Work
          </span>
          <h2 class="text-base-content mt-1 text-2xl font-bold tracking-tight sm:text-3xl">
            Engineered Projects & Systems
          </h2>
        </div>
        <a
          href="/projects/"
          class="text-base-content/70 hover:text-accent hidden items-center gap-1.5 font-mono text-xs font-medium transition-colors sm:inline-flex"
        >
          All Projects <Icon name="ph:arrow-right-bold" class="h-3.5 w-3.5" />
        </a>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {
          featuredProjects.map((project, idx) => (
            <ProjectCard project={project} featured={idx === 0} />
          ))
        }
      </div>

      <div class="pt-2 text-center sm:hidden">
        <a
          href="/projects/"
          class="btn btn-sm btn-outline border-base-300 flex w-full items-center justify-center gap-2 font-mono text-xs"
        >
          <Icon name="ph:arrow-right-bold" class="h-3.5 w-3.5" />
          View All Projects
        </a>
      </div>
    </section>

    <!-- GitHub Commit Stream & Engineering Activity -->
    <section class="space-y-4">
      <GitHubActivityWidget limit={5} />
    </section>

    <!-- Experience & Career Summary -->
    <section class="space-y-8">
      <div class="border-base-300 flex items-end justify-between border-b pb-4">
        <div>
          <span class="text-accent font-mono text-xs font-medium tracking-widest uppercase">
            Career History
          </span>
          <h2 class="text-base-content mt-1 text-2xl font-bold tracking-tight sm:text-3xl">
            Experience & Roles
          </h2>
        </div>
        <a
          href="/resume/"
          class="text-base-content/70 hover:text-accent hidden items-center gap-1.5 font-mono text-xs font-medium transition-colors sm:inline-flex"
        >
          Complete Resume <Icon name="ph:arrow-right-bold" class="h-3.5 w-3.5" />
        </a>
      </div>

      <div class="editorial-card p-6 sm:p-8">
        <ExperienceTimeline experiences={experiences} />
      </div>
    </section>

    <!-- Recent Writing & Digital Garden Notes -->
    <section class="grid grid-cols-1 gap-10 lg:grid-cols-2">
      <!-- Writing Column -->
      <div class="space-y-6">
        <div class="border-base-300 flex items-center justify-between border-b pb-3">
          <h2 class="text-base-content text-xl font-bold tracking-tight">Recent Articles</h2>
          <a href="/blog/" class="text-accent font-mono text-xs hover:underline">All Writing ›</a>
        </div>
        <div class="space-y-4">
          {recentArticles.map((post) => <ArticleCard post={post} />)}
        </div>
      </div>

      <!-- Notes Column -->
      <div class="space-y-6">
        <div class="border-base-300 flex items-center justify-between border-b pb-3">
          <h2 class="text-base-content text-xl font-bold tracking-tight">Digital Garden Notes</h2>
          <a href="/notes/" class="text-accent font-mono text-xs hover:underline">All Notes ›</a>
        </div>
        <div class="space-y-4">
          {recentNotes.map((note) => <NoteCard note={note} />)}
        </div>
      </div>
    </section>

    <!-- Engineering Principles -->
    {
      principles.length > 0 && (
        <section class="space-y-8">
          <div class="border-base-300 border-b pb-4">
            <span class="text-accent font-mono text-xs font-medium tracking-widest uppercase">
              Philosophy
            </span>
            <h2 class="text-base-content mt-1 text-2xl font-bold tracking-tight sm:text-3xl">
              Engineering Principles
            </h2>
          </div>

          <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
            {principles.map((p) => (
              <div class="editorial-card flex flex-col justify-between p-5">
                <div>
                  <h3 class="text-base-content font-mono text-sm font-bold">{p.title}</h3>
                  <p class="text-base-content/70 mt-2 text-xs leading-relaxed">{p.description}</p>
                </div>
              </div>
            ))}
          </div>
        </section>
      )
    }

    <!-- Presence & CTA Banner -->
    <section class="editorial-card space-y-4 p-8 text-center sm:p-10">
      <h2 class="text-base-content text-2xl font-bold tracking-tight sm:text-3xl">
        Let's build something remarkable.
      </h2>
      <p class="text-base-content/70 mx-auto max-w-xl text-sm">
        I am available for high-impact software engineering roles, web architecture design, and
        select technical consulting.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4 pt-3">
        <a
          href="/contact/"
          class="btn bg-base-content text-base-100 hover:bg-base-content/90 flex items-center gap-2 rounded-md border-0 px-6 font-mono text-xs tracking-wider uppercase"
        >
          <Icon name="ph:paper-plane-tilt-bold" class="h-3.5 w-3.5" />
          Start a Conversation
        </a>
        <a
          href={SITE.social.github}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline border-base-300 hover:bg-base-200 hover:text-base-content flex items-center gap-2 rounded-md px-6 font-mono text-xs tracking-wider uppercase"
        >
          <Icon name="ph:github-logo-bold" class="h-3.5 w-3.5" />
          Explore GitHub
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
