---
import BaseLayout from '@layouts/BaseLayout.astro';
import ProjectCard from '@components/portfolio/ProjectCard.astro';
import ArticleCard from '@components/portfolio/ArticleCard.astro';
import NoteCard from '@components/portfolio/NoteCard.astro';
import ExperienceTimeline from '@components/portfolio/ExperienceTimeline.astro';
import GitHubActivityWidget from '@components/portfolio/GitHubActivityWidget.astro';
import { getCollection, getEntry } from 'astro:content';
import { SITE } from '@const/site.ts';
import { homeCopy } from '@copy/home.ts';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import sahilHeroImage from '@assets/images/IMG_20260510_183207.jpg';

const projects = await getCollection('projects');
const featuredProjects = projects
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const articles = await getCollection('blog');
const recentArticles = articles
  .filter((a) => !a.data.draft)
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime())
  .slice(0, 2);

const notes = await getCollection('notes');
const recentNotes = notes
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime())
  .slice(0, 2);

const experiences = await getCollection('experience');
const siteData = await getEntry('site', 'profile');
const principles = siteData?.data.principles || [];

const homeKeywords = [
  'Sahil Langoo',
  'Full Stack Systems Engineer',
  'Systems Architect',
  'Astro 7',
  'TypeScript',
  'Cloudflare Workers',
  'Hono Edge Proxies',
  'Meta CAPI Architecture',
  'daisyUI 5',
  'Tailwind CSS v4',
  'SquadCoders',
  'Web Performance Optimization',
  'Minimalist Software Engineering',
];

const homeSchema = [
  {
    '@type': 'ItemList',
    '@id': `${SITE.url}/#featured-projects`,
    name: 'Featured Production Systems & Open-Source Engineering',
    description:
      'High-throughput architectures, distributed edge proxies, and systems engineered by Sahil Langoo.',
    itemListElement: featuredProjects.map((p, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      name: p.data.title,
      description: p.data.description,
      url: `${SITE.url}/projects/${p.id}/`,
    })),
  },
  {
    '@type': 'ItemList',
    '@id': `${SITE.url}/#recent-writing`,
    name: 'Recent Engineering Essays & Architecture Deconstructions',
    itemListElement: recentArticles.map((a, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      name: a.data.title,
      description: a.data.description,
      url: `${SITE.url}/blog/${a.id}/`,
    })),
  },
];
---

<BaseLayout
  title={homeCopy.seo.title}
  description={homeCopy.seo.description}
  keywords={homeKeywords}
  image={homeCopy.seo.image}
  structuredData={homeSchema}
>
  <div class="mx-auto max-w-6xl space-y-20 px-4 py-8 sm:space-y-28 sm:px-6 sm:py-12">
    <!-- Hero Section -->
    <section class="hero justify-start pt-4 sm:pt-8">
      <div
        class="hero-content w-full max-w-none flex-col items-center justify-between gap-10 p-0 lg:flex-row lg:items-start lg:gap-14"
      >
        <div class="max-w-2xl space-y-6">
          <div
            class="border-base-300 bg-base-200/80 text-base-content/80 inline-flex items-center gap-2 rounded-full border px-3 py-1 font-mono text-xs"
          >
            <span class="bg-accent h-1.5 w-1.5 animate-pulse rounded-full"></span>
            <span>{homeCopy.hero.badge}</span>
          </div>

          <h1
            class="text-base-content text-2xl leading-tight font-extrabold tracking-tight sm:text-3xl lg:text-4xl"
          >
            {homeCopy.hero.headline}
          </h1>

          <p class="text-base-content/75 text-base leading-relaxed sm:text-lg">
            I am <strong class="text-base-content font-semibold">{SITE.name}</strong>, based in {
              homeCopy.hero.locationText
            }. I engineer high-performance web applications, developer tooling, and distributed edge
            architectures with <a
              href="https://github.com/SquadCoders"
              target="_blank"
              rel="noopener noreferrer"
              class="text-accent font-semibold hover:underline"
            >
              @SquadCoders
            </a> and open source.
          </p>

          <div class="flex flex-wrap items-center gap-3 pt-2">
            {
              homeCopy.hero.ctas.map((cta) => (
                <a
                  href={cta.href}
                  class={
                    cta.variant === 'primary'
                      ? 'btn bg-base-content text-base-100 hover:bg-base-content/90 hover:text-base-100 flex items-center gap-2 rounded-md border-0 px-5 font-mono text-xs tracking-wider uppercase'
                      : cta.variant === 'outline'
                        ? 'btn btn-outline border-base-300 hover:bg-base-200 hover:text-base-content flex items-center gap-2 rounded-md px-5 font-mono text-xs tracking-wider uppercase'
                        : 'btn btn-ghost hover:bg-base-200/60 text-base-content/80 flex items-center gap-2 rounded-md px-4 font-mono text-xs tracking-wider uppercase'
                  }
                >
                  {cta.icon && <Icon name={cta.icon} class="h-3.5 w-3.5" />}
                  {cta.label}
                </a>
              ))
            }
          </div>
        </div>

        <!-- Hero Portrait Image Presentation -->
        <div class="relative shrink-0 self-center lg:self-start">
          <div
            class="group border-base-300 bg-base-200 relative overflow-hidden rounded-2xl border p-2 transition-all duration-200 hover:-translate-y-0.5 sm:p-2.5"
          >
            <div
              class="bg-base-300 relative aspect-4/5 w-60 overflow-hidden rounded-xl sm:w-64 md:w-72 lg:w-80"
            >
              <Image
                src={sahilHeroImage}
                alt={homeCopy.hero.imageAlt}
                width={640}
                height={800}
                quality={90}
                loading="eager"
                fetchpriority="high"
                class="h-full w-full object-cover object-center transition-transform duration-500 ease-out group-hover:scale-105"
              />
              <div
                class="from-base-100/40 pointer-events-none absolute inset-0 bg-linear-to-t via-transparent to-transparent opacity-60"
              >
              </div>
            </div>

            <div
              class="text-base-content/70 mt-2.5 flex flex-wrap items-center justify-between gap-2 px-1 font-mono text-xs"
            >
              <span class="inline-flex items-center gap-1.5">
                <span class="inline-block h-1.5 w-1.5 animate-pulse rounded-full bg-emerald-500">
                </span>
                <span>{homeCopy.hero.statusText}</span>
              </span>
              <span class="text-base-content/50">{homeCopy.hero.locationText}</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Selected Projects Section -->
    <section class="space-y-8">
      <div class="border-base-300 flex items-end justify-between border-b pb-4">
        <div>
          <span class="text-accent font-mono text-xs font-semibold tracking-widest uppercase">
            {homeCopy.sections.selectedWork.eyebrow}
          </span>
          <h2 class="text-base-content mt-1 text-2xl font-bold tracking-tight sm:text-3xl">
            {homeCopy.sections.selectedWork.title}
          </h2>
        </div>
        <a
          href="/projects/"
          class="text-base-content/70 hover:text-accent hidden items-center gap-1.5 font-mono text-xs font-medium transition-colors sm:inline-flex"
        >
          {homeCopy.sections.selectedWork.viewAllText}
          <Icon name="ph:arrow-right-bold" class="h-3.5 w-3.5" />
        </a>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {
          featuredProjects.map((project, idx) => (
            <ProjectCard project={project} featured={idx === 0} headingLevel="h3" />
          ))
        }
      </div>

      <div class="pt-2 text-center sm:hidden">
        <a
          href="/projects/"
          class="btn btn-sm btn-outline border-base-300 flex w-full items-center justify-center gap-2 font-mono text-xs font-medium tracking-wider uppercase"
        >
          <Icon name="ph:arrow-right-bold" class="h-3.5 w-3.5" />
          {homeCopy.sections.selectedWork.viewAllText}
        </a>
      </div>
    </section>

    <!-- GitHub Commit Stream & Engineering Activity -->
    <section class="space-y-4">
      <GitHubActivityWidget limit={5} />
    </section>

    <!-- Experience & Career Summary -->
    <section class="space-y-8">
      <div class="border-base-300 flex items-end justify-between border-b pb-4">
        <div>
          <span class="text-accent font-mono text-xs font-semibold tracking-widest uppercase">
            {homeCopy.sections.careerHistory.eyebrow}
          </span>
          <h2 class="text-base-content mt-1 text-2xl font-bold tracking-tight sm:text-3xl">
            {homeCopy.sections.careerHistory.title}
          </h2>
        </div>
        <a
          href="/resume/"
          class="text-base-content/70 hover:text-accent hidden items-center gap-1.5 font-mono text-xs font-medium transition-colors sm:inline-flex"
        >
          {homeCopy.sections.careerHistory.viewAllText}
          <Icon name="ph:arrow-right-bold" class="h-3.5 w-3.5" />
        </a>
      </div>

      <div class="border-base-300 bg-base-200 rounded-xl border p-6 sm:p-8">
        <ExperienceTimeline experiences={experiences} />
      </div>
    </section>

    <!-- Recent Writing & Digital Garden Notes -->
    <section class="grid grid-cols-1 gap-10 lg:grid-cols-2">
      <!-- Writing Column -->
      <div class="space-y-6">
        <div class="border-base-300 flex items-center justify-between border-b pb-3">
          <h2 class="text-base-content text-xl font-bold tracking-tight">
            {homeCopy.sections.recentWriting.title}
          </h2>
          <a href="/blog/" class="text-accent font-mono text-xs hover:underline">
            {homeCopy.sections.recentWriting.viewAllText}
          </a>
        </div>
        <div class="space-y-4">
          {recentArticles.map((post) => <ArticleCard post={post} headingLevel="h3" />)}
        </div>
      </div>

      <!-- Notes Column -->
      <div class="space-y-6">
        <div class="border-base-300 flex items-center justify-between border-b pb-3">
          <h2 class="text-base-content text-xl font-bold tracking-tight">
            {homeCopy.sections.digitalGarden.title}
          </h2>
          <a href="/notes/" class="text-accent font-mono text-xs hover:underline">
            {homeCopy.sections.digitalGarden.viewAllText}
          </a>
        </div>
        <div class="space-y-4">
          {recentNotes.map((note) => <NoteCard note={note} headingLevel="h3" />)}
        </div>
      </div>
    </section>

    <!-- Engineering Principles -->
    {
      principles.length > 0 && (
        <section class="space-y-8">
          <div class="border-base-300 border-b pb-4">
            <span class="text-accent font-mono text-xs font-semibold tracking-widest uppercase">
              {homeCopy.sections.philosophy.eyebrow}
            </span>
            <h2 class="text-base-content mt-1 text-2xl font-bold tracking-tight sm:text-3xl">
              {homeCopy.sections.philosophy.title}
            </h2>
          </div>

          <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
            {principles.map((p) => (
              <div class="border-base-300 bg-base-200 hover:border-accent/40 flex flex-col justify-between rounded-xl border p-5 transition-all duration-200 hover:-translate-y-0.5 active:scale-99">
                <div>
                  <h3 class="text-base-content font-mono text-sm font-bold">{p.title}</h3>
                  <p class="text-base-content/75 mt-2 text-xs leading-relaxed">{p.description}</p>
                </div>
              </div>
            ))}
          </div>
        </section>
      )
    }

    <!-- Presence & CTA Banner -->
    <section
      class="border-base-300 bg-base-200 space-y-4 rounded-xl border p-8 text-center sm:p-10"
    >
      <h2 class="text-base-content text-2xl font-bold tracking-tight sm:text-3xl">
        {homeCopy.sections.ctaBanner.title}
      </h2>
      <p class="text-base-content/70 mx-auto max-w-xl text-sm">
        {homeCopy.sections.ctaBanner.description}
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4 pt-3">
        {
          homeCopy.sections.ctaBanner.ctas.map((cta) => (
            <a
              href={cta.href}
              target={cta.external ? '_blank' : undefined}
              rel={cta.external ? 'noopener noreferrer' : undefined}
              class={
                cta.variant === 'primary'
                  ? 'btn bg-base-content text-base-100 hover:bg-base-content/90 hover:text-base-100 flex items-center gap-2 rounded-md border-0 px-6 font-mono text-xs tracking-wider uppercase'
                  : 'btn btn-outline border-base-300 hover:bg-base-200 hover:text-base-content flex items-center gap-2 rounded-md px-6 font-mono text-xs tracking-wider uppercase'
              }
            >
              {cta.icon && <Icon name={cta.icon} class="h-3.5 w-3.5" />}
              {cta.label}
            </a>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
