---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/const/site.ts';
import { usesCopy } from '@/data/copy/uses.ts';
import { Icon } from 'astro-icon/components';

const usesKeywords = [
  'Developer Setup',
  'Hardware Gear',
  'Software Stack',
  'Terminal Workflow',
  'VS Code Setup',
  'Engineering Productivity',
];

const allGear = usesCopy.sections.flatMap((s) => s.items);

const usesSchema = [
  {
    '@type': 'ItemPage',
    '@id': `${SITE.url}/uses/#itempage`,
    name: `${usesCopy.header.title} — ${SITE.name}`,
    url: `${SITE.url}/uses/`,
    description: usesCopy.seo.description,
    mainEntity: {
      '@id': `${SITE.url}/#person`,
    },
  },
  {
    '@type': 'ItemList',
    '@id': `${SITE.url}/uses/#itemlist`,
    name: 'Developer Gear, Hardware & Software Suite',
    itemListElement: allGear.map((item, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      name: item.name,
      description: item.description,
    })),
  },
];

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Uses', item: '/uses/' },
];
---

<BaseLayout
  title={usesCopy.seo.title}
  description={usesCopy.seo.description}
  keywords={usesKeywords}
  image={usesCopy.seo.image}
  breadcrumbs={breadcrumbs}
  structuredData={usesSchema}
>
  <div class="mx-auto max-w-4xl space-y-12 px-4 py-8 sm:px-6 sm:py-12">
    <!-- Header -->
    <div class="border-base-300 space-y-4 border-b pb-8">
      <div
        class="border-base-300 bg-base-200 text-base-content/80 inline-flex items-center gap-2 rounded-full border px-3 py-0.5 font-mono text-xs"
      >
        <span>{usesCopy.header.badge}</span>
      </div>
      <h1 class="text-base-content text-3xl font-extrabold tracking-tight sm:text-4xl">
        {usesCopy.header.title}
      </h1>
      <p class="text-base-content/75 text-base leading-relaxed">
        {usesCopy.header.description}
      </p>
    </div>

    <!-- Sections -->
    <div class="space-y-10">
      {
        usesCopy.sections.map((section) => (
          <div class="space-y-4">
            <h2 class="text-accent border-base-300/80 flex items-center gap-2 border-b pb-2 font-mono text-sm font-semibold tracking-wider uppercase">
              <Icon name={section.icon} class="h-4 w-4" />
              {section.title}
            </h2>

            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              {section.items.map((item) => (
                <div class="editorial-card space-y-1.5 p-5">
                  <h3 class="text-base-content font-mono text-xs font-bold">{item.name}</h3>
                  <p class="text-base-content/70 text-xs leading-relaxed">{item.description}</p>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</BaseLayout>
