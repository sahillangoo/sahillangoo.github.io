---
import BaseLayout from '@layouts/BaseLayout.astro';
import { SITE } from '@const/site.ts';
import { usesCopy } from '@copy/uses.ts';
import { Icon } from 'astro-icon/components';

const usesKeywords = [
  'Developer Setup',
  'Hardware Gear',
  'Software Stack',
  'Terminal Workflow',
  'VS Code Setup',
  'Engineering Productivity',
];

const usesSchema = {
  '@type': 'ItemPage',
  '@id': `${SITE.url}/uses/#itempage`,
  name: `${usesCopy.header.title} | ${SITE.name}`,
  url: `${SITE.url}/uses/`,
  description: usesCopy.seo.description,
  mainEntity: {
    '@id': `${SITE.url}/#person`,
  },
};

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Uses', item: '/uses/' },
];
---

<BaseLayout
  title={usesCopy.seo.title}
  description={usesCopy.seo.description}
  keywords={usesKeywords}
  image={usesCopy.seo.image}
  breadcrumbs={breadcrumbs}
  structuredData={usesSchema}
>
  <div class="page-sheet space-y-12 py-12 md:py-16">
    <!-- Header -->
    <header class="animate-rise border-base-300 space-y-4 border-b pb-8">
      <span class="badge badge-sm border-base-300 bg-base-200 text-secondary font-mono text-xs">
        {usesCopy.header.badge}
      </span>
      <h1 class="text-section">{usesCopy.header.title}</h1>
      <p class="text-secondary text-base leading-relaxed">{usesCopy.header.description}</p>
    </header>

    <!-- Sections -->
    <div class="space-y-10">
      {usesCopy.sections.map((section) => (
        <section
          data-reveal="hidden"
          class="space-y-4"
          aria-labelledby={`uses-${section.title.toLowerCase().replace(/\s+/g, '-')}`}
        >
          <h2
            id={`uses-${section.title.toLowerCase().replace(/\s+/g, '-')}`}
            class="text-accent border-base-300 flex items-center gap-2 border-b pb-2 font-mono text-sm font-medium tracking-wider uppercase"
          >
            <Icon name={section.icon} class="size-4" />
            {section.title}
          </h2>

          <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            {section.items.map((item) => (
              <li class="border-base-300 bg-base-200 hover:border-base-content/30 flex flex-col justify-between space-y-1.5 rounded-md border p-5 transition-all duration-200">
                <h3 class="text-base-content font-mono text-xs font-medium">{item.name}</h3>
                <p class="text-secondary text-xs leading-relaxed">{item.description}</p>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
