---
import BaseLayout from '@layouts/BaseLayout.astro';
import ExperienceTimeline from '@components/portfolio/ExperienceTimeline.astro';
import { getCollection, getEntry } from 'astro:content';
import { SITE } from '@const/site.ts';
import { resumeCopy } from '@copy/resume.ts';
import { Icon } from 'astro-icon/components';

const experiences = await getCollection('experience');
const siteData = await getEntry('site', 'profile');
const skills = siteData?.data.skills;

const allProjects = await getCollection('projects');
const targetProjectIds = [
  'tech-resume-expert',
  'enterprise-lead-funnels',
  'roohyaseen-portfolio',
  'school-management-saas',
  'squadcoders-api',
];
const resumeProjects = targetProjectIds
  .map((id) => allProjects.find((p) => p.id === id))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));

const resumeSchema = [
  {
    '@type': 'ProfilePage',
    '@id': `${SITE.url}/resume/#profilepage`,
    name: `${resumeCopy.header.eyebrow} | ${SITE.name}`,
    url: `${SITE.url}/resume/`,
    mainEntity: {
      '@id': `${SITE.url}/#person`,
    },
  },
  {
    '@type': 'Occupation',
    '@id': `${SITE.url}/resume/#occupation`,
    name: 'Full Stack Systems Engineer & Systems Architect',
    description:
      'Engineering high-throughput web systems, distributed edge proxies, and minimalist user interfaces.',
    skills: skills
      ? Object.values(skills).flat()
      : ['TypeScript', 'Astro', 'Cloudflare Workers', 'Distributed Systems', 'Tailwind CSS'],
    occupationLocation: {
      '@type': 'City',
      name: 'Kashmir',
      addressRegion: 'Jammu and Kashmir',
      addressCountry: 'India',
    },
  },
  ...SITE.certifications.map((c, idx) => ({
    '@type': 'EducationalOccupationalCredential',
    '@id': `${SITE.url}/resume/#credential-${idx + 1}`,
    name: c.name,
    credentialCategory: 'Professional Certificate',
    recognizedBy: {
      '@type': 'Organization',
      name: c.issuer,
    },
  })),
];

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Resume & CV', item: '/resume/' },
];
---

<BaseLayout
  title={resumeCopy.seo.title}
  description={resumeCopy.seo.description}
  image={resumeCopy.seo.image}
  breadcrumbs={breadcrumbs}
  structuredData={resumeSchema}
  type="profile"
>
  <div class="page-sheet space-y-12 py-12 md:py-16">
    <!-- Header with Actions -->
    <header class="animate-rise border-base-300 flex flex-col gap-6 border-b pb-8 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <span class="label-caps">{resumeCopy.header.eyebrow}</span>
        <h1 class="text-section mt-3">{SITE.name}</h1>
        <p class="text-secondary mt-1 text-sm font-medium">{resumeCopy.header.roleSubtitle}</p>
      </div>

      <div class="flex flex-wrap items-center gap-3 print:hidden">
        {resumeCopy.header.downloadCta && (
          <a
            href={resumeCopy.header.downloadCta.href}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-sm bg-base-content text-base-100 hover:bg-base-content/90 hover:text-base-100 gap-1.5 rounded-md border-0 font-mono text-xs tracking-wider uppercase"
          >
            {resumeCopy.header.downloadCta.icon && (
              <Icon name={resumeCopy.header.downloadCta.icon} class="size-3.5" />
            )}
            {resumeCopy.header.downloadCta.label}
          </a>
        )}
        <a
          href={resumeCopy.header.contactCta.href}
          class="btn btn-sm btn-ghost border border-base-300 hover:bg-base-200 gap-1.5 rounded-md font-mono text-xs tracking-wider uppercase"
        >
          {resumeCopy.header.contactCta.icon && (
            <Icon name={resumeCopy.header.contactCta.icon} class="size-3.5" />
          )}
          {resumeCopy.header.contactCta.label}
        </a>
        <a
          href={resumeCopy.header.githubCta.href}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-sm btn-ghost border border-base-300 hover:bg-base-200 gap-1.5 rounded-md font-mono text-xs tracking-wider uppercase"
        >
          {resumeCopy.header.githubCta.icon && (
            <Icon name={resumeCopy.header.githubCta.icon} class="size-3.5" />
          )}
          {resumeCopy.header.githubCta.label}
        </a>
      </div>
    </header>

    <!-- Role-Specific Resume Targets -->
    {resumeCopy.header.roleResumes && (
      <div
        data-reveal="hidden"
        class="border-base-300 bg-base-200/40 flex flex-col justify-between gap-3 rounded-lg border px-4 py-3 text-xs sm:flex-row sm:items-center print:hidden"
      >
        <span class="text-base-content/70 font-mono">Role-Specific Tracks:</span>
        <div class="flex flex-wrap items-center gap-2">
          {resumeCopy.header.roleResumes.map((role) => (
            <a
              href={role.href}
              target="_blank"
              rel="noopener noreferrer"
              class="border-base-300 bg-base-100 text-base-content/80 hover:border-accent/50 hover:text-accent inline-flex items-center gap-1.5 rounded border px-2.5 py-1 font-mono transition-colors"
            >
              <Icon name="ph:file-pdf-bold" class="size-3 opacity-60" />
              {role.label}
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Summary -->
    <section data-reveal="hidden" class="space-y-3">
      <h2 class="label-caps">{resumeCopy.sections.executiveSummary}</h2>
      <p class="text-base-content/80 text-sm leading-relaxed sm:text-base">
        {siteData?.data.about}
      </p>
    </section>

    <!-- Work Experience -->
    <section data-reveal="hidden" class="space-y-6">
      <h2 class="label-caps">{resumeCopy.sections.professionalExperience}</h2>
      <ExperienceTimeline experiences={experiences} />
    </section>

    <!-- Technical Projects -->
    {resumeProjects.length > 0 && (
      <section data-reveal="hidden" class="space-y-6">
        <div class="flex items-center justify-between">
          <h2 class="label-caps">{resumeCopy.sections.technicalProjects}</h2>
          <a
            href="/projects/"
            class="text-base-content/70 hover:text-accent inline-flex items-center gap-1 font-mono text-xs transition-colors"
          >
            View All Projects
            <Icon name="ph:arrow-right-bold" class="h-3 w-3" />
          </a>
        </div>

        <ul class="space-y-6">
          {resumeProjects.map((proj) => (
            <li class="border-base-300 bg-base-200 space-y-3.5 rounded-md border p-5 sm:p-6">
              <div class="flex flex-col justify-between gap-1 sm:flex-row sm:items-baseline">
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="text-base font-medium tracking-tight">
                    <a
                      href={`/projects/${proj.id}/`}
                      class="text-base-content hover:text-accent transition-colors"
                    >
                      {proj.data.resumeTitle ||
                        proj.data.title.split('|')[0]?.trim() ||
                        proj.data.title}
                    </a>
                  </h3>
                  {proj.data.liveUrl && (
                    <a
                      href={proj.data.liveUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-base-content/60 hover:text-accent inline-flex items-center gap-1 font-mono text-xs"
                      title={`Live demo for ${proj.data.title}`}
                      aria-label={`Live demo for ${proj.data.title}`}
                    >
                      <Icon name="ph:arrow-square-out-bold" class="size-3.5" />
                    </a>
                  )}
                </div>
                <time datetime={String(proj.data.year)} class="meta tabular-nums">
                  {proj.data.year}
                </time>
              </div>

              {proj.data.summary && (
                <p class="text-secondary text-xs leading-relaxed sm:text-sm">{proj.data.summary}</p>
              )}

              {proj.data.highlights && proj.data.highlights.length > 0 && (
                <ul class="text-secondary space-y-2 pt-1 text-xs leading-relaxed sm:text-sm">
                  {proj.data.highlights.map((highlight) => {
                    const colonIndex = highlight.indexOf(':');
                    if (colonIndex > 0) {
                      const category = highlight.slice(0, colonIndex);
                      const rest = highlight.slice(colonIndex + 1);
                      return (
                        <li class="flex items-start gap-2">
                          <span class="text-accent mt-0.5 select-none font-bold">›</span>
                          <span>
                            <strong class="text-base-content font-medium">{category}:</strong>
                            {rest}
                          </span>
                        </li>
                      );
                    }
                    return (
                      <li class="flex items-start gap-2">
                        <span class="text-accent mt-0.5 select-none font-bold">›</span>
                        <span>{highlight}</span>
                      </li>
                    );
                  })}
                </ul>
              )}

              <div class="flex flex-wrap gap-1.5 pt-1">
                {proj.data.tags.slice(0, 8).map((t) => (
                  <span class="bg-base-300/40 text-secondary rounded px-2 py-0.5 font-mono text-xs">
                    {t}
                  </span>
                ))}
              </div>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Skills Breakdown -->
    {skills && (
      <section data-reveal="hidden" class="space-y-6">
        <h2 class="label-caps">{resumeCopy.sections.coreCompetencies}</h2>

        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
          <div class="border-base-300 bg-base-200 space-y-2 rounded-md border p-5">
            <h3 class="text-base-content font-mono text-xs font-bold tracking-wider uppercase">
              {resumeCopy.sections.languagesTitle}
            </h3>
            <div class="flex flex-wrap gap-1.5">
              {skills.languages.map((item) => (
                <span class="bg-base-300/40 text-base-content/80 rounded px-2 py-0.5 font-mono text-xs">
                  {item}
                </span>
              ))}
            </div>
          </div>

          <div class="border-base-300 bg-base-200 space-y-2 rounded-md border p-5">
            <h3 class="text-base-content font-mono text-xs font-bold tracking-wider uppercase">
              {resumeCopy.sections.frameworksTitle}
            </h3>
            <div class="flex flex-wrap gap-1.5">
              {skills.frameworks.map((item) => (
                <span class="bg-base-300/40 text-base-content/80 rounded px-2 py-0.5 font-mono text-xs">
                  {item}
                </span>
              ))}
            </div>
          </div>

          <div class="border-base-300 bg-base-200 space-y-2 rounded-md border p-5">
            <h3 class="text-base-content font-mono text-xs font-bold tracking-wider uppercase">
              {resumeCopy.sections.cloudTitle}
            </h3>
            <div class="flex flex-wrap gap-1.5">
              {skills.cloud.map((item) => (
                <span class="bg-base-300/40 text-base-content/80 rounded px-2 py-0.5 font-mono text-xs">
                  {item}
                </span>
              ))}
            </div>
          </div>

          <div class="border-base-300 bg-base-200 space-y-2 rounded-md border p-5">
            <h3 class="text-base-content font-mono text-xs font-bold tracking-wider uppercase">
              {resumeCopy.sections.databasesToolsTitle}
            </h3>
            <div class="flex flex-wrap gap-1.5">
              {[...skills.databases, ...skills.tools].map((item) => (
                <span class="bg-base-300/40 text-base-content/80 rounded px-2 py-0.5 font-mono text-xs">
                  {item}
                </span>
              ))}
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- Education Section -->
    <section data-reveal="hidden" class="space-y-6">
      <h2 class="label-caps">{resumeCopy.sections.educationTitle}</h2>
      <ul class="grid grid-cols-1 gap-4 md:grid-cols-2">
        {SITE.education.map((edu) => (
          <li class="border-base-300 bg-base-200 flex flex-col justify-between space-y-4 rounded-md border p-6">
            <div class="space-y-2">
              <div class="flex items-start justify-between gap-2">
                <span class="bg-base-300/40 text-accent rounded px-2 py-0.5 font-mono text-xs font-bold">
                  CGPA: {edu.cgpa}
                </span>
                <span class="text-base-content/60 font-mono text-xs">{edu.period}</span>
              </div>
              <h3 class="text-base-content text-base font-medium tracking-tight">
                {edu.institution}
              </h3>
              <p class="text-secondary text-xs font-medium">{edu.degree}</p>
              <p class="text-base-content/60 font-mono text-xs">{edu.location}</p>
            </div>

            {edu.coursework && (
              <div class="border-base-300/60 border-t pt-3">
                <span class="text-base-content/60 block font-mono text-xs">Key Coursework:</span>
                <div class="mt-1.5 flex flex-wrap gap-1">
                  {edu.coursework.map((c) => (
                    <span class="badge badge-sm bg-base-200 text-base-content/70 border-0 font-mono text-xs">
                      {c}
                    </span>
                  ))}
                </div>
              </div>
            )}
          </li>
        ))}
      </ul>
    </section>

    <!-- Professional Certifications -->
    <section data-reveal="hidden" class="space-y-6">
      <h2 class="label-caps">{resumeCopy.sections.certificationsTitle}</h2>
      <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {SITE.certifications.map((cert) => (
          <li class="border-base-300 bg-base-200 flex flex-col justify-between space-y-3 rounded-md border p-5">
            <div class="space-y-1">
              <div class="flex items-center justify-between">
                <span class="text-accent font-mono text-xs font-medium">{cert.issuer}</span>
                <span class="text-base-content/50 font-mono text-xs">{cert.year}</span>
              </div>
              <h3 class="text-base-content text-xs leading-snug font-medium">{cert.name}</h3>
            </div>
            <div class="text-base-content/60 flex items-center gap-1 font-mono text-xs">
              <Icon name="ph:seal-check-bold" class="text-accent size-3.5" />
              Verified Credential
            </div>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  @media print {
    :global(#site-header),
    :global(#site-footer),
    :global(#back-to-top),
    :global(#command-palette-modal),
    :global(#audio-pip-dock) {
      display: none !important;
    }

    :global(body) {
      background: #ffffff !important;
      color: #111827 !important;
    }

    :global(.role-details) {
      display: block !important;
    }

    :global(.role-summary) {
      display: none !important;
    }

    :global(.role-panel) {
      display: block !important;
      opacity: 1 !important;
      max-height: none !important;
    }

    :global(.role-panel > div) {
      display: block !important;
    }

    :global(article),
    :global(section) {
      break-inside: avoid;
    }
  }
</style>
