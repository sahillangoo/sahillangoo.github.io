---
import BaseLayout from '@layouts/BaseLayout.astro';
import ExperienceTimeline from '@components/portfolio/ExperienceTimeline.astro';
import { getCollection, getEntry } from 'astro:content';
import { SITE } from '@const/site.ts';
import { resumeCopy } from '@copy/resume.ts';
import { Icon } from 'astro-icon/components';

const experiences = await getCollection('experience');
const siteData = await getEntry('site', 'profile');
const skills = siteData?.data.skills;

const resumeSchema = [
  {
    '@type': 'ProfilePage',
    '@id': `${SITE.url}/resume/#profilepage`,
    name: `${resumeCopy.header.eyebrow} | ${SITE.name}`,
    url: `${SITE.url}/resume/`,
    mainEntity: {
      '@id': `${SITE.url}/#person`,
    },
  },
  {
    '@type': 'Occupation',
    '@id': `${SITE.url}/resume/#occupation`,
    name: 'Full Stack Systems Engineer & Systems Architect',
    description:
      'Engineering high-throughput web systems, distributed edge proxies, and minimalist user interfaces.',
    skills: skills
      ? Object.values(skills).flat()
      : ['TypeScript', 'Astro', 'Cloudflare Workers', 'Distributed Systems', 'Tailwind CSS'],
    occupationLocation: {
      '@type': 'City',
      name: 'Kashmir',
      addressRegion: 'Jammu and Kashmir',
      addressCountry: 'India',
    },
  },
  ...SITE.certifications.map((c, idx) => ({
    '@type': 'EducationalOccupationalCredential',
    '@id': `${SITE.url}/resume/#credential-${idx + 1}`,
    name: c.name,
    credentialCategory: 'Professional Certificate',
    recognizedBy: {
      '@type': 'Organization',
      name: c.issuer,
    },
  })),
];

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Resume & CV', item: '/resume/' },
];
---

<BaseLayout
  title={resumeCopy.seo.title}
  description={resumeCopy.seo.description}
  image={resumeCopy.seo.image}
  breadcrumbs={breadcrumbs}
  structuredData={resumeSchema}
  type="profile"
>
  <div class="mx-auto max-w-4xl space-y-12 px-4 py-8 sm:px-6 sm:py-12">
    <!-- Header with Actions -->
    <div
      class="border-base-300 flex flex-col gap-6 border-b pb-8 sm:flex-row sm:items-center sm:justify-between"
    >
      <div>
        <span class="text-accent font-mono text-xs font-medium tracking-widest uppercase">
          {resumeCopy.header.eyebrow}
        </span>
        <h1 class="text-base-content mt-1 text-2xl font-bold tracking-tight sm:text-3xl">
          {SITE.name}
        </h1>
        <p class="text-base-content/80 mt-1 text-sm font-medium">
          {resumeCopy.header.roleSubtitle}
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        {
          resumeCopy.header.downloadCta && (
            <a
              href={resumeCopy.header.downloadCta.href}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-sm bg-base-content text-base-100 hover:bg-base-content/90 hover:text-base-100 flex items-center gap-1.5 rounded-md border-0 font-mono text-xs tracking-wider uppercase"
            >
              {resumeCopy.header.downloadCta.icon && (
                <Icon name={resumeCopy.header.downloadCta.icon} class="h-3.5 w-3.5" />
              )}
              {resumeCopy.header.downloadCta.label}
            </a>
          )
        }
        <a
          href={resumeCopy.header.contactCta.href}
          class="btn btn-sm btn-outline border-base-300 hover:bg-base-200 flex items-center gap-1.5 rounded-md font-mono text-xs tracking-wider uppercase"
        >
          {
            resumeCopy.header.contactCta.icon && (
              <Icon name={resumeCopy.header.contactCta.icon} class="h-3.5 w-3.5" />
            )
          }
          {resumeCopy.header.contactCta.label}
        </a>
        <a
          href={resumeCopy.header.githubCta.href}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-sm btn-outline border-base-300 hover:bg-base-200 flex items-center gap-1.5 rounded-md font-mono text-xs tracking-wider uppercase"
        >
          {
            resumeCopy.header.githubCta.icon && (
              <Icon name={resumeCopy.header.githubCta.icon} class="h-3.5 w-3.5" />
            )
          }
          {resumeCopy.header.githubCta.label}
        </a>
      </div>
    </div>

    <!-- Summary -->
    <section class="space-y-3">
      <h2 class="text-accent font-mono text-xs font-bold tracking-widest uppercase">
        {resumeCopy.sections.executiveSummary}
      </h2>
      <p class="text-base-content/80 text-sm leading-relaxed sm:text-base">
        {siteData?.data.about}
      </p>
    </section>

    <!-- Work Experience -->
    <section class="space-y-6">
      <h2 class="text-accent font-mono text-xs font-bold tracking-widest uppercase">
        {resumeCopy.sections.professionalExperience}
      </h2>
      <div class="border-base-300 bg-base-200 rounded-xl border p-6 sm:p-8">
        <ExperienceTimeline experiences={experiences} />
      </div>
    </section>

    <!-- Skills Breakdown -->
    {
      skills && (
        <section class="space-y-6">
          <h2 class="text-accent font-mono text-xs font-bold tracking-widest uppercase">
            {resumeCopy.sections.coreCompetencies}
          </h2>

          <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
            <div class="border-base-300 bg-base-200 space-y-2 rounded-xl border p-5">
              <h3 class="text-base-content font-mono text-xs font-bold tracking-wider uppercase">
                {resumeCopy.sections.languagesTitle}
              </h3>
              <div class="flex flex-wrap gap-1.5">
                {skills.languages.map((item) => (
                  <span class="bg-base-300/40 text-base-content/80 rounded px-2 py-0.5 font-mono text-xs">
                    {item}
                  </span>
                ))}
              </div>
            </div>

            <div class="border-base-300 bg-base-200 space-y-2 rounded-xl border p-5">
              <h3 class="text-base-content font-mono text-xs font-bold tracking-wider uppercase">
                {resumeCopy.sections.frameworksTitle}
              </h3>
              <div class="flex flex-wrap gap-1.5">
                {skills.frameworks.map((item) => (
                  <span class="bg-base-300/40 text-base-content/80 rounded px-2 py-0.5 font-mono text-xs">
                    {item}
                  </span>
                ))}
              </div>
            </div>

            <div class="border-base-300 bg-base-200 space-y-2 rounded-xl border p-5">
              <h3 class="text-base-content font-mono text-xs font-bold tracking-wider uppercase">
                {resumeCopy.sections.cloudTitle}
              </h3>
              <div class="flex flex-wrap gap-1.5">
                {skills.cloud.map((item) => (
                  <span class="bg-base-300/40 text-base-content/80 rounded px-2 py-0.5 font-mono text-xs">
                    {item}
                  </span>
                ))}
              </div>
            </div>

            <div class="border-base-300 bg-base-200 space-y-2 rounded-xl border p-5">
              <h3 class="text-base-content font-mono text-xs font-bold tracking-wider uppercase">
                {resumeCopy.sections.databasesToolsTitle}
              </h3>
              <div class="flex flex-wrap gap-1.5">
                {[...skills.databases, ...skills.tools].map((item) => (
                  <span class="bg-base-300/40 text-base-content/80 rounded px-2 py-0.5 font-mono text-xs">
                    {item}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </section>
      )
    }

    <!-- Education Section -->
    <section class="space-y-6">
      <h2 class="text-accent font-mono text-xs font-bold tracking-widest uppercase">
        {resumeCopy.sections.educationTitle}
      </h2>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
        {
          SITE.education.map((edu) => (
            <div class="border-base-300 bg-base-200 flex flex-col justify-between space-y-4 rounded-xl border p-6">
              <div class="space-y-2">
                <div class="flex items-start justify-between gap-2">
                  <span class="bg-base-300/40 text-accent rounded px-2 py-0.5 font-mono text-xs font-bold">
                    CGPA: {edu.cgpa}
                  </span>
                  <span class="text-base-content/60 font-mono text-xs">{edu.period}</span>
                </div>
                <h3 class="text-base-content text-base font-bold tracking-tight">
                  {edu.institution}
                </h3>
                <p class="text-base-content/80 text-xs font-medium">{edu.degree}</p>
                <p class="text-base-content/60 font-mono text-xs">{edu.location}</p>
              </div>

              {edu.coursework && (
                <div class="border-base-300/60 border-t pt-3">
                  <span class="text-base-content/60 block font-mono text-xs">Key Coursework:</span>
                  <div class="mt-1.5 flex flex-wrap gap-1">
                    {edu.coursework.map((c) => (
                      <span class="bg-base-200 text-base-content/70 rounded-md px-2 py-0.5 font-mono text-xs">
                        {c}
                      </span>
                    ))}
                  </div>
                </div>
              )}
            </div>
          ))
        }
      </div>
    </section>

    <!-- Professional Certifications -->
    <section class="space-y-6">
      <h2 class="text-accent font-mono text-xs font-bold tracking-widest uppercase">
        {resumeCopy.sections.certificationsTitle}
      </h2>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          SITE.certifications.map((cert) => (
            <div class="border-base-300 bg-base-200 flex flex-col justify-between space-y-3 rounded-xl border p-5">
              <div class="space-y-1">
                <div class="flex items-center justify-between">
                  <span class="text-accent font-mono text-xs font-medium">{cert.issuer}</span>
                  <span class="text-base-content/50 font-mono text-xs">{cert.year}</span>
                </div>
                <h3 class="text-base-content text-xs leading-snug font-bold">{cert.name}</h3>
              </div>
              <div class="text-base-content/60 flex items-center gap-1 font-mono text-xs">
                <Icon name="ph:seal-check-bold" class="text-accent h-3.5 w-3.5" />
                <span>Verified Credential</span>
              </div>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
