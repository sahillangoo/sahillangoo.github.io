---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactForm from '@/components/portfolio/ContactForm.astro';
import { SITE } from '@/const/site.ts';
import { contactCopy } from '@/data/copy/contact.ts';
import { Icon } from 'astro-icon/components';

const contactKeywords = [
  'Contact Sahil Langoo',
  'Hire Full Stack Engineer',
  'Software Architecture Consulting',
  'SquadCoders Inquiries',
  'Cloudflare Workers Consulting',
];

const contactSchema = [
  {
    '@type': 'ContactPage',
    '@id': `${SITE.url}/contact/#contactpage`,
    name: `${contactCopy.header.title} — ${SITE.name}`,
    url: `${SITE.url}/contact/`,
    description: contactCopy.header.description,
    mainEntity: {
      '@id': `${SITE.url}/#person`,
    },
  },
  {
    '@type': 'ContactPoint',
    '@id': `${SITE.url}/contact/#contactpoint`,
    email: SITE.email,
    contactType: 'Engineering Inquiries & Consulting',
    availableLanguage: ['en'],
  },
];

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Contact', item: '/contact/' },
];
---

<BaseLayout
  title={contactCopy.seo.title}
  description={contactCopy.seo.description}
  keywords={contactKeywords}
  image={contactCopy.seo.image}
  breadcrumbs={breadcrumbs}
  structuredData={contactSchema}
>
  <div class="mx-auto max-w-4xl space-y-12 px-4 py-8 sm:px-6 sm:py-12">
    <!-- Header -->
    <div class="border-base-300 max-w-2xl border-b pb-6">
      <span class="text-accent font-mono text-xs font-medium tracking-widest uppercase">
        {contactCopy.header.eyebrow}
      </span>
      <h1 class="text-base-content mt-1 text-2xl font-bold tracking-tight sm:text-3xl">
        {contactCopy.header.title}
      </h1>
      <p class="text-base-content/75 mt-3 text-sm leading-relaxed sm:text-base">
        {contactCopy.header.description}
      </p>
    </div>

    <!-- Contact Grid -->
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
      <!-- Left sidebar with quick details -->
      <div class="space-y-6">
        <div class="editorial-card space-y-4 p-5">
          <div>
            <span class="text-base-content/60 font-mono text-xs tracking-wider uppercase">
              {contactCopy.sidebar.emailLabel}
            </span>
            <p class="text-base-content mt-0.5 text-sm font-semibold">
              <!--email_off-->
              <a href={SITE.social.email} class="hover:text-accent underline">
                {SITE.email}
              </a>
              <!--/email_off-->
            </p>
          </div>

          <div>
            <span class="text-base-content/60 font-mono text-xs tracking-wider uppercase">
              {contactCopy.sidebar.locationLabel}
            </span>
            <p class="text-base-content mt-0.5 text-sm font-medium">
              {SITE.location}
            </p>
          </div>

          <div>
            <span class="text-base-content/60 font-mono text-xs tracking-wider uppercase">
              {contactCopy.sidebar.statusLabel}
            </span>
            <p class="mt-0.5 flex items-center gap-1.5 font-mono text-xs text-emerald-400">
              <span class="h-2 w-2 animate-pulse rounded-full bg-emerald-500"></span>
              {SITE.status}
            </p>
          </div>
        </div>

        <div class="editorial-card space-y-3 p-5">
          <span class="text-base-content/60 font-mono text-xs tracking-wider uppercase">
            {contactCopy.sidebar.verifiedProfilesLabel}
          </span>
          <div class="flex flex-col gap-2.5 text-xs">
            <a
              href={SITE.social.github}
              target="_blank"
              rel="noopener noreferrer"
              class="text-base-content/80 hover:text-accent flex items-center gap-2 transition-colors"
            >
              <Icon name="ph:github-logo-bold" class="text-accent h-4 w-4" /> GitHub / sahillangoo
            </a>
            <a
              href={SITE.social.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="text-base-content/80 hover:text-accent flex items-center gap-2 transition-colors"
            >
              <Icon name="ph:linkedin-logo-bold" class="text-accent h-4 w-4" /> LinkedIn / sahillangoo
            </a>
            <a
              href={SITE.social.twitter}
              target="_blank"
              rel="noopener noreferrer"
              class="text-base-content/80 hover:text-accent flex items-center gap-2 transition-colors"
            >
              <Icon name="ph:x-logo-bold" class="text-accent h-4 w-4" /> X / @kashurgeek
            </a>
            <a
              href={SITE.social.facebook}
              target="_blank"
              rel="noopener noreferrer"
              class="text-base-content/80 hover:text-accent flex items-center gap-2 transition-colors"
            >
              <Icon name="ph:facebook-logo-bold" class="text-accent h-4 w-4" /> Facebook / sahillangoojs
            </a>
            <a
              href={SITE.social.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="text-base-content/80 hover:text-accent flex items-center gap-2 transition-colors"
            >
              <Icon name="ph:instagram-logo-bold" class="text-accent h-4 w-4" /> Instagram / sahillangoo.in
            </a>
            <a
              href={SITE.social.devto}
              target="_blank"
              rel="noopener noreferrer"
              class="text-base-content/80 hover:text-accent flex items-center gap-2 transition-colors"
            >
              <Icon name="ph:code-bold" class="text-accent h-4 w-4" /> DEV / sahillangoo
            </a>
          </div>
        </div>
      </div>

      <!-- Right Form -->
      <div class="lg:col-span-2">
        <ContactForm />
      </div>
    </div>
  </div>
</BaseLayout>
