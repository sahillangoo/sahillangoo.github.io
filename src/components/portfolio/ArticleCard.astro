---
import type { CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { cn } from '@utils/cn.ts';

export interface Props {
  post: CollectionEntry<'blog'>;
  headingLevel?: 'h2' | 'h3';
  class?: string;
}

const { post, headingLevel = 'h2', class: className = '' } = Astro.props;
const { data, id } = post;
const HeadingTag = headingLevel;

const formattedDate = new Date(data.publishDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article
  class:list={cn(
    'group relative -mx-3 grid gap-x-6 rounded-md border-b border-base-300 px-3 py-7 transition-colors duration-200 hover:bg-base-200 md:-mx-5 md:grid-cols-12 md:px-5 md:py-8',
    className
  )}
>
  <div class="md:col-span-9">
    <p class="meta">
      {data.category}
      {data.readingTime && ` · ${data.readingTime}`}
    </p>
    <HeadingTag
      transition:name={`blog-title-${id}`}
      class="text-writing mt-2 text-base-content transition-transform duration-200 ease-editorial group-hover:translate-x-1"
    >
      <a href={`/blog/${id}/`} class="after:absolute after:inset-0">
        {data.title}
      </a>
    </HeadingTag>
    <p class="measure-wide mt-3 text-base leading-relaxed text-secondary">{data.description}</p>
  </div>
  <div class="mt-4 flex items-center justify-between md:col-span-3 md:mt-0 md:flex-col md:items-end md:pt-2">
    <time class="meta text-base-content tabular-nums" datetime={data.publishDate}>
      {formattedDate}
    </time>
    <span class="link-arrow text-sm text-secondary group-hover:text-accent">
      Read
      <Icon name="ph:arrow-up-right-bold" class="size-4" />
    </span>
  </div>
</article>
