---
import type { CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';

export interface Props {
  project: CollectionEntry<'projects'>;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
const { data, id } = project;
---

<article
  class={`editorial-card group relative flex flex-col justify-between p-6 sm:p-7 ${
    featured ? 'md:col-span-2' : ''
  }`}
>
  <div>
    <!-- Top Metadata row -->
    <div class="text-base-content/60 mb-3 flex items-center justify-between gap-2 text-xs">
      <span class="text-accent font-mono font-medium tracking-wider uppercase">
        {data.category.replace('-', ' ')}
      </span>
      <span class="font-mono">{data.year}</span>
    </div>

    <!-- Title & Links -->
    <h3
      class="text-base-content group-hover:text-accent text-xl font-bold tracking-tight transition-colors"
    >
      <a href={`/projects/${id}/`} class="after:absolute after:inset-0 focus:outline-none">
        {data.title}
      </a>
    </h3>

    <!-- Description -->
    <p class="text-base-content/70 mt-2.5 text-sm leading-relaxed">
      {data.description}
    </p>
  </div>

  <!-- Tags and External Action links -->
  <div
    class="border-base-300/60 mt-6 flex flex-wrap items-center justify-between gap-4 border-t pt-4"
  >
    <div class="flex flex-wrap gap-1.5">
      {
        data.tags
          .slice(0, 4)
          .map((tag) => (
            <span class="bg-base-300/40 text-base-content/70 rounded-md px-2 py-0.5 font-mono text-[11px]">
              {tag}
            </span>
          ))
      }
    </div>

    <div class="text-base-content/70 relative z-10 flex items-center gap-2">
      {
        data.githubUrl && (
          <a
            href={data.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`GitHub repo for ${data.title}`}
            class="btn btn-ghost btn-xs btn-square hover:text-base-content"
          >
            <Icon name="ph:github-logo-bold" class="h-4 w-4" />
          </a>
        )
      }
      {
        data.liveUrl && (
          <a
            href={data.liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Live demo for ${data.title}`}
            class="btn btn-ghost btn-xs btn-square hover:text-base-content"
          >
            <Icon name="ph:arrow-square-out-bold" class="h-4 w-4" />
          </a>
        )
      }
    </div>
  </div>
</article>
