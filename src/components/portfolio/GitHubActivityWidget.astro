---
import { Icon } from 'astro-icon/components';
import { getGitHubActivity } from '../../utils/github';

export interface Props {
  username?: string;
  limit?: number;
}

const { username = 'sahillangoo', limit = 6 } = Astro.props;

// Fetch live build-time GitHub contributions and verified commits (with persistent cache fallback)
const { totalContributions, contributionWeeks, recentCommits } = await getGitHubActivity(
  username,
  limit
);

function formatTooltipDate(dateStr: string): string {
  try {
    const d = new Date(dateStr);
    return d.toLocaleDateString('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
    });
  } catch {
    return dateStr;
  }
}
---

<div class="editorial-card space-y-6 p-6 sm:p-7">
  <!-- Header -->
  <div
    class="border-base-300 flex flex-col justify-between gap-3 border-b pb-4 sm:flex-row sm:items-center"
  >
    <div class="flex items-center gap-3">
      <div class="bg-base-300/50 text-accent flex h-9 w-9 items-center justify-center rounded-lg">
        <Icon name="ph:git-commit-bold" class="h-5 w-5" />
      </div>
      <div>
        <h2 class="text-base-content flex items-center gap-2 text-base font-bold">
          Git Activity & Verified Commit Stream
          <span
            class="bg-accent/10 text-accent py-0.2 rounded-full px-2 font-mono text-[10px] font-medium"
          >
            Live Stream
          </span>
        </h2>
        <p class="text-base-content/60 font-mono text-xs">@sahillangoo • @SquadCoders & @ecspl</p>
      </div>
    </div>

    <div class="flex items-center gap-3 self-end sm:self-center">
      <a
        href="https://github.com/SquadCoders"
        target="_blank"
        rel="noopener noreferrer"
        class="text-base-content/70 hover:text-accent inline-flex items-center gap-1 font-mono text-xs transition-colors"
      >
        <span>@SquadCoders</span>
        <Icon name="ph:arrow-up-right-bold" class="h-3.5 w-3.5" />
      </a>
      <span class="text-base-content/30">•</span>
      <a
        href={`https://github.com/${username}`}
        target="_blank"
        rel="noopener noreferrer"
        class="text-base-content/70 hover:text-accent inline-flex items-center gap-1 font-mono text-xs transition-colors"
      >
        <span>@{username}</span>
        <Icon name="ph:arrow-up-right-bold" class="h-3.5 w-3.5" />
      </a>
    </div>
  </div>

  <!-- Real GitHub Green Contribution Heatmap -->
  <div class="space-y-2.5">
    <div class="text-base-content/60 flex items-center justify-between font-mono text-[11px]">
      <span>Contribution Momentum across Orgs</span>
      <span class="font-medium text-emerald-400">
        ● {totalContributions.toLocaleString()}+ Commits & PRs in the last year
      </span>
    </div>

    <div class="bg-base-200/40 border-base-300/60 rounded-lg border p-3">
      <!-- Scrollable Heatmap Grid Container -->
      <div class="flex scrollbar-none gap-1 overflow-x-auto py-1">
        {
          contributionWeeks.map((week) => (
            <div class="flex shrink-0 flex-col gap-1">
              {week.map((day) => {
                let bg = 'bg-base-300/40 dark:bg-base-300/25';
                if (day.level === 1) bg = 'bg-emerald-950/80 border border-emerald-800/40';
                if (day.level === 2) bg = 'bg-emerald-800/80';
                if (day.level === 3) bg = 'bg-emerald-600/90';
                if (day.level === 4) bg = 'bg-emerald-400';

                const tooltip =
                  day.count === 0
                    ? `No contributions on ${formatTooltipDate(day.date)}`
                    : `${day.count} contribution${day.count > 1 ? 's' : ''} on ${formatTooltipDate(day.date)}`;

                return (
                  <div
                    class={`h-2.5 w-2.5 rounded-[2px] transition-transform hover:scale-125 ${bg}`}
                    title={tooltip}
                  />
                );
              })}
            </div>
          ))
        }
      </div>

      <!-- Heatmap Legend -->
      <div
        class="border-base-300/40 text-base-content/50 mt-2.5 flex items-center justify-between border-t pt-2 font-mono text-[10px]"
      >
        <span class="hidden sm:inline">365-Day Activity Vector</span>
        <div class="flex items-center gap-1.5 self-end sm:self-auto">
          <span>Less</span>
          <div class="bg-base-300/40 h-2 w-2 rounded-[2px]" title="0 contributions"></div>
          <div
            class="h-2 w-2 rounded-[2px] border border-emerald-800/40 bg-emerald-950/80"
            title="1-3 contributions"
          >
          </div>
          <div class="h-2 w-2 rounded-[2px] bg-emerald-800/80" title="4-8 contributions"></div>
          <div class="h-2 w-2 rounded-[2px] bg-emerald-600/90" title="9-15 contributions"></div>
          <div class="h-2 w-2 rounded-[2px] bg-emerald-400" title="16+ contributions"></div>
          <span>More</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Recent Commits Stream -->
  <div class="space-y-3">
    <span
      class="text-base-content/60 block font-mono text-xs font-semibold tracking-wider uppercase"
    >
      Recent Verified Commits & Pull Requests
    </span>

    <div class="space-y-2.5">
      {
        recentCommits.map((commit) => (
          <div class="group bg-base-100/60 border-base-300/60 hover:border-base-300 flex flex-col justify-between gap-2 rounded-lg border p-3 transition-colors sm:flex-row sm:items-center">
            <div class="flex min-w-0 items-start gap-2.5">
              <span
                class={`py-0.2 mt-0.5 shrink-0 rounded px-1.5 font-mono text-[10px] font-semibold ${
                  commit.type === 'feat'
                    ? 'border border-sky-500/20 bg-sky-500/10 text-sky-400'
                    : commit.type === 'fix'
                      ? 'border border-amber-500/20 bg-amber-500/10 text-amber-400'
                      : 'border border-zinc-500/20 bg-zinc-500/10 text-zinc-400'
                }`}
              >
                {commit.type}
              </span>
              <div class="min-w-0">
                <p class="text-base-content group-hover:text-accent line-clamp-1 text-xs leading-snug font-medium transition-colors">
                  {commit.message}
                </p>
                <div class="text-base-content/50 mt-0.5 flex items-center gap-2 font-mono text-[11px]">
                  <span class="text-accent font-medium">{commit.repo}</span>
                  <span>•</span>
                  <span>{commit.date}</span>
                </div>
              </div>
            </div>

            <a
              href={commit.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-base-content/50 hover:text-accent shrink-0 self-end font-mono text-[11px] sm:self-center"
            >
              #{commit.sha}
            </a>
          </div>
        ))
      }
    </div>
  </div>
</div>
