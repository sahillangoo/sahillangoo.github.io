---
import { Icon } from 'astro-icon/components';
import { getGitHubActivity } from '@utils/github.ts';

export interface Props {
  username?: string;
  limit?: number;
}

const { username = 'sahillangoo', limit = 6 } = Astro.props;

// Fetch live build-time GitHub contributions and verified commits
const { totalContributions, contributionWeeks, recentCommits } = await getGitHubActivity(
  username,
  limit
);

function formatTooltipDate(dateStr: string): string {
  try {
    const d = new Date(dateStr);
    return d.toLocaleDateString('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
    });
  } catch {
    return dateStr;
  }
}

// Compute month labels aligned to start of months across the 53 weeks
let lastMonth = -1;
const monthLabels: { index: number; label: string }[] = [];

contributionWeeks.forEach((week, index) => {
  if (!week[0]?.date) return;
  const d = new Date(week[0].date);
  const m = d.getMonth();
  if (m !== lastMonth) {
    // Only display label if at least 3 columns apart to prevent overlapping
    const lastEntry = monthLabels[monthLabels.length - 1];
    if (!lastEntry || index - lastEntry.index >= 3) {
      monthLabels.push({
        index,
        label: d.toLocaleDateString('en-US', { month: 'short' }),
      });
      lastMonth = m;
    }
  }
});
---

<div class="border-base-300 bg-base-200 space-y-6 rounded-xl border p-6 sm:p-7">
  <!-- Widget Header (Authentic GitHub Style) -->
  <div
    class="border-base-300/80 flex flex-col justify-between gap-4 border-b pb-5 sm:flex-row sm:items-center"
  >
    <div class="flex items-center gap-3.5">
      <div
        class="bg-base-300/40 text-base-content flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-white/5 shadow-inner"
      >
        <Icon name="ph:git-commit-bold" class="text-github-active h-5 w-5" />
      </div>
      <div>
        <div class="flex flex-wrap items-center gap-2">
          <h2 class="text-base-content text-base font-bold tracking-tight sm:text-lg">
            {totalContributions.toLocaleString()} contributions in the last year
          </h2>
          <span
            class="badge badge-sm border-github-active/30 bg-github-active/10 text-github-active font-mono text-xs font-medium"
          >
            Verified Stream
          </span>
        </div>
        <p class="text-base-content/60 font-mono text-xs">
          @{username} • Full Stack Architecture & Open-Source Engineering
        </p>
      </div>
    </div>

    <!-- Quick Org & Profile Links -->
    <div class="flex items-center gap-2.5 self-end sm:self-center">
      <a
        href="https://github.com/SquadCoders"
        target="_blank"
        rel="noopener noreferrer"
        class="border-base-300/80 bg-base-200/50 hover:border-accent/40 text-base-content/75 hover:text-base-content inline-flex items-center gap-1.5 rounded-md border px-2.5 py-1 font-mono text-xs transition-colors"
      >
        <span>@SquadCoders</span>
        <Icon name="ph:arrow-up-right-bold" class="h-3 w-3 opacity-60" />
      </a>
      <a
        href={`https://github.com/${username}`}
        target="_blank"
        rel="noopener noreferrer"
        class="border-base-300/80 bg-base-200/50 hover:border-accent/40 text-base-content/75 hover:text-base-content inline-flex items-center gap-1.5 rounded-md border px-2.5 py-1 font-mono text-xs transition-colors"
      >
        <Icon name="ph:github-logo-fill" class="h-3.5 w-3.5 opacity-80" />
        <span>@{username}</span>
        <Icon name="ph:arrow-up-right-bold" class="h-3 w-3 opacity-60" />
      </a>
      <div class="flex items-center gap-2">
        <span
          class="badge badge-sm border-base-300 bg-base-100 text-base-content/70 hidden items-center gap-1.5 font-mono text-xs sm:inline-flex"
        >
          <span class="bg-github-active h-2 w-2 animate-pulse rounded-full"></span>
          Active Profile
        </span>
      </div>
    </div>
  </div>

  <!-- Real GitHub Green Contribution Heatmap Graph -->
  <div class="space-y-2">
    <div class="text-base-content/70 flex items-center justify-between font-mono text-xs">
      <span class="font-medium tracking-wide">Contribution Activity Calendar</span>
      <span class="text-github-active flex items-center gap-1.5 font-medium">
        <span class="bg-github-active shadow-glow-github h-1.5 w-1.5 rounded-full"></span>
        Live Graph
      </span>
    </div>

    <!-- Outer Graph Container -->
    <div class="border-base-300/80 bg-base-200/30 rounded-xl border p-4 sm:p-5">
      <div class="scrollbar-none overflow-x-auto pb-1">
        <div class="inline-block min-w-max">
          <!-- Month Labels Row -->
          <div class="text-base-content/65 mb-1.5 flex pl-8 font-mono text-xs">
            {
              contributionWeeks.map((_, i) => {
                const match = monthLabels.find((m) => m.index === i);
                return (
                  <div class="w-2.5 shrink-0 sm:w-3">
                    {match ? <span class="block whitespace-nowrap">{match.label}</span> : null}
                  </div>
                );
              })
            }
          </div>

          <!-- Heatmap Main Rows with Weekday Column -->
          <div class="flex items-start gap-2">
            <!-- Weekday Labels (Mon, Wed, Fri) -->
            <div
              class="text-base-content/65 flex flex-col justify-between font-mono text-xs select-none"
            >
              <span class="h-2.5 leading-none sm:h-3 sm:leading-none"></span>
              <span class="h-2.5 leading-none sm:h-3 sm:leading-none">Mon</span>
              <span class="h-2.5 leading-none sm:h-3 sm:leading-none"></span>
              <span class="h-2.5 leading-none sm:h-3 sm:leading-none">Wed</span>
              <span class="h-2.5 leading-none sm:h-3 sm:leading-none"></span>
              <span class="h-2.5 leading-none sm:h-3 sm:leading-none">Fri</span>
              <span class="h-2.5 leading-none sm:h-3 sm:leading-none"></span>
            </div>

            <!-- Contribution Grid Columns -->
            <div class="flex gap-0.5">
              {
                contributionWeeks.map((week) => (
                  <div class="flex flex-col gap-0.5">
                    {week.map((day) => {
                      const countText =
                        day.count === 0
                          ? `No contributions on ${formatTooltipDate(day.date)}`
                          : `${day.count} contribution${day.count === 1 ? '' : 's'} on ${formatTooltipDate(day.date)}`;

                      return (
                        <div
                          class:list={`gh-cell-${day.level} h-2.5 w-2.5 rounded-xs transition-transform duration-100 hover:scale-125 sm:h-3 sm:w-3`}
                          title={countText}
                        />
                      );
                    })}
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>

      <!-- Graph Footer & Color Scale Legend -->
      <div
        class="border-base-300/60 text-base-content/60 mt-3 flex flex-col justify-between gap-2 border-t pt-3 font-mono text-xs sm:flex-row sm:items-center"
      >
        <a
          href="https://docs.github.com/en/account-and-profile/setting-up-and-managing-your-github-profile/managing-contribution-settings-on-your-profile/why-are-my-contributions-not-showing-up-on-my-profile"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-accent inline-flex items-center gap-1 transition-colors"
        >
          <span>Learn how contributions are counted</span>
          <Icon name="ph:arrow-up-right-bold" class="h-2.5 w-2.5 opacity-60" />
        </a>

        <div
          class="text-base-content/60 flex items-center gap-1.5 self-end font-mono text-xs sm:self-auto"
        >
          <span>Less</span>
          <div class="gh-cell-0 h-2.5 w-2.5 rounded-xs" title="0 contributions"></div>
          <div class="gh-cell-1 h-2.5 w-2.5 rounded-xs" title="1-3 contributions"></div>
          <div class="gh-cell-2 h-2.5 w-2.5 rounded-xs" title="4-8 contributions"></div>
          <div class="gh-cell-3 h-2.5 w-2.5 rounded-xs" title="9-15 contributions"></div>
          <div class="gh-cell-4 h-2.5 w-2.5 rounded-xs" title="16+ contributions"></div>
          <span>More</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Recent Commits Feed Section -->
  <div class="space-y-3 pt-1">
    <div class="flex items-center justify-between">
      <span
        class="text-base-content/70 block font-mono text-xs font-semibold tracking-wider uppercase"
      >
        Recent Verified Commits & Pull Requests
      </span>
      <span class="text-base-content/50 font-mono text-xs">Latest verified commits</span>
    </div>

    <div class="space-y-2">
      {
        recentCommits.map((commit) => (
          <div class="group border-base-300/80 bg-base-100/60 hover:border-base-content/20 flex flex-col justify-between gap-2.5 rounded-lg border p-3.5 transition-all sm:flex-row sm:items-center">
            <div class="flex min-w-0 items-start gap-3">
              <span
                class:list={[
                  'badge badge-sm mt-0.5 shrink-0 font-mono text-xs font-semibold',
                  commit.type === 'feat'
                    ? 'border-github-active/30 bg-github-active/10 text-github-active'
                    : commit.type === 'fix'
                      ? 'border border-amber-500/30 bg-amber-500/10 text-amber-400'
                      : 'border border-zinc-500/30 bg-zinc-500/10 text-zinc-400',
                ]}
              >
                {commit.type}
              </span>
              <div class="min-w-0">
                <p class="text-base-content group-hover:text-accent line-clamp-1 text-xs leading-snug font-medium transition-colors">
                  {commit.message}
                </p>
                <div class="text-base-content/65 mt-1 flex flex-wrap items-center gap-2 font-mono text-xs">
                  <span class="text-accent/90 font-medium">{commit.repo}</span>
                  <span class="opacity-60">•</span>
                  <span>{commit.date}</span>
                </div>
              </div>
            </div>

            <a
              href={commit.url}
              target="_blank"
              rel="noopener noreferrer"
              class="badge badge-sm border-base-300/80 bg-base-200/40 text-base-content/60 hover:border-github-active/40 hover:text-github-active shrink-0 self-end font-mono text-xs transition-colors sm:self-center"
            >
              #{commit.sha}
            </a>
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  /* Exact GitHub Contribution Green Color Matrix */
  .gh-cell-0 {
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.06);
    background-color: #ebedf0;
  }
  :global([data-theme='dark']) .gh-cell-0,
  :global(.dark) .gh-cell-0 {
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.05);
    background-color: #161b22;
  }

  .gh-cell-1 {
    background-color: #9be9a8;
  }
  :global([data-theme='dark']) .gh-cell-1,
  :global(.dark) .gh-cell-1 {
    box-shadow: inset 0 0 0 1px rgba(0, 109, 50, 0.3);
    background-color: #0e4429;
  }

  .gh-cell-2 {
    background-color: #40c463;
  }
  :global([data-theme='dark']) .gh-cell-2,
  :global(.dark) .gh-cell-2 {
    background-color: #006d32;
  }

  .gh-cell-3 {
    background-color: #30a14e;
  }
  :global([data-theme='dark']) .gh-cell-3,
  :global(.dark) .gh-cell-3 {
    background-color: #26a641;
  }

  .gh-cell-4 {
    background-color: #216e39;
  }
  :global([data-theme='dark']) .gh-cell-4,
  :global(.dark) .gh-cell-4 {
    box-shadow: 0 0 6px rgba(57, 211, 83, 0.35);
    background-color: #39d353;
  }
</style>
