---
import { getCollection } from 'astro:content';
import ProjectCard from '@components/portfolio/ProjectCard.astro';
import { Icon } from 'astro-icon/components';
import { cn } from '@utils/cn.ts';

const projects = await getCollection('projects');
const sortedProjects = projects.toSorted((a, b) => a.data.order - b.data.order);

const categories = [
  { id: 'all', label: 'All Projects' },
  { id: 'web-app', label: 'Web Apps' },
  { id: 'open-source', label: 'Open Source' },
  { id: 'cli-tool', label: 'CLI & Tools' },
  { id: 'systems', label: 'Systems' },
];
---

<div class="space-y-8" id="project-filter-root">
  <!-- Filter Controls -->
  <nav
    aria-label="Filter projects"
    class="border-base-300 flex flex-col gap-2.5 border-b pb-4 sm:flex-row sm:items-center"
  >
    <span class="text-secondary shrink-0 flex items-center gap-1.5 font-mono text-xs">
      <Icon name="ph:funnel-bold" class="size-3.5" />
      Filter:
    </span>
    <div class="flex items-center gap-2 overflow-x-auto pb-1 sm:flex-wrap sm:overflow-visible">
      {categories.map((cat, idx) => (
        <button
          type="button"
          data-filter={cat.id}
          aria-pressed={idx === 0 ? 'true' : 'false'}
          class:list={cn(
            'filter-btn rounded-md px-3 py-2 sm:py-1.5 min-h-10 shrink-0 font-mono text-xs transition-colors',
            idx === 0
              ? 'bg-base-content text-base-100 active-filter hover:text-base-100 hover:bg-base-content/90 font-medium'
              : 'bg-base-200 text-secondary hover:bg-base-300 hover:text-base-content'
          )}
        >
          {cat.label}
        </button>
      ))}
    </div>
  </nav>

  <!-- Projects Grid -->
  <ul id="projects-grid">
    {sortedProjects.map((project) => (
      <li class="project-item" data-category={project.data.category}>
        <ProjectCard project={project} />
      </li>
    ))}
  </ul>

  <p id="no-projects-msg" class="text-secondary hidden py-12 text-center font-mono text-sm">
    No projects found matching the selected filter.
  </p>
</div>

<script>
  function setupProjectFilter() {
    const root = document.getElementById('project-filter-root');
    if (!root) return;

    const lifecycleAbort = new AbortController();
    const { signal } = lifecycleAbort;

    const filterBtns = root.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const items = root.querySelectorAll<HTMLElement>('.project-item');
    const emptyMsg = document.getElementById('no-projects-msg');

    root.addEventListener(
      'click',
      (e) => {
        const btn = (e.target as HTMLElement | null)?.closest<HTMLButtonElement>('.filter-btn');
        if (!btn || !root.contains(btn)) return;

        const filter = btn.getAttribute('data-filter');

        // Update button active state
        filterBtns.forEach((b) => {
          const isActive = b === btn;
          b.setAttribute('aria-pressed', isActive ? 'true' : 'false');
          b.classList.toggle('bg-base-content', isActive);
          b.classList.toggle('text-base-100', isActive);
          b.classList.toggle('font-medium', isActive);
          b.classList.toggle('active-filter', isActive);
          b.classList.toggle('hover:text-base-100', isActive);
          b.classList.toggle('hover:bg-base-content/90', isActive);

          b.classList.toggle('bg-base-200', !isActive);
          b.classList.toggle('text-secondary', !isActive);
          b.classList.toggle('hover:bg-base-300', !isActive);
          b.classList.toggle('hover:text-base-content', !isActive);
        });

        // Filter items using native hidden attribute
        let visibleCount = 0;
        items.forEach((item) => {
          const category = item.getAttribute('data-category');
          const isMatch = filter === 'all' || category === filter;
          item.hidden = !isMatch;
          if (isMatch) visibleCount++;
        });

        if (emptyMsg) {
          emptyMsg.classList.toggle('hidden', visibleCount > 0);
        }
      },
      { signal }
    );

    document.addEventListener('astro:before-swap', () => lifecycleAbort.abort(), { once: true });
  }

  document.addEventListener('astro:page-load', setupProjectFilter);
</script>
