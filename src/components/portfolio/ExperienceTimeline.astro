---
import type { CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';

export interface Props {
  experiences: CollectionEntry<'experience'>[];
}

const { experiences } = Astro.props;
const sorted = [...experiences].sort((a, b) => a.data.order - b.data.order);
---

<div class="border-base-300 relative ml-3 space-y-10 border-l pl-6 md:ml-4 md:pl-8">
  {
    sorted.map((exp) => {
      const { data } = exp;
      return (
        <div class="group relative">
          {/* Timeline Node dot */}
          <div class="border-base-100 bg-base-300 group-hover:bg-accent absolute top-1.5 -left-8 flex h-4 w-4 items-center justify-center rounded-full border-2 transition-all group-hover:scale-125 md:-left-10">
            {data.current && <div class="bg-accent h-1.5 w-1.5 animate-pulse rounded-full" />}
          </div>

          {/* Header */}
          <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
            <div>
              <h3 class="text-base-content flex items-center gap-2 text-lg font-bold">
                {data.role}
                {data.current && (
                  <span class="badge badge-sm border-emerald-500/20 bg-emerald-500/10 font-mono text-xs font-medium text-emerald-400">
                    Current
                  </span>
                )}
              </h3>
              <div class="text-accent mt-0.5 text-sm font-medium">
                {data.companyUrl ? (
                  <a
                    href={data.companyUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 hover:underline"
                  >
                    {data.company} <Icon name="ph:arrow-square-out-bold" class="inline h-3 w-3" />
                  </a>
                ) : (
                  <span>{data.company}</span>
                )}
                <span class="text-base-content/40 font-normal"> • {data.location}</span>
              </div>
            </div>
            <span class="text-base-content/60 font-mono text-xs">{data.period}</span>
          </div>

          {/* Highlights List */}
          <ul class="text-base-content/75 mt-3.5 space-y-2 text-sm leading-relaxed">
            {data.highlights.map((item) => (
              <li class="flex items-start gap-2">
                <span class="text-accent mt-1 select-none">›</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>

          {/* Skills tags */}
          {data.skills.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-1.5">
              {data.skills.map((skill) => (
                <span class="badge badge-sm border-base-300 bg-base-200 text-base-content/70 font-mono text-xs">
                  {skill}
                </span>
              ))}
            </div>
          )}
        </div>
      );
    })
  }
</div>
