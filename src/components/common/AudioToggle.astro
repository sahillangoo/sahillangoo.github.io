---
import { Icon } from 'astro-icon/components';
---

<button
  type="button"
  class="audio-toggle-btn btn btn-ghost btn-square size-8 text-secondary hover:text-base-content"
  title="Toggle UI Sound Effects (Procedural Web Audio)"
  aria-label="Toggle UI Sound Effects"
  aria-pressed="false"
>
  <Icon name="ph:speaker-high" class="audio-icon-unmuted hidden size-3.5" aria-hidden="true" />
  <Icon name="ph:speaker-slash" class="audio-icon-muted size-3.5" aria-hidden="true" />
</button>

<script>
  let audioEngineInstance: typeof import('@utils/audioEngine.ts').audioEngine | null = null;

  async function getAudioEngine() {
    if (!audioEngineInstance) {
      const module = await import('@utils/audioEngine.ts');
      audioEngineInstance = module.audioEngine;
    }
    return audioEngineInstance;
  }

  function isAudioMuted(): boolean {
    if (audioEngineInstance) {
      return audioEngineInstance.isMutedState();
    }
    if (typeof window !== 'undefined') {
      return localStorage.getItem('sl_sound_effects') !== 'enabled';
    }
    return true;
  }

  function updateAllAudioToggleUIs(): void {
    const isMuted = isAudioMuted();
    const buttons = document.querySelectorAll<HTMLButtonElement>('.audio-toggle-btn');

    buttons.forEach((btn) => {
      const unmutedIcon = btn.querySelector('.audio-icon-unmuted');
      const mutedIcon = btn.querySelector('.audio-icon-muted');
      if (!unmutedIcon || !mutedIcon) return;

      if (isMuted) {
        unmutedIcon.classList.add('hidden');
        mutedIcon.classList.remove('hidden');
        btn.setAttribute('title', 'Sound Effects: Off (Click to enable)');
        btn.setAttribute('aria-label', 'Sound Effects: Off (Click to enable)');
        btn.setAttribute('aria-pressed', 'false');
      } else {
        unmutedIcon.classList.remove('hidden');
        mutedIcon.classList.add('hidden');
        btn.setAttribute('title', 'Sound Effects: On (Click to mute)');
        btn.setAttribute('aria-label', 'Sound Effects: On (Click to mute)');
        btn.setAttribute('aria-pressed', 'true');
      }
    });
  }

  let isAudioToggleInitialized = false;
  if (!isAudioToggleInitialized) {
    isAudioToggleInitialized = true;

    // Synchronize UI if mute status changes in another component or tab
    window.addEventListener('sl-audio-mute-change', updateAllAudioToggleUIs);
    window.addEventListener('storage', (e) => {
      if (e.key === 'sl_sound_effects') updateAllAudioToggleUIs();
    });

    document.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;

      const toggleBtn = target.closest('.audio-toggle-btn');
      if (toggleBtn) {
        const engine = await getAudioEngine();
        engine.toggleMute();
        updateAllAudioToggleUIs();
        return;
      }

      if (!isAudioMuted()) {
        const interactiveEl = target.closest('a, button, input[type="checkbox"]');
        if (interactiveEl && !interactiveEl.closest('.audio-no-click')) {
          const engine = await getAudioEngine();
          engine.playClick('soft');
        }
      }
    });
  }

  document.addEventListener('astro:page-load', updateAllAudioToggleUIs);
</script>
