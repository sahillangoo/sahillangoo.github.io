---
import { Icon } from 'astro-icon/components';
---

<button
  id="audio-toggle-btn"
  type="button"
  class="btn btn-ghost btn-xs btn-square text-base-content/70 hover:text-base-content hover:bg-base-200 transition-colors active:scale-95"
  title="Toggle UI Sound Effects (Procedural Web Audio)"
  aria-label="Toggle UI Sound Effects"
>
  <Icon
    id="audio-icon-unmuted"
    name="ph:speaker-high-bold"
    class="hidden h-4 w-4 text-emerald-400"
  />
  <Icon id="audio-icon-muted" name="ph:speaker-slash-bold" class="h-4 w-4" />
</button>

<script>
  let audioEngineInstance: typeof import('@utils/audioEngine.ts').audioEngine | null = null;

  async function getAudioEngine() {
    if (!audioEngineInstance) {
      const module = await import('@utils/audioEngine.ts');
      audioEngineInstance = module.audioEngine;
    }
    return audioEngineInstance;
  }

  function isAudioMuted(): boolean {
    if (audioEngineInstance) {
      return audioEngineInstance.isMutedState();
    }
    if (typeof window !== 'undefined') {
      return localStorage.getItem('sl_sound_effects') !== 'enabled';
    }
    return true;
  }

  function updateAudioToggleUI() {
    const unmutedIcon = document.getElementById('audio-icon-unmuted');
    const mutedIcon = document.getElementById('audio-icon-muted');
    const btn = document.getElementById('audio-toggle-btn');
    if (!unmutedIcon || !mutedIcon || !btn) return;

    const isMuted = isAudioMuted();
    if (isMuted) {
      unmutedIcon.classList.add('hidden');
      mutedIcon.classList.remove('hidden');
      btn.setAttribute('title', 'Sound Effects: Off (Click to enable)');
    } else {
      unmutedIcon.classList.remove('hidden');
      mutedIcon.classList.add('hidden');
      btn.setAttribute('title', 'Sound Effects: On (Click to mute)');
    }
  }

  const win = window as unknown as Record<string, unknown>;
  if (!win.__AUDIO_TOGGLE_INIT__) {
    win.__AUDIO_TOGGLE_INIT__ = true;

    document.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;

      const toggleBtn = target.closest('#audio-toggle-btn');
      if (toggleBtn) {
        const engine = await getAudioEngine();
        engine.toggleMute();
        updateAudioToggleUI();
        return;
      }

      if (!isAudioMuted()) {
        const interactiveEl = target.closest('a, button, input[type="checkbox"]');
        if (interactiveEl) {
          const engine = await getAudioEngine();
          engine.playClick('soft');
        }
      }
    });
  }

  document.addEventListener('astro:page-load', updateAudioToggleUI);
</script>
