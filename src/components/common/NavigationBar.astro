---
import { SITE } from '@const/site.ts';
import ThemeToggle from '@components/common/ThemeToggle.astro';
import AudioToggle from '@components/common/AudioToggle.astro';
import { Icon } from 'astro-icon/components';
import { cn } from '@utils/cn.ts';

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header
  id="site-header"
  class="fixed top-0 right-0 left-0 z-50 w-full border-b border-transparent transition-all duration-200"
  transition:persist="main-header"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 sm:px-6 md:py-5">
    <!-- Brand / Name with Status -->
    <a
      href="/"
      class="group text-base-content flex items-center gap-3 font-semibold transition-opacity hover:opacity-80"
    >
      <span
        class="bg-base-200 border-base-300 text-accent flex h-8 w-8 items-center justify-center rounded-md border font-mono text-xs font-bold"
      >
        SL
      </span>
      <div class="flex flex-col">
        <span class="text-sm leading-tight font-semibold tracking-tight">{SITE.name}</span>
        <span class="text-base-content/60 flex items-center gap-1.5 text-xs">
          <span class="relative flex h-1.5 w-1.5">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"
            >
            </span>
            <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
          </span>
          Available for work
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav
      id="desktop-nav"
      class="border-base-300 bg-base-200/60 hidden items-center gap-1 rounded-full border px-3 py-1.5 backdrop-blur-md md:flex"
    >
      {
        SITE.nav.map((item) => {
          const active = isActive(item.href);
          return (
            <a
              href={item.href}
              data-nav-link={item.href}
              class={cn(
                'nav-item rounded-full px-3.5 py-1 text-xs font-medium transition-all duration-150 active:scale-95',
                active
                  ? 'bg-base-content text-base-100 hover:text-base-100 hover:bg-base-content/90 font-semibold shadow-xs'
                  : 'text-base-content/70 hover:text-base-content hover:bg-base-300/50'
              )}
            >
              {item.label}
            </a>
          );
        })
      }
      <a
        href="/now/"
        data-nav-link="/now/"
        class={cn(
          'nav-item rounded-full px-3.5 py-1 text-xs font-medium transition-all duration-150 active:scale-95 flex items-center gap-1.5',
          isActive('/now/')
            ? 'bg-base-content text-base-100 font-semibold shadow-xs hover:text-base-100 hover:bg-base-content/90'
            : 'text-base-content/70 hover:text-base-content hover:bg-base-300/50'
        )}
      >
        <span class="bg-accent h-1.5 w-1.5 animate-pulse rounded-full"></span>
        Now
      </a>
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-2">
      <!-- Command Palette Trigger Button -->
      <button
        type="button"
        data-open-palette
        aria-label="Open command palette"
        class="border-base-300 bg-base-200/80 text-base-content/60 hover:text-base-content hover:border-base-content/30 hidden items-center gap-2 rounded-lg border px-2.5 py-1.5 font-mono text-xs transition-all active:scale-95 sm:inline-flex"
      >
        <Icon name="ph:magnifying-glass-bold" class="h-3.5 w-3.5" />
        <span class="text-xs">Search</span>
        <kbd
          class="border-base-300 bg-base-100 text-base-content/50 rounded border px-1.5 py-0.5 font-mono text-xs"
        >
          ⌘K
        </kbd>
      </button>

      <!-- Mobile Search Icon Button -->
      <button
        type="button"
        data-open-palette
        aria-label="Open command palette"
        class="btn btn-ghost btn-sm btn-square text-base-content/70 hover:text-base-content rounded-md sm:hidden"
      >
        <Icon name="ph:magnifying-glass-bold" class="h-4 w-4" />
      </button>

      <AudioToggle />
      <ThemeToggle />

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-open"
        type="button"
        aria-label="Open mobile menu"
        class="btn btn-ghost btn-sm btn-square text-base-content/80 hover:text-base-content rounded-md md:hidden"
      >
        <Icon name="ph:list-bold" class="h-5 w-5" />
      </button>
    </div>
  </div>
</header>

<script>
  const handleScroll = () => {
    const header = document.getElementById('site-header');
    if (!header) return;
    if (window.scrollY > 20) {
      header.classList.add('backdrop-blur-md', 'border-base-300', 'bg-base-100/85');
      header.classList.remove('border-transparent');
    } else {
      header.classList.remove('backdrop-blur-md', 'border-base-300', 'bg-base-100/85');
      header.classList.add('border-transparent');
    }
  };

  window.addEventListener('scroll', handleScroll, { passive: true });

  function syncNavLinks() {
    handleScroll();

    const current = window.location.pathname;
    const navLinks = document.querySelectorAll<HTMLAnchorElement>('#desktop-nav [data-nav-link]');
    navLinks.forEach((link) => {
      const target = link.getAttribute('data-nav-link');
      const isCurrentActive = target === '/' ? current === '/' : current.startsWith(target || '');
      if (isCurrentActive) {
        link.classList.add(
          'bg-base-content',
          'text-base-100',
          'font-semibold',
          'shadow-xs',
          'hover:text-base-100',
          'hover:bg-base-content/90'
        );
        link.classList.remove(
          'text-base-content/70',
          'hover:bg-base-300/50',
          'hover:text-base-content'
        );
      } else {
        link.classList.remove(
          'bg-base-content',
          'text-base-100',
          'font-semibold',
          'shadow-xs',
          'hover:text-base-100',
          'hover:bg-base-content/90'
        );
        link.classList.add(
          'text-base-content/70',
          'hover:text-base-content',
          'hover:bg-base-300/50'
        );
      }
    });
  }

  window.addEventListener('popstate', () => setTimeout(syncNavLinks, 0));
  document.addEventListener('astro:after-swap', syncNavLinks);
  document.addEventListener('astro:page-load', syncNavLinks);
</script>
