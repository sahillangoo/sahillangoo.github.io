---
import { SITE } from '@const/site.ts';
import ThemeToggle from '@components/common/ThemeToggle.astro';
import AudioToggle from '@components/common/AudioToggle.astro';
import { Icon } from 'astro-icon/components';
import { cn } from '@utils/cn.ts';

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}

const links = SITE.nav;
---

<header
  id="site-header"
  class="navbar animate-fade fixed top-0 right-0 left-0 z-40 min-h-14 border-b border-base-300/80 bg-base-100/85 p-0 backdrop-blur-md"
  style="contain: paint;"
  transition:persist="main-header"
>
  <div class="page-container flex h-14 items-center justify-between gap-4">
    <a
      href="/"
      class="shrink-0 whitespace-nowrap font-display text-2xl font-medium italic leading-none tracking-tight text-base-content"
    >
      {SITE.name}
    </a>

    <nav
      id="desktop-nav"
      class="menu menu-horizontal hidden flex-nowrap items-center gap-0.5 p-0 lg:flex"
    >
      {links.map((item) => {
        const active = isActive(item.href);
        return (
          <a
            href={item.href}
            data-nav-link={item.href}
            class:list={cn(
              'nav-item flex items-center gap-1.5 rounded-md px-3 py-1.5 text-sm transition-colors duration-200',
              active ? 'text-base-content' : 'text-secondary hover:text-base-content'
            )}
          >
            <span
              class:list={cn(
                'nav-dot size-1 rounded-full bg-accent transition-opacity',
                active ? 'opacity-100' : 'opacity-0'
              )}
              aria-hidden="true"
            />
            {item.label}
          </a>
        );
      })}
    </nav>

    <div class="flex items-center gap-2.5">
      <AudioToggle />
      <ThemeToggle />

      <button
        id="mobile-menu-open"
        type="button"
        aria-label="Open mobile menu"
        aria-expanded="false"
        aria-controls="mobile-drawer"
        class="btn btn-ghost btn-square size-11 text-base-content lg:hidden"
      >
        <Icon name="ph:list-bold" class="size-5" />
      </button>
    </div>
  </div>
  <div
    class="scroll-progress pointer-events-none absolute inset-x-0 -bottom-px h-px bg-accent"
    aria-hidden="true"
  ></div>
</header>

<style>
  @supports (animation-timeline: scroll()) {
    .scroll-progress {
      transform-origin: left;
      animation: nav-scroll-progress-kf linear both;
      animation-timeline: scroll();
    }

    @keyframes nav-scroll-progress-kf {
      from {
        transform: scaleX(0);
      }
      to {
        transform: scaleX(1);
      }
    }
  }
</style>

<script>
  const activeClasses = ['text-base-content'];
  const inactiveClasses = ['text-secondary', 'hover:text-base-content'];

  function syncNavLinks(): void {
    const current = window.location.pathname;
    const navLinks = document.querySelectorAll<HTMLAnchorElement>('#desktop-nav [data-nav-link]');
    navLinks.forEach((link) => {
      const target = link.getAttribute('data-nav-link') || '';
      const isCurrent = target === '/' ? current === '/' : current.startsWith(target);
      link.classList.remove(...activeClasses, ...inactiveClasses);
      link.classList.add(...(isCurrent ? activeClasses : inactiveClasses));
      const dot = link.querySelector('.nav-dot');
      if (!dot) return;
      dot.classList.toggle('opacity-100', isCurrent);
      dot.classList.toggle('opacity-0', !isCurrent);
    });
  }

  window.addEventListener('popstate', () => requestAnimationFrame(syncNavLinks));
  document.addEventListener('astro:after-swap', syncNavLinks);
  document.addEventListener('astro:page-load', syncNavLinks);

  const supportsScrollTimeline =
    typeof CSS !== 'undefined' &&
    typeof CSS.supports === 'function' &&
    CSS.supports('animation-timeline: scroll()');

  if (!supportsScrollTimeline) {
    let progressBar: HTMLElement | null = null;
    let cachedTotalHeight = 0;
    let isTicking = false;
    let lenisBound = false;

    function measureScrollDimensions(): void {
      cachedTotalHeight = document.documentElement.scrollHeight - window.innerHeight;
    }

    function renderScrollProgress(): void {
      if (!progressBar) {
        progressBar = document.querySelector<HTMLElement>('#site-header .scroll-progress');
      }
      if (!progressBar) return;

      if (cachedTotalHeight <= 0) {
        progressBar.style.transform = 'scaleX(0)';
        isTicking = false;
        return;
      }

      const win = window as unknown as LenisWindow;
      const currentScroll = win.lenis?.scroll ?? window.scrollY;
      const progress = Math.min(1, Math.max(0, currentScroll / cachedTotalHeight));
      progressBar.style.transform = `scaleX(${progress})`;
      isTicking = false;
    }

    function onScroll(): void {
      if (!isTicking) {
        isTicking = true;
        requestAnimationFrame(renderScrollProgress);
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener(
      'resize',
      () => {
        measureScrollDimensions();
        onScroll();
      },
      { passive: true }
    );

    document.addEventListener('astro:page-load', () => {
      progressBar = document.querySelector<HTMLElement>('#site-header .scroll-progress');
      requestAnimationFrame(() => {
        measureScrollDimensions();
        renderScrollProgress();
      });

      const win = window as unknown as LenisWindow;
      if (win.lenis && !lenisBound) {
        win.lenis.on('scroll', onScroll);
        lenisBound = true;
      }
    });
  }
</script>
