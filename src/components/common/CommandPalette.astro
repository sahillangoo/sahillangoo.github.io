---
import { SITE } from '@const/site.ts';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const blog = await getCollection('blog');

const searchIndex = [
  // Core Pages
  {
    title: 'Home',
    subtitle: 'Overview & Selected Work',
    url: '/',
    icon: 'ph:house-bold',
    category: 'Pages',
  },
  {
    title: 'Projects',
    subtitle: 'All engineered systems & tools',
    url: '/projects/',
    icon: 'ph:folder-notch-bold',
    category: 'Pages',
  },
  {
    title: 'Writing',
    subtitle: 'Technical essays & articles',
    url: '/blog/',
    icon: 'ph:article-bold',
    category: 'Pages',
  },
  {
    title: 'Resume / CV',
    subtitle: 'Experience, timeline & skills',
    url: '/resume/',
    icon: 'ph:briefcase-bold',
    category: 'Pages',
  },
  {
    title: 'About',
    subtitle: 'Background, bio & philosophy',
    url: '/about/',
    icon: 'ph:user-bold',
    category: 'Pages',
  },
  {
    title: 'Now',
    subtitle: 'What I am currently building & learning',
    url: '/now/',
    icon: 'ph:clock-bold',
    category: 'Pages',
  },
  {
    title: 'Uses & Stack',
    subtitle: 'Hardware, software & editor setup',
    url: '/uses/',
    icon: 'ph:laptop-bold',
    category: 'Pages',
  },
  {
    title: 'Colophon',
    subtitle: 'How this site is engineered',
    url: '/colophon/',
    icon: 'ph:info-bold',
    category: 'Pages',
  },
  {
    title: 'Direct Email',
    subtitle: 'hello@sahillangoo.in',
    url: 'mailto:hello@sahillangoo.in',
    icon: 'ph:envelope-simple-bold',
    category: 'Contact',
  },
  {
    title: 'Links Hub',
    subtitle: 'All profiles and quick links',
    url: '/links/',
    icon: 'ph:link-simple-bold',
    category: 'Pages',
  },
  {
    title: 'Privacy Policy',
    subtitle: 'Telemetry disclosures & compliance',
    url: '/privacy/',
    icon: 'ph:shield-check-bold',
    category: 'Pages',
  },

  // Dynamic Projects
  ...projects.map((p) => ({
    title: p.data.title,
    subtitle: p.data.description,
    url: `/projects/${p.id}/`,
    icon: 'ph:folder-notch-bold',
    category: 'Projects',
  })),

  // Dynamic Blog Posts
  ...blog
    .filter((b) => !b.data.draft)
    .map((b) => ({
      title: b.data.title,
      subtitle: `${b.data.category} • ${b.data.publishDate}`,
      url: `/blog/${b.id}/`,
      icon: 'ph:book-open-text-bold',
      category: 'Articles',
    })),
];
---

<div
  id="command-palette-modal"
  class="fixed inset-0 z-modal hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Command Palette"
>
  <!-- Backdrop -->
  <div
    id="command-palette-backdrop"
    class="fixed inset-0 bg-base-content/70 backdrop-blur-xs transition-opacity"
  ></div>

  <!-- Palette Container -->
  <div class="fixed inset-0 z-10 flex items-start justify-center p-3 sm:p-4 sm:pt-24">
    <div class="max-h-screen-safe sm:max-h-modal flex w-full max-w-xl flex-col overflow-hidden rounded-md border border-base-300 bg-base-100/95 backdrop-blur-md">
      <!-- Search Input Header -->
      <div class="border-base-300 flex items-center gap-3 border-b px-4 py-3.5">
        <Icon name="ph:magnifying-glass-bold" class="text-base-content/50 h-4 w-4 shrink-0" />
        <input
          id="command-palette-input"
          type="text"
          placeholder="Search pages, projects, articles..."
          class="text-base-content placeholder:text-base-content/60 w-full bg-transparent text-sm focus:outline-none sm:text-base"
          autocomplete="off"
          spellcheck="false"
        />
        <kbd class="kbd kbd-sm border-base-300 bg-base-200 text-base-content/60 hidden items-center gap-0.5 font-mono text-xs sm:inline-flex">
          ESC
        </kbd>
      </div>

      <!-- Results Container -->
      <div
        id="command-palette-results"
        class="grow space-y-1 overflow-y-auto overscroll-contain p-2"
      >
        <!-- Results will be dynamically filtered and rendered via client script -->
      </div>

      <!-- Palette Footer -->
      <div class="border-base-300/80 bg-base-200/50 text-base-content/60 hidden sm:flex items-center justify-between border-t px-4 py-2.5 font-mono text-xs">
        <div class="flex items-center gap-3">
          <span class="flex items-center gap-1">
            <kbd class="kbd kbd-xs border-base-300 bg-base-100 font-mono">↑</kbd>
            <kbd class="kbd kbd-xs border-base-300 bg-base-100 font-mono">↓</kbd>
            <span>Navigate</span>
          </span>
          <span class="flex items-center gap-1">
            <kbd class="kbd kbd-xs border-base-300 bg-base-100 font-mono">↵</kbd>
            <span>Select</span>
          </span>
        </div>
        <span>{SITE.name}</span>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ searchIndex }}>
  window.__SEARCH_INDEX__ = searchIndex;
</script>

<script>
  import { navigate } from 'astro:transitions/client';

  interface SearchItem {
    title: string;
    subtitle: string;
    url: string;
    icon: string;
    category: string;
  }

  declare global {
    interface Window {
      __SEARCH_INDEX__?: SearchItem[];
    }
  }

  let selectedIndex = 0;
  let filteredItems: SearchItem[] = [];
  let isPaletteInitialized = false;

  function getModal(): HTMLElement | null {
    return document.getElementById('command-palette-modal');
  }

  function getInput(): HTMLInputElement | null {
    return document.getElementById('command-palette-input') as HTMLInputElement | null;
  }

  function getResultsContainer(): HTMLElement | null {
    return document.getElementById('command-palette-results');
  }

  function closePalette(): void {
    const modal = getModal();
    if (modal) {
      modal.classList.add('hidden');
    }
    document.body.style.overflow = '';
  }

  function highlightActiveItem(): void {
    const container = getResultsContainer();
    if (!container) return;

    const items = container.querySelectorAll<HTMLAnchorElement>('.palette-result-item');
    items.forEach((item, index) => {
      const isSelected = index === selectedIndex;
      item.setAttribute('aria-selected', isSelected ? 'true' : 'false');
      item.classList.toggle('bg-base-300', isSelected);
      item.classList.toggle('text-base-content', isSelected);
      item.classList.toggle('font-medium', isSelected);
      item.classList.toggle('text-base-content/75', !isSelected);

      if (isSelected) {
        item.scrollIntoView({ block: 'nearest' });
      }
    });
  }

  function escapeText(value: string): string {
    return value
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;');
  }

  function renderResults(): void {
    const resultsContainer = getResultsContainer();
    if (!resultsContainer) return;

    if (filteredItems.length === 0) {
      resultsContainer.innerHTML =
        '<div class="py-8 text-center font-mono text-xs text-base-content/50">No matching documents or actions found.</div>';
      return;
    }

    let html = '';
    let currentIndex = 0;
    const categories = Array.from(new Set(filteredItems.map((i) => i.category)));

    categories.forEach((cat) => {
      html += `<div class="px-3 pt-3 pb-1 font-mono text-xs font-semibold tracking-wider text-accent uppercase">${escapeText(cat)}</div>`;
      const catItems = filteredItems.filter((i) => i.category === cat);
      catItems.forEach((item) => {
        const isSelected = currentIndex === selectedIndex;
        html += `<a href="${escapeText(item.url)}" data-index="${currentIndex}" aria-selected="${isSelected ? 'true' : 'false'}" class="palette-result-item flex items-center justify-between rounded-lg px-3 py-2.5 text-sm transition-colors ${
          isSelected
            ? 'bg-base-300 font-medium text-base-content'
            : 'text-base-content/75 hover:bg-base-200 hover:text-base-content'
        }"><div class="min-w-0 pr-2"><div class="truncate text-sm font-medium text-base-content">${escapeText(item.title)}</div><div class="mt-0.5 truncate text-xs text-base-content/65">${escapeText(item.subtitle)}</div></div><span class="shrink-0 font-mono text-xs text-base-content/50">Jump ↵</span></a>`;
        currentIndex++;
      });
    });

    resultsContainer.innerHTML = html;
  }

  function filterItems(query: string): void {
    const items: SearchItem[] = window.__SEARCH_INDEX__ || [];
    const q = query.toLowerCase().trim();
    if (!q) {
      filteredItems = [...items];
    } else {
      filteredItems = items.filter(
        (i) =>
          i.title.toLowerCase().includes(q) ||
          i.subtitle.toLowerCase().includes(q) ||
          i.category.toLowerCase().includes(q)
      );
    }
    selectedIndex = 0;
    renderResults();
  }

  function openPalette(): void {
    const modal = getModal();
    const input = getInput();
    if (!modal || !input) return;

    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    input.value = '';
    filterItems('');
    requestAnimationFrame(() => input.focus());
  }

  if (!isPaletteInitialized) {
    isPaletteInitialized = true;

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;

      if (target.closest('[data-open-palette]')) {
        e.preventDefault();
        openPalette();
      } else if (
        target.id === 'command-palette-backdrop' ||
        target.id === 'command-palette-modal' ||
        target.closest('.palette-result-item')
      ) {
        closePalette();
      }
    });

    document.addEventListener('input', (e) => {
      const target = e.target as HTMLElement | null;
      if (target && target.id === 'command-palette-input') {
        filterItems((target as HTMLInputElement).value);
      }
    });

    window.addEventListener('keydown', (e) => {
      const modal = getModal();
      const isHidden = !modal || modal.classList.contains('hidden');

      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (isHidden) {
          openPalette();
        } else {
          closePalette();
        }
      } else if (e.key === 'Escape' && !isHidden) {
        closePalette();
      } else if (!isHidden) {
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          if (filteredItems.length > 0) {
            selectedIndex = (selectedIndex + 1) % filteredItems.length;
            highlightActiveItem();
          }
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          if (filteredItems.length > 0) {
            selectedIndex = (selectedIndex - 1 + filteredItems.length) % filteredItems.length;
            highlightActiveItem();
          }
        } else if (e.key === 'Enter') {
          e.preventDefault();
          const target = filteredItems[selectedIndex];
          if (target) {
            closePalette();
            if (target.url.startsWith('mailto:') || target.url.startsWith('http')) {
              window.location.href = target.url;
            } else {
              navigate(target.url);
            }
          }
        }
      }
    });

    document.addEventListener('astro:before-swap', closePalette);
  }
</script>
