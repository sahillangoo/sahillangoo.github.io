---
interface Props {
  index: string;
  title: string;
  titleId: string;
  description?: string;
}

const { index, title, titleId, description } = Astro.props;
---

<header>
  <p
    class="meta text-accent flex items-center gap-2 after:h-px after:w-6 after:bg-base-300"
    aria-hidden="true"
  >
    {index}
  </p>
  <h2 id={titleId} class="text-section mt-3">
    {title}
  </h2>
  {description && (
    <p class="text-section-copy measure-section mt-3 text-secondary">{description}</p>
  )}
  <slot />
</header>
