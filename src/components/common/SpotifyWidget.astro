---
import { Icon } from 'astro-icon/components';
import { getFeaturedTrack } from '@utils/spotify.ts';
import { cn } from '@utils/cn.ts';

export interface Props {
  variant?: 'card' | 'compact' | 'footer';
  class?: string;
}

const { variant = 'compact', class: className = '' } = Astro.props;
const defaultTrack = getFeaturedTrack(0);
---

<div
  data-spotify-widget
  class:list={cn(
    'spotify-widget-container group border-base-300 bg-base-200/50 hover:bg-base-200/80 inline-flex max-w-full items-center justify-between gap-3 rounded-lg border px-3.5 py-2 text-xs transition-all duration-200 hover:border-success/40',
    variant === 'footer' && 'w-full sm:w-auto',
    className
  )}
>
  <a
    data-spotify-link
    href={defaultTrack.songUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="flex min-w-0 flex-1 items-center gap-3"
    title={`Listen to ${defaultTrack.title} by ${defaultTrack.artist} on Spotify`}
  >
    <!-- Animated 3-Bar Equalizer (100% Compositor GPU Driven, Zero Layout Reflow) -->
    <div class="flex size-3.5 shrink-0 items-end justify-center gap-0.5">
      <span
        class="animate-equalizer h-3.5 w-0.5 origin-bottom rounded-full bg-success"
        style="animation-delay: -0.8s;"
      ></span>
      <span
        class="animate-equalizer h-3.5 w-0.5 origin-bottom rounded-full bg-success"
        style="animation-delay: -0.2s;"
      ></span>
      <span
        class="animate-equalizer h-3.5 w-0.5 origin-bottom rounded-full bg-success"
        style="animation-delay: -0.5s;"
      ></span>
    </div>

    <!-- Track Metadata Column -->
    <div class="flex min-w-0 flex-1 flex-col">
      <div class="flex min-w-0 items-center gap-1.5">
        <span class="label-caps shrink-0 text-success">Listening</span>
        <span
          data-spotify-tag
          class="badge badge-sm badge-soft badge-success hidden shrink-0 font-mono text-xs font-medium whitespace-nowrap sm:inline-flex"
        >
          {defaultTrack.albumTag || 'Coke Studio'}
        </span>
      </div>

      <div class="flex min-w-0 items-center gap-1.5 truncate">
        <span
          data-spotify-title
          class="text-base-content group-hover:text-success truncate font-medium transition-colors"
        >
          {defaultTrack.title}
        </span>
        <span class="text-base-content/30 shrink-0">•</span>
        <span data-spotify-artist class="text-base-content/60 min-w-0 truncate font-mono text-xs">
          {defaultTrack.artist}
        </span>
      </div>
    </div>
  </a>

  <!-- Action buttons: Skip / Next Song & Deep Link -->
  <div class="flex shrink-0 items-center gap-1">
    <button
      data-spotify-skip-btn
      type="button"
      class="btn btn-ghost btn-sm btn-square text-base-content/60 hover:bg-base-300/50 hover:text-success transition-transform"
      title="Skip to next curated song"
      aria-label="Skip to next curated song"
    >
      <Icon name="ph:skip-forward-bold" class="size-4" />
    </button>

    <a
      data-spotify-open-link
      href={defaultTrack.songUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-ghost btn-sm btn-square text-base-content/60 hover:bg-base-300/50 hover:text-success transition-colors"
      title="Open in Spotify"
      aria-label="Open track in Spotify"
    >
      <Icon
        name="ph:arrow-up-right-bold"
        class="size-3.5 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
      />
    </a>
  </div>
</div>

<script>
  type SpotifyTrack = import('@utils/spotify.ts').SpotifyTrack;
  let tracksCache: readonly SpotifyTrack[] | null = null;
  const TRACK_STORAGE_KEY = 'sl_spotify_track_idx';

  function getStoredTrackIdx(): number {
    if (typeof sessionStorage === 'undefined') return 0;
    const stored = sessionStorage.getItem(TRACK_STORAGE_KEY);
    return stored ? Math.max(0, parseInt(stored, 10) || 0) : 0;
  }

  function setStoredTrackIdx(idx: number): void {
    if (typeof sessionStorage !== 'undefined') {
      sessionStorage.setItem(TRACK_STORAGE_KEY, String(idx));
    }
  }

  // Updates ALL Spotify widget instances across the document to prevent desync
  function updateAllSpotifyWidgets(track: SpotifyTrack): void {
    const widgets = document.querySelectorAll<HTMLElement>('[data-spotify-widget]');
    widgets.forEach((widget) => {
      const titleEl = widget.querySelector('[data-spotify-title]');
      const artistEl = widget.querySelector('[data-spotify-artist]');
      const tagEl = widget.querySelector('[data-spotify-tag]');
      const linkEl = widget.querySelector<HTMLAnchorElement>('[data-spotify-link]');
      const openLinkEl = widget.querySelector<HTMLAnchorElement>('[data-spotify-open-link]');

      if (titleEl) titleEl.textContent = track.title;
      if (artistEl) artistEl.textContent = track.artist;
      if (tagEl && track.albumTag) tagEl.textContent = track.albumTag;
      if (linkEl) {
        linkEl.href = track.songUrl;
        linkEl.title = `Listen to ${track.title} by ${track.artist} on Spotify`;
      }
      if (openLinkEl) openLinkEl.href = track.songUrl;
    });
  }

  let isSpotifyWidgetInitialized = false;
  if (!isSpotifyWidgetInitialized) {
    isSpotifyWidgetInitialized = true;

    document.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement | null)?.closest('[data-spotify-skip-btn]');
      if (!btn) return;

      e.preventDefault();
      e.stopPropagation();

      if (!tracksCache) {
        const { SPOTIFY_TRACKS } = await import('@utils/spotify.ts');
        tracksCache = SPOTIFY_TRACKS;
      }

      const nextIdx = (getStoredTrackIdx() + 1) % tracksCache.length;
      setStoredTrackIdx(nextIdx);

      const nextTrack = tracksCache[nextIdx];
      if (nextTrack) {
        updateAllSpotifyWidgets(nextTrack);
      }

      // Haptic sound feedback if sound effects enabled
      if (localStorage.getItem('sl_sound_effects') === 'enabled') {
        const { audioEngine } = await import('@utils/audioEngine.ts');
        audioEngine.playClick('soft');
      }
    });
  }

  // Sync state on page load from sessionStorage
  document.addEventListener('astro:page-load', async () => {
    const idx = getStoredTrackIdx();
    if (idx > 0) {
      if (!tracksCache) {
        const { SPOTIFY_TRACKS } = await import('@utils/spotify.ts');
        tracksCache = SPOTIFY_TRACKS;
      }
      const track = tracksCache[idx % tracksCache.length];
      if (track) updateAllSpotifyWidgets(track);
    }
  });
</script>
