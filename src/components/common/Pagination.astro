---
import type { Page } from 'astro';
import { Icon } from 'astro-icon/components';
import { cn } from '@utils/cn.ts';

export interface Props {
  page: Page<unknown>;
  baseUrl?: string;
}

const { page } = Astro.props;

// If there's only 1 page or fewer, do not render pagination controls
if (page.lastPage <= 1) {
  return;
}

const { currentPage, lastPage } = page;

// Build range of page numbers to show
const pages = Array.from({ length: lastPage }, (_, i) => i + 1);

// Helper to calculate target URL
function getPageUrl(pageNum: number): string {
  if (pageNum === 1) {
    // Return base route with trailing slash (e.g., /blog/)
    const currentUrl = page.url.current;
    // Strip trailing page number if present (e.g. /blog/2/ -> /blog/)
    const cleanUrl = currentUrl.replace(/\/\d+\/?$/, '/');
    return cleanUrl.endsWith('/') ? cleanUrl : `${cleanUrl}/`;
  }
  const currentUrl = page.url.current;
  const base = currentUrl.replace(/\/\d+\/?$/, '').replace(/\/$/, '');
  return `${base}/${pageNum}/`;
}
---

<nav
  aria-label="Pagination Navigation"
  class="border-base-300 flex flex-wrap items-center justify-between gap-3 border-t pt-8 font-mono text-xs"
>
  <!-- Previous Button -->
  <div class="order-1">
    {page.url.prev ? (
      <a
        href={page.url.prev.endsWith('/') ? page.url.prev : `${page.url.prev}/`}
        class="btn btn-outline btn-sm gap-1.5 rounded-md border-base-300 px-3.5 text-base-content hover:bg-base-200"
        rel="prev"
      >
        <Icon name="ph:arrow-left-bold" class="h-3.5 w-3.5" />
        <span>Previous</span>
      </a>
    ) : (
      <button
        disabled
        class="btn btn-sm btn-outline border-base-300/40 text-base-content/30 cursor-not-allowed rounded-md px-3.5 opacity-40"
        aria-disabled="true"
      >
        <Icon name="ph:arrow-left-bold" class="h-3.5 w-3.5" />
        <span>Previous</span>
      </button>
    )}
  </div>

  <!-- Page Numbers -->
  <div class="order-3 flex w-full justify-center items-center gap-1 sm:order-2 sm:w-auto">
    {pages.map((num) => {
      const isCurrent = num === currentPage;
      const url = getPageUrl(num);
      return (
        <a
          href={url}
          class:list={cn(
            'btn btn-sm btn-square text-xs font-medium transition-colors',
            isCurrent
              ? 'btn-active bg-base-content text-base-100 hover:text-base-100 hover:bg-base-content/90 border-0 font-bold'
              : 'btn-ghost text-base-content/70 hover:bg-base-200 hover:text-base-content'
          )}
          aria-current={isCurrent ? 'page' : undefined}
          aria-label={`Go to page ${num}`}
        >
          {num}
        </a>
      );
    })}
  </div>

  <!-- Next Button -->
  <div class="order-2 sm:order-3">
    {page.url.next ? (
      <a
        href={page.url.next.endsWith('/') ? page.url.next : `${page.url.next}/`}
        class="btn btn-outline btn-sm gap-1.5 rounded-md border-base-300 px-3.5 text-base-content hover:bg-base-200"
        rel="next"
      >
        <span>Next</span>
        <Icon name="ph:arrow-right-bold" class="h-3.5 w-3.5" />
      </a>
    ) : (
      <button
        disabled
        class="btn btn-sm btn-outline border-base-300/40 text-base-content/30 cursor-not-allowed rounded-md px-3.5 opacity-40"
        aria-disabled="true"
      >
        <span>Next</span>
        <Icon name="ph:arrow-right-bold" class="h-3.5 w-3.5" />
      </button>
    )}
  </div>
</nav>
