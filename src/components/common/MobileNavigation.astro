---
import { SITE } from '@const/site.ts';
import { navigationCopy } from '@copy/navigation.ts';
import { Icon } from 'astro-icon/components';
import { cn } from '@utils/cn.ts';

const currentPath = Astro.url.pathname;
function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}

const primaryNavHrefs = new Set<string>(SITE.nav.map((item) => item.href));
const extraLinks = navigationCopy.footerNav.filter((item) => !primaryNavHrefs.has(item.href));
---

<div id="mobile-drawer" class="fixed inset-0 z-50 hidden md:hidden">
  <!-- Backdrop -->
  <div
    id="mobile-drawer-backdrop"
    class="fixed inset-0 bg-black/60 backdrop-blur-xs transition-opacity"
  >
  </div>

  <!-- Drawer Panel -->
  <div
    class="bg-base-100 border-base-300 fixed inset-y-0 right-0 flex w-full max-w-xs flex-col justify-between overflow-y-auto border-l p-6 shadow-2xl"
  >
    <div class="space-y-6">
      <div class="border-base-300 flex items-center justify-between border-b pb-4">
        <span class="text-accent font-mono text-sm font-bold">{SITE.name}</span>
        <button
          id="mobile-menu-close"
          type="button"
          aria-label="Close mobile menu"
          class="btn btn-ghost btn-sm btn-square rounded-md"
        >
          <Icon name="ph:x-bold" class="h-5 w-5" />
        </button>
      </div>

      <!-- Quick Command Palette Button -->
      <button
        type="button"
        data-open-palette
        class="border-base-300 bg-base-200/80 text-base-content/70 flex w-full items-center justify-between rounded-lg border px-3.5 py-2.5 font-mono text-xs"
      >
        <span class="flex items-center gap-2">
          <Icon name="ph:magnifying-glass-bold" class="text-accent h-4 w-4" />
          Search everything...
        </span>
        <kbd class="border-base-300 bg-base-100 rounded border px-1.5 py-0.5 font-mono text-xs">
          ⌘K
        </kbd>
      </button>

      <!-- Primary Nav -->
      <nav class="flex flex-col gap-1">
        {
          SITE.nav.map((item) => {
            const active = isActive(item.href);
            return (
              <a
                href={item.href}
                class={cn(
                  'flex items-center justify-between rounded-lg px-4 py-2.5 text-sm font-medium transition-colors',
                  active
                    ? 'bg-base-200 text-base-content border-accent border-l-2 font-semibold'
                    : 'text-base-content/70 hover:bg-base-200/60 hover:text-base-content'
                )}
              >
                <span>{item.label}</span>
                {active && <span class="text-accent text-xs">●</span>}
              </a>
            );
          })
        }
      </nav>

      <!-- Secondary Links -->
      <div class="border-base-300 space-y-1 border-t pt-4">
        <span
          class="text-base-content/50 block px-4 font-mono text-xs font-medium tracking-wider uppercase"
        >
          Extended
        </span>
        {
          extraLinks.map((item) => {
            const active = isActive(item.href);
            return (
              <a
                href={item.href}
                class={cn(
                  'flex items-center justify-between rounded-lg px-4 py-2 font-mono text-xs transition-colors',
                  active
                    ? 'text-accent font-semibold'
                    : 'text-base-content/60 hover:text-base-content'
                )}
              >
                <span>{item.label}</span>
                {active && <span class="text-accent text-xs">●</span>}
              </a>
            );
          })
        }
      </div>
    </div>

    <!-- Mobile Drawer Footer with Socials -->
    <div class="border-base-300 mt-6 border-t pt-6">
      <div class="text-base-content/60 flex items-center justify-center gap-4">
        <a
          href={SITE.social.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="hover:text-base-content p-2"
        >
          <Icon name="ph:github-logo-bold" class="h-5 w-5" />
        </a>
        <a
          href={SITE.social.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="hover:text-base-content p-2"
        >
          <Icon name="ph:linkedin-logo-bold" class="h-5 w-5" />
        </a>
        <a
          href={SITE.social.twitter}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="X (Twitter)"
          class="hover:text-base-content p-2"
        >
          <Icon name="ph:x-logo-bold" class="h-5 w-5" />
        </a>
        <a
          href={SITE.social.facebook}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook"
          class="hover:text-base-content p-2"
        >
          <Icon name="ph:facebook-logo-bold" class="h-5 w-5" />
        </a>
        <a
          href={SITE.social.instagram}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
          class="hover:text-base-content p-2"
        >
          <Icon name="ph:instagram-logo-bold" class="h-5 w-5" />
        </a>
        <a href={SITE.social.email} aria-label="Email" class="hover:text-base-content p-2">
          <Icon name="ph:envelope-simple-bold" class="h-5 w-5" />
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  function closeMobileDrawer() {
    const drawer = document.getElementById('mobile-drawer');
    if (drawer) {
      drawer.classList.add('hidden');
    }
    document.body.style.overflow = '';
  }

  function openMobileDrawer() {
    const drawer = document.getElementById('mobile-drawer');
    if (drawer) {
      drawer.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }
  }

  const win = window as unknown as Record<string, unknown>;
  if (!win.__MOBILE_NAV_INIT__) {
    win.__MOBILE_NAV_INIT__ = true;

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;

      if (target.closest('#mobile-menu-open')) {
        e.preventDefault();
        openMobileDrawer();
        return;
      }

      if (
        target.closest('#mobile-menu-close') ||
        target.id === 'mobile-drawer-backdrop' ||
        target.closest('#mobile-drawer a')
      ) {
        closeMobileDrawer();
      }
    });

    document.addEventListener('astro:before-swap', closeMobileDrawer);
  }
</script>
