---
import { SITE } from '@const/site.ts';
import { navigationCopy } from '@copy/navigation.ts';
import { Icon } from 'astro-icon/components';
import { cn } from '@utils/cn.ts';

const currentPath = Astro.url.pathname;
function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}

const primaryNavHrefs = new Set<string>(SITE.nav.map((item) => item.href));
const hiddenFromNav = new Set(['/links/', '/now/']);
const extraLinks = navigationCopy.footerNav.filter(
  (item) => !primaryNavHrefs.has(item.href) && !hiddenFromNav.has(item.href)
);
---

<div
  id="mobile-drawer"
  role="dialog"
  aria-modal="true"
  aria-label="Mobile navigation"
  class="fixed inset-0 z-50 hidden lg:hidden"
>
  <!-- Backdrop -->
  <div
    id="mobile-drawer-backdrop"
    aria-hidden="true"
    class="fixed inset-0 bg-base-content/60 backdrop-blur-xs transition-opacity"
  ></div>

  <!-- Drawer Panel -->
  <div
    id="mobile-drawer-panel"
    class="safe-pt safe-pb fixed inset-y-0 right-0 flex w-full max-w-xs flex-col justify-between overflow-y-auto overscroll-contain border-l border-base-300 bg-base-100 p-6"
  >
    <div class="space-y-6">
      <div class="border-base-300 flex items-center justify-between border-b pb-4">
        <span class="font-display text-2xl italic leading-none tracking-tight text-base-content">
          {SITE.name}
        </span>
        <button
          id="mobile-menu-close"
          type="button"
          aria-label="Close mobile menu"
          class="btn btn-ghost btn-square size-11 rounded-md transition-transform"
        >
          <Icon name="ph:x-bold" class="size-5" />
        </button>
      </div>

      <!-- Primary Nav -->
      <nav aria-label="Mobile navigation" class="flex flex-col gap-1">
        {SITE.nav.map((item) => {
          const active = isActive(item.href);
          return (
            <a
              href={item.href}
              class:list={cn(
                'flex items-center justify-between rounded-md px-4 py-2.5 text-lg transition-colors',
                active
                  ? 'bg-base-200 text-base-content'
                  : 'text-secondary hover:bg-base-200 hover:text-base-content'
              )}
            >
              {item.label}
              {active && <span class="text-accent text-xs">●</span>}
            </a>
          );
        })}
      </nav>

      <!-- Secondary Links -->
      <div class="border-base-300 space-y-1 border-t pt-4">
        <span class="label-caps block px-4">Extended</span>
        {extraLinks.map((item) => {
          const active = isActive(item.href);
          return (
            <a
              href={item.href}
              class:list={cn(
                'flex items-center justify-between rounded-lg px-4 py-2 font-mono text-xs transition-colors',
                active
                  ? 'text-accent font-semibold'
                  : 'text-base-content/60 hover:text-base-content'
              )}
            >
              {item.label}
              {active && <span class="text-accent text-xs">●</span>}
            </a>
          );
        })}
      </div>
    </div>

    <!-- Mobile Drawer Footer with Socials -->
    <footer class="border-base-300 text-base-content/60 mt-6 flex flex-wrap items-center justify-center gap-2 border-t pt-6">
      <a
        href={SITE.social.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class="hover:text-base-content hover:bg-base-200 rounded-md p-2.5 transition-colors"
      >
        <Icon name="ph:github-logo-bold" class="size-5" />
      </a>
      <a
        href={SITE.social.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
        class="hover:text-base-content hover:bg-base-200 rounded-md p-2.5 transition-colors"
      >
        <Icon name="ph:linkedin-logo-bold" class="size-5" />
      </a>
      <a
        href={SITE.social.twitter}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="X (Twitter)"
        class="hover:text-base-content hover:bg-base-200 rounded-md p-2.5 transition-colors"
      >
        <Icon name="ph:x-logo-bold" class="size-5" />
      </a>
      <a
        href={SITE.social.facebook}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Facebook"
        class="hover:text-base-content hover:bg-base-200 rounded-md p-2.5 transition-colors"
      >
        <Icon name="ph:facebook-logo-bold" class="size-5" />
      </a>
      <a
        href={SITE.social.instagram}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram"
        class="hover:text-base-content hover:bg-base-200 rounded-md p-2.5 transition-colors"
      >
        <Icon name="ph:instagram-logo-bold" class="size-5" />
      </a>
      <a
        href={SITE.social.dailydev}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="daily.dev (5.4k+ reads)"
        class="hover:text-base-content hover:bg-base-200 rounded-md p-2.5 transition-colors"
      >
        <Icon name="ph:newspaper-clipping-bold" class="size-5" />
      </a>
      <a
        href={SITE.social.googleDev}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Google Developer Profile"
        class="hover:text-base-content hover:bg-base-200 rounded-md p-2.5 transition-colors"
      >
        <Icon name="ph:google-logo-bold" class="size-5" />
      </a>
      <a
        href={SITE.social.email}
        aria-label="Email"
        class="hover:text-base-content hover:bg-base-200 rounded-md p-2.5 transition-colors"
      >
        <Icon name="ph:envelope-simple-bold" class="size-5" />
      </a>
    </footer>
  </div>
</div>

<script>
  function closeMobileDrawer(): void {
    const drawer = document.getElementById('mobile-drawer');
    const trigger = document.getElementById('mobile-menu-open');
    if (drawer) {
      drawer.classList.add('hidden');
    }
    if (trigger) {
      trigger.setAttribute('aria-expanded', 'false');
    }
    document.body.style.overflow = '';
  }

  function openMobileDrawer(): void {
    const drawer = document.getElementById('mobile-drawer');
    const trigger = document.getElementById('mobile-menu-open');
    if (!drawer) return;

    drawer.classList.remove('hidden');
    if (trigger) {
      trigger.setAttribute('aria-expanded', 'true');
    }
    document.body.style.overflow = 'hidden';

    const panel = document.getElementById('mobile-drawer-panel');
    if (panel) {
      panel.classList.remove('animate-rise');
      requestAnimationFrame(() => {
        panel.classList.add('animate-rise');
      });
    }
  }

  let isMobileNavInitialized = false;
  if (!isMobileNavInitialized) {
    isMobileNavInitialized = true;

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;

      if (target.closest('#mobile-menu-open')) {
        e.preventDefault();
        openMobileDrawer();
        return;
      }

      if (
        target.closest('#mobile-menu-close') ||
        target.id === 'mobile-drawer-backdrop' ||
        target.closest('#mobile-drawer a')
      ) {
        closeMobileDrawer();
      }
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        const drawer = document.getElementById('mobile-drawer');
        if (drawer && !drawer.classList.contains('hidden')) {
          closeMobileDrawer();
        }
      }
    });

    document.addEventListener('astro:before-swap', closeMobileDrawer);
  }
</script>
