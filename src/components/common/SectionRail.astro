---
const sections = [
  { id: 'work', label: 'Work', index: '01' },
  { id: 'experience', label: 'Experience', index: '02' },
  { id: 'engineering', label: 'Engineering', index: '03' },
  { id: 'writing', label: 'Writing', index: '04' },
  { id: 'about', label: 'About', index: '05' },
];
---

<nav
  aria-label="Section index"
  class="section-rail animate-fade delay-400 fixed top-1/2 z-30 hidden -translate-y-1/2 wide:block"
>
  <ol class="flex flex-col gap-3">
    {sections.map((section) => (
      <li>
        <a
          href={`#${section.id}`}
          data-rail={section.id}
          class="group flex min-h-6 items-center gap-2 py-1 font-mono text-2xs text-secondary transition-colors duration-200 hover:text-base-content"
        >
          <span class="tabular-nums">{section.index}</span>
          <span class="rail-line h-px w-5 origin-left bg-current" aria-hidden="true" />
          <span class="rail-label sr-only xwide:not-sr-only xwide:opacity-60 xwide:transition-opacity xwide:duration-200 group-hover:xwide:opacity-100">
            {section.label}
          </span>
        </a>
      </li>
    ))}
  </ol>
</nav>

<style>
  .section-rail {
    left: max(1.25rem, env(safe-area-inset-left, 0px));
  }

  .rail-line {
    transform: scaleX(0.4);
    transition: transform 300ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .group:hover .rail-line {
    transform: scaleX(0.75);
  }

  :global(.rail-line[data-active]) {
    transform: scaleX(1);
  }
</style>

<script>
  const railSelector = '[data-rail]';
  let cachedRailLinks: HTMLAnchorElement[] = [];
  let railObserver: IntersectionObserver | null = null;
  let currentActiveId: string | null = null;

  function markRail(id: string | null): void {
    if (!id || id === currentActiveId) return;
    currentActiveId = id;

    cachedRailLinks.forEach((link) => {
      const active = link.dataset.rail === id;
      link.classList.toggle('text-accent', active);
      link.classList.toggle('text-secondary', !active);
      if (active) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');

      const line = link.querySelector('.rail-line');
      if (active) line?.setAttribute('data-active', '');
      else line?.removeAttribute('data-active');

      const label = link.querySelector('.rail-label');
      label?.classList.toggle('xwide:opacity-100', active);
      label?.classList.toggle('xwide:opacity-60', !active);
    });
  }

  function setupRail(): void {
    teardownRail();
    cachedRailLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>(railSelector));
    if (!cachedRailLinks.length) return;

    // Set initial default active rail to the first section without triggering reflow
    currentActiveId = null;
    markRail(cachedRailLinks[0]?.dataset.rail ?? null);

    if (!('IntersectionObserver' in window)) return;

    // Track active intersecting sections without forced reflows or scroll handlers
    const sectionTops = new Map<string, number>();

    railObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            // entry.boundingClientRect is a read-only snapshot provided by browser compositor
            sectionTops.set(entry.target.id, entry.boundingClientRect.top);
          } else {
            sectionTops.delete(entry.target.id);
          }
        }

        if (sectionTops.size === 0) {
          if (window.scrollY < 300) {
            markRail(cachedRailLinks[0]?.dataset.rail ?? null);
          }
          return;
        }

        // Active section is the furthest intersecting section down the document
        let activeId: string | null = null;
        for (const link of cachedRailLinks) {
          const id = link.dataset.rail;
          if (id && sectionTops.has(id)) {
            activeId = id;
          }
        }
        if (activeId) markRail(activeId);
      },
      {
        // Margin offsets for sticky navbar (96px) and active reading zone
        rootMargin: '-96px 0px -40% 0px',
        threshold: [0, 0.25, 0.5],
      }
    );

    for (const link of cachedRailLinks) {
      const id = link.dataset.rail;
      if (!id) continue;
      const section = document.getElementById(id);
      if (section) railObserver.observe(section);
    }
  }

  function teardownRail(): void {
    if (railObserver) {
      railObserver.disconnect();
      railObserver = null;
    }
    cachedRailLinks = [];
    currentActiveId = null;
  }

  document.addEventListener('astro:page-load', setupRail);
  document.addEventListener('astro:before-swap', teardownRail);
</script>
