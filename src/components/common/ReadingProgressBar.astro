<div
  id="reading-progress-bar"
  class="bg-accent fixed top-0 right-0 left-0 z-50 h-0.5 origin-left scale-x-0 transform transition-transform duration-75"
  aria-hidden="true"
></div>

<script>
  type LenisWindow = Window & { lenis?: import('lenis').default };

  const updateProgress = () => {
    const bar = document.getElementById('reading-progress-bar');
    if (!bar) return;

    const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
    if (totalHeight <= 0) {
      bar.style.transform = 'scaleX(0)';
      return;
    }
    const win = window as unknown as LenisWindow;
    const currentScroll = win.lenis ? win.lenis.scroll : window.scrollY;
    const progress = Math.min(1, Math.max(0, currentScroll / totalHeight));
    bar.style.transform = `scaleX(${progress})`;
  };

  window.addEventListener('scroll', updateProgress, { passive: true });

  document.addEventListener('astro:page-load', () => {
    updateProgress();
    const win = window as unknown as LenisWindow;
    if (win.lenis) {
      win.lenis.on('scroll', updateProgress);
    }
  });
</script>
