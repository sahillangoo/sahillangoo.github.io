---
import { SITE } from '@const/site.ts';
import { homeCopy } from '@copy/home.ts';
import { navigationCopy } from '@copy/navigation.ts';
import SpotifyWidget from '@components/common/SpotifyWidget.astro';
import { Icon } from 'astro-icon/components';

const currentYear = new Date().getFullYear();

const socials = [
  { label: 'GitHub', href: SITE.social.github, icon: 'ph:github-logo-bold' },
  { label: 'LinkedIn', href: SITE.social.linkedin, icon: 'ph:linkedin-logo-bold' },
  { label: 'X', href: SITE.social.twitter, icon: 'ph:x-logo-bold' },
  { label: 'Facebook', href: SITE.social.facebook, icon: 'ph:facebook-logo-bold' },
  { label: 'Instagram', href: SITE.social.instagram, icon: 'ph:instagram-logo-bold' },
  { label: 'daily.dev', href: SITE.social.dailydev, icon: 'ph:newspaper-clipping-bold' },
  { label: 'Google', href: SITE.social.googleDev, icon: 'ph:google-logo-bold' },
];

const pipeLinks = [
  ...navigationCopy.footerSections.navigation.links,
  ...navigationCopy.footerSections.system.links,
  { label: 'RSS', href: '/rss.xml' },
];

const linkClass =
  'text-sm text-secondary transition-colors duration-150 ease-out hover:text-base-content';
---

<footer id="site-footer" class="border-t border-base-300 text-secondary">
  <div class="page-container flex flex-col gap-8 py-16 md:gap-10 md:py-20">
    <div>
      <a
        href="/"
        class="font-display w-fit text-3xl font-medium italic leading-none tracking-tight text-base-content transition-colors duration-150 ease-out hover:text-accent sm:text-4xl"
      >
        {navigationCopy.brand.name}
      </a>
      <p class="font-display mt-3 text-base italic text-base-content sm:text-lg">
        {homeCopy.hero.imageQuote}
      </p>
    </div>

    <div class="border-t border-base-300 pt-8">
      <p class="label-caps">{navigationCopy.footerSections.connect.title}</p>
      <SpotifyWidget variant="compact" class="mt-4 w-full sm:w-auto" />
      <ul class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2">
        {socials.map((item) => (
          <li>
            <a
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              class:list={['inline-flex items-center gap-2 active:scale-98', linkClass]}
            >
              <Icon name={item.icon} class="size-3.5 shrink-0" aria-hidden="true" />
              {item.label}
            </a>
          </li>
        ))}
        <li>
          <Fragment set:html="<!--email_off-->" />
          <a
            href={SITE.social.email}
            class:list={['inline-flex items-center gap-2 active:scale-98', linkClass]}
          >
            <Icon name="ph:envelope-simple-bold" class="size-3.5 shrink-0" aria-hidden="true" />
            Email
          </a>
          <Fragment set:html="<!--/email_off-->" />
        </li>
      </ul>
    </div>

    <nav class="border-t border-base-300 pt-8" aria-label="Footer">
      <p class="label-caps">
        {navigationCopy.footerSections.navigation.title}&
        {navigationCopy.footerSections.system.title}
      </p>
      <ul class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2">
        {pipeLinks.map((item, index) => (
          <li class="flex items-center gap-3">
            {index > 0 && (
              <span aria-hidden="true" class="text-neutral">
                |
              </span>
            )}
            <a href={item.href} class:list={linkClass}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="border-t border-base-300 pt-6">
      <span class="meta">{navigationCopy.footerTelemetry.copyright(currentYear)}</span>
    </div>
  </div>
</footer>
