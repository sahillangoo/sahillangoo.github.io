---
import { Icon } from 'astro-icon/components';

const options = [
  { value: 'editorialLight', label: 'Light theme', icon: 'ph:sun' },
  { value: 'editorialDark', label: 'Dark theme', icon: 'ph:moon' },
  { value: 'system', label: 'System theme', icon: 'ph:monitor' },
] as const;
---

<div
  role="group"
  aria-label="Color theme"
  class="relative inline-flex items-center rounded-full border border-base-300 bg-elevated p-0.5"
>
  <span
    id="theme-indicator"
    aria-hidden="true"
    class="absolute top-0.5 left-0.5 size-7 translate-x-7 rounded-full border border-base-300 bg-base-200 transition-transform duration-200 ease-editorial"
  ></span>
  {options.map((option) => (
    <button
      type="button"
      data-theme-choice={option.value}
      title={option.label}
      aria-pressed="false"
      class="relative z-10 grid size-7 place-items-center rounded-full text-secondary transition-colors duration-150 hover:text-base-content"
    >
      <Icon name={option.icon} class="size-3.5" aria-hidden="true" />
      <span class="sr-only">{option.label}</span>
    </button>
  ))}
</div>

<script>
  type ThemePreference = 'editorialLight' | 'editorialDark' | 'system';
  type ResolvedTheme = 'editorialLight' | 'editorialDark';

  const positions: Record<ThemePreference, string> = {
    editorialLight: 'translate-x-0',
    editorialDark: 'translate-x-7',
    system: 'translate-x-14',
  };

  let isThemeToggleBound = false;

  function readPreference(): ThemePreference {
    try {
      const saved = localStorage.getItem('theme');
      if (saved === 'editorialLight' || saved === 'light') return 'editorialLight';
      if (saved === 'editorialDark' || saved === 'dark') return 'editorialDark';
      if (saved === 'system') return 'system';
    } catch {
      // LocalStorage access may be restricted
    }
    return 'system';
  }

  function resolveTheme(preference: ThemePreference): ResolvedTheme {
    if (preference === 'editorialLight' || preference === 'editorialDark') return preference;
    return window.matchMedia('(prefers-color-scheme: dark)').matches
      ? 'editorialDark'
      : 'editorialLight';
  }

  function paintTheme(theme: ResolvedTheme): void {
    document.documentElement.setAttribute('data-theme', theme);
  }

  function syncThemeControl(): void {
    const preference = readPreference();
    const indicator = document.getElementById('theme-indicator');
    if (indicator) {
      indicator.classList.remove('translate-x-0', 'translate-x-7', 'translate-x-14');
      indicator.classList.add(positions[preference]);
    }

    document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]').forEach((button) => {
      const active = button.dataset.themeChoice === preference;
      button.setAttribute('aria-pressed', active ? 'true' : 'false');
      button.classList.toggle('text-base-content', active);
      button.classList.toggle('text-secondary', !active);
    });
  }

  function setPreference(preference: ThemePreference): void {
    try {
      localStorage.setItem('theme', preference);
    } catch {
      // LocalStorage access may be restricted
    }
    paintTheme(resolveTheme(preference));
    syncThemeControl();
  }

  function setupThemeToggle(): void {
    syncThemeControl();
    if (isThemeToggleBound) return;
    isThemeToggleBound = true;

    document.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement | null)?.closest<HTMLButtonElement>(
        '[data-theme-choice]'
      );
      const choice = button?.dataset.themeChoice;
      if (choice === 'editorialLight' || choice === 'editorialDark' || choice === 'system') {
        setPreference(choice);
      }
    });

    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
      if (readPreference() !== 'system') return;
      paintTheme(resolveTheme('system'));
    });
  }

  document.addEventListener('astro:page-load', setupThemeToggle);
  document.addEventListener('astro:after-swap', syncThemeControl);
</script>
