---
import { Icon } from 'astro-icon/components';
import { cn } from '@utils/cn.ts';

export interface Props {
  variant?: 'compact' | 'full';
  showWeather?: boolean;
  class?: string;
}

const { variant = 'compact', showWeather = true, class: className = '' } = Astro.props;
---

<div
  class={cn(
    'inline-flex flex-wrap items-center gap-2.5 font-mono text-xs',
    variant === 'full' && 'rounded-xl border border-base-300 bg-base-200 p-4 sm:p-5',
    className
  )}
>
  <div class="flex items-center gap-2">
    <span class="relative flex h-2 w-2">
      <span
        class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"
      >
      </span>
      <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
    </span>
    <span class="text-base-content/80 font-medium">Kashmir, India</span>
  </div>

  {
    showWeather && (
      <>
        <span class="text-base-content/30">•</span>
        <div
          id="live-weather-badge"
          class="text-base-content/70 flex items-center gap-1.5 transition-opacity duration-300"
        >
          <Icon id="weather-icon-sun" name="ph:sun-bold" class="h-3.5 w-3.5 text-amber-400" />
          <span id="weather-temp-text" class="font-medium tabular-nums">
            --°C
          </span>
          <span id="weather-desc-text" class="text-base-content/50 hidden text-xs sm:inline">
            Loading...
          </span>
        </div>
      </>
    )
  }

  <span class="text-base-content/30">•</span>

  <div class="text-base-content/70 flex items-center gap-1.5">
    <Icon name="ph:clock-bold" class="text-accent h-3.5 w-3.5" />
    <span id="kashmir-live-clock" class="font-mono font-medium tabular-nums">--:--:-- IST</span>
  </div>

  {
    variant === 'full' && (
      <div class="ml-auto hidden rounded-full border border-emerald-800/40 bg-emerald-950/40 px-2.5 py-0.5 font-mono text-xs font-medium text-emerald-400 sm:block">
        Open to Select Projects
      </div>
    )
  }
</div>

<script>
  let clockInterval: ReturnType<typeof setInterval> | null = null;

  function updateKashmirClock() {
    const clockEl = document.getElementById('kashmir-live-clock');
    if (!clockEl) return;

    try {
      const now = new Date();
      const options: Intl.DateTimeFormatOptions = {
        timeZone: 'Asia/Kolkata',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hour12: true,
      };
      const formatter = new Intl.DateTimeFormat('en-US', options);
      clockEl.textContent = `${formatter.format(now)} IST`;
    } catch {
      // Fallback
    }
  }

  async function updateWeatherTelemetry() {
    const tempEl = document.getElementById('weather-temp-text');
    const descEl = document.getElementById('weather-desc-text');
    if (!tempEl) return;

    try {
      const { fetchLiveWeather } = await import('@utils/weather.ts');
      const weather = await fetchLiveWeather();
      if (weather) {
        tempEl.textContent = `${weather.temp}°C`;
        if (descEl) descEl.textContent = weather.description;
        return;
      }
    } catch {
      // Fallback below
    }

    tempEl.textContent = '22°C';
    if (descEl) descEl.textContent = 'Clear';
  }

  function setupWidgets() {
    if (clockInterval) {
      clearInterval(clockInterval);
      clockInterval = null;
    }
    updateKashmirClock();
    clockInterval = setInterval(updateKashmirClock, 1000);
    updateWeatherTelemetry();
  }

  document.addEventListener('astro:page-load', setupWidgets);
  document.addEventListener('astro:before-swap', () => {
    if (clockInterval) {
      clearInterval(clockInterval);
      clockInterval = null;
    }
  });
</script>
