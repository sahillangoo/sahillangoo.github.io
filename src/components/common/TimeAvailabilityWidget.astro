---
import { Icon } from 'astro-icon/components';
import { cn } from '@utils/cn.ts';

export interface Props {
  variant?: 'compact' | 'full';
  showWeather?: boolean;
  class?: string;
}

const { variant = 'compact', showWeather = true, class: className = '' } = Astro.props;

// Build-time initial fallback timestamp in IST
const initialTime = new Intl.DateTimeFormat('en-US', {
  timeZone: 'Asia/Kolkata',
  hour: '2-digit',
  minute: '2-digit',
  second: '2-digit',
  hour12: true,
}).format(new Date());
---

<div
  class:list={cn(
    'inline-flex flex-wrap items-center gap-2.5 font-mono text-xs',
    variant === 'full' && 'border-base-300 bg-base-200 rounded-md border p-4 sm:p-5',
    className
  )}
>
  <div class="flex items-center gap-1.5">
    <Icon name="ph:map-pin-bold" class="text-accent h-3.5 w-3.5 shrink-0" />
    <span class="text-base-content/80 font-medium">Kashmir, India</span>
  </div>

  {showWeather && (
    <>
      <span class="text-base-content/30">•</span>
      <div class="live-weather-badge text-base-content/70 flex items-center gap-1.5 transition-opacity duration-300">
        <Icon name="ph:sun-bold" class="text-warning h-3.5 w-3.5" />
        <span class="weather-temp-text font-medium tabular-nums">18°C</span>
        <span class="weather-desc-text text-base-content/50 hidden text-xs sm:inline">Clear</span>
      </div>
    </>
  )}

  <span class="text-base-content/30">•</span>

  <div class="text-base-content/70 flex items-center gap-1.5">
    <Icon name="ph:clock-bold" class="text-accent h-3.5 w-3.5" />
    <span class="kashmir-live-clock font-mono font-medium tabular-nums">
      {`${initialTime} IST`}
    </span>
  </div>

  {variant === 'full' && (
    <div class="badge badge-sm badge-soft badge-success ml-auto hidden font-mono font-medium sm:inline-flex">
      Open to Select Projects
    </div>
  )}
</div>

<script>
  // Module-level singleton Intl formatter: completely avoids garbage-collection churn on every tick
  const IST_CLOCK_FORMATTER = new Intl.DateTimeFormat('en-US', {
    timeZone: 'Asia/Kolkata',
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
    hour12: true,
  });

  let clockInterval: ReturnType<typeof setInterval> | null = null;

  function updateKashmirClock(): void {
    const clockNodes = document.querySelectorAll<HTMLElement>('.kashmir-live-clock');
    if (clockNodes.length === 0) {
      // Auto-terminate timer if widget is unmounted from DOM
      stopClock();
      return;
    }

    try {
      const formatted = `${IST_CLOCK_FORMATTER.format(new Date())} IST`;
      clockNodes.forEach((node) => {
        node.textContent = formatted;
      });
    } catch {
      // Fallback
    }
  }

  function startClock(): void {
    stopClock();
    updateKashmirClock();
    if (!document.hidden) {
      clockInterval = setInterval(updateKashmirClock, 1000);
    }
  }

  function stopClock(): void {
    if (clockInterval) {
      clearInterval(clockInterval);
      clockInterval = null;
    }
  }

  async function updateWeatherTelemetry(): Promise<void> {
    const tempNodes = document.querySelectorAll<HTMLElement>('.weather-temp-text');
    const descNodes = document.querySelectorAll<HTMLElement>('.weather-desc-text');
    if (!tempNodes.length) return;

    try {
      const { fetchLiveWeather } = await import('@utils/weather.ts');
      const weather = await fetchLiveWeather();
      if (weather) {
        tempNodes.forEach((node) => {
          node.textContent = `${weather.temp}°C`;
        });
        descNodes.forEach((node) => {
          node.textContent = weather.description;
        });
      }
    } catch {
      // Preserve existing server-rendered fallback
    }
  }

  function setupWidgets(): void {
    startClock();
    updateWeatherTelemetry();
  }

  // Handle background tab power saving
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      stopClock();
    } else {
      startClock();
    }
  });

  // Lifecycle registration
  document.addEventListener('astro:page-load', setupWidgets);
  document.addEventListener('astro:before-preparation', stopClock);
  document.addEventListener('astro:before-swap', stopClock);
  window.addEventListener('pagehide', stopClock);
</script>
