---
import { SITE } from '@const/site.ts';
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';
import { formatIsoDateTime } from '@utils/date.ts';

export interface BreadcrumbItem {
  name: string;
  item: string;
}

export interface Props {
  title?: string;
  description?: string;
  keywords?: string | string[];
  image?: string;
  imageWidth?: number | string;
  imageHeight?: number | string;
  imageType?: string;
  imageAlt?: string;
  canonicalUrl?: string;
  type?: 'website' | 'article' | 'profile';
  publishDate?: string;
  updatedDate?: string;
  articleSection?: string;
  articleTags?: string[];
  breadcrumbs?: BreadcrumbItem[];
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
  noindex?: boolean;
}

const {
  title = SITE.title,
  description = SITE.description,
  keywords,
  image = '/og/default.png',
  imageWidth,
  imageHeight,
  imageType,
  imageAlt,
  canonicalUrl = Astro.url.href,
  type = 'website',
  publishDate,
  updatedDate,
  articleSection,
  articleTags,
  breadcrumbs,
  structuredData,
  noindex = false,
} = Astro.props;

// Format keywords with default fallback
const formattedKeywords = Array.isArray(keywords)
  ? keywords.join(', ')
  : keywords ||
    'Sahil Langoo, Full Stack Engineer, Systems Architect, Astro 7.3, TypeScript, Cloudflare Workers, Hono, Web Performance, SquadCoders, Distributed Edge Systems';

// Ensure trailing slash consistency for canonical URLs (unless file with extension)
const formattedCanonical =
  canonicalUrl.endsWith('/') || canonicalUrl.includes('.') ? canonicalUrl : `${canonicalUrl}/`;

const formattedTitle =
  title === SITE.title || title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;

const siteUrl = SITE.url;
const ogImage = image.startsWith('http')
  ? image
  : `${siteUrl}${image.startsWith('/') ? '' : '/'}${image}`;
const ogImageSecure = ogImage.startsWith('https://')
  ? ogImage
  : ogImage.replace(/^http:\/\//, 'https://');

// Determine image MIME type dynamically if not explicitly specified
let computedImageType = imageType;
if (!computedImageType) {
  const cleanImg = (ogImage.split('?')[0] ?? '').toLowerCase();
  if (cleanImg.endsWith('.webp')) computedImageType = 'image/webp';
  else if (cleanImg.endsWith('.jpg') || cleanImg.endsWith('.jpeg'))
    computedImageType = 'image/jpeg';
  else if (cleanImg.endsWith('.svg')) computedImageType = 'image/svg+xml';
  else if (cleanImg.endsWith('.gif')) computedImageType = 'image/gif';
  else computedImageType = 'image/png';
}

const computedWidth = imageWidth ? String(imageWidth) : '1200';
const computedHeight = imageHeight ? String(imageHeight) : '630';
const computedAlt = imageAlt || formattedTitle;
const ogLogoUrl = `${siteUrl}/icon-512.png`;
const cleanPath = Astro.url.pathname.replace(/\/$/, '');
const knownStaticMd = new Set([
  '/services',
  '/about',
  '/resume',
  '/now',
  '/uses',
  '/colophon',
  '/privacy',
]);
const isContentItem =
  (/^\/(?:blog|projects)\/(?!\d+$)[^/]+$/.test(cleanPath) &&
    !cleanPath.startsWith('/blog/category') &&
    !cleanPath.startsWith('/blog/tag')) ||
  knownStaticMd.has(cleanPath);
const markdownUrl = isContentItem ? `${cleanPath}.md` : null;

// Core Static Schemas
const organizationSchema = {
  '@type': 'Organization',
  '@id': `${siteUrl}/#organization`,
  name: 'SquadCoders',
  url: 'https://github.com/SquadCoders',
  logo: {
    '@type': 'ImageObject',
    url: ogLogoUrl,
    width: 512,
    height: 512,
  },
  sameAs: [
    'https://github.com/SquadCoders',
    SITE.social.github,
    SITE.social.linkedin,
    SITE.social.twitter,
  ],
};

const personSchema = {
  '@type': 'Person',
  '@id': `${siteUrl}/#person`,
  name: SITE.name,
  url: SITE.url,
  image: `${siteUrl}/og/default.png`,
  jobTitle: 'Full Stack Systems Engineer & Co-Founder',
  worksFor: {
    '@type': 'Organization',
    '@id': `${siteUrl}/#organization`,
    name: 'SquadCoders',
    url: 'https://github.com/SquadCoders',
  },
  hasOccupation: {
    '@type': 'Occupation',
    name: 'Full Stack Systems Engineer & Systems Architect',
    description:
      'Designing high-performance web systems, distributed edge proxies on Cloudflare Workers, and minimalist UI craft.',
  },
  alumniOf: {
    '@type': 'EducationalOrganization',
    name: 'University of Kashmir',
  },
  sameAs: [
    SITE.social.github,
    SITE.social.linkedin,
    SITE.social.twitter,
    SITE.social.facebook,
    SITE.social.instagram,
    SITE.social.devto,
    SITE.social.dailydev,
    SITE.social.googleDev,
  ],
  knowsAbout: [
    'TypeScript',
    'Go (Golang)',
    'Astro',
    'Next.js',
    'React',
    'Cloudflare Workers',
    'Meta Conversions API (CAPI)',
    'Cloudflare Turnstile',
    'Partytown',
    'Tailwind CSS',
    'daisyUI',
    'Bun',
    'Web Performance',
    'Distributed Systems',
    'Microservices',
    'gRPC',
    'SQLite',
    'AI Coding Agents',
    'Zod Type Safety',
    'Technical SEO & Schema.org',
    'Generative Engine Optimization (GEO)',
    'Answer Engine Optimization (AEO)',
    'Cloudflare Pages & Edge Functions',
  ],
  knowsLanguage: ['en', 'ks', 'ur', 'hi'],
  contactPoint: {
    '@type': 'ContactPoint',
    email: SITE.email,
    contactType: 'technical consulting',
  },
};

const webSiteSchema = {
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  publisher: {
    '@id': `${siteUrl}/#organization`,
  },
  inLanguage: 'en-US',
};

// Breadcrumb Schema
const breadcrumbSchema =
  breadcrumbs && breadcrumbs.length > 0
    ? {
        '@type': 'BreadcrumbList',
        '@id': `${formattedCanonical}#breadcrumb`,
        name: 'Breadcrumbs',
        itemListElement: breadcrumbs.map((crumb, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: crumb.name,
          item: crumb.item.startsWith('http')
            ? crumb.item
            : `${siteUrl}${crumb.item.startsWith('/') ? '' : '/'}${crumb.item}`,
        })),
      }
    : null;

// Defensively normalize nested dates in structuredData to ISO 8601 with UTC timezone
function normalizeSchemaDates(node: unknown): unknown {
  if (!node || typeof node !== 'object') return node;
  if (Array.isArray(node)) {
    return node.map(normalizeSchemaDates);
  }
  const obj = { ...(node as Record<string, unknown>) };
  if (typeof obj.datePublished === 'string') {
    obj.datePublished = formatIsoDateTime(obj.datePublished);
  }
  if (typeof obj.dateModified === 'string') {
    obj.dateModified = formatIsoDateTime(obj.dateModified);
  }
  if (Array.isArray(obj.blogPost)) {
    obj.blogPost = obj.blogPost.map(normalizeSchemaDates);
  }
  return obj;
}

const rawStructuredData = Array.isArray(structuredData)
  ? structuredData
  : structuredData
    ? [structuredData]
    : [];
const normalizedStructuredData = rawStructuredData.map(normalizeSchemaDates);

// Graph aggregation
const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    organizationSchema,
    personSchema,
    webSiteSchema,
    ...(breadcrumbSchema ? [breadcrumbSchema] : []),
    ...normalizedStructuredData,
  ],
};

// Safe JSON-LD script serialization (prevents HTML breakout)
const safeJsonLdString = JSON.stringify(schemaGraph).replace(/</g, '\\u003c');
---

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="canonical" href={formattedCanonical} />

  <!-- Critical Above-the-Fold Self-hosted Font Preloads -->
  <Font cssVariable="--ff-display" preload={[{ weight: 400, style: 'normal' }]} />
  <Font cssVariable="--ff-sans" preload={[{ weight: 400, style: 'normal' }]} />

  <!-- RSS Feed Autodiscovery -->
  <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />

  <!-- AI LLM Discovery per llmstxt.org v2 standard & Google OKF v0.1 -->
  <link rel="describedby" href="/llms.txt" />
  <link
    rel="related"
    type="text/markdown"
    title="Open Knowledge Format Bundle"
    href="/okf/index.md"
  />
  <link
    rel="describedby"
    type="application/json"
    title="Agent Capabilities"
    href="/.well-known/agent.json"
  />
  {markdownUrl ? (
    <link rel="alternate" type="text/markdown" title={`${title} (Markdown)`} href={markdownUrl} />
  ) : (
    <link rel="alternate" type="text/markdown" title="LLM Knowledge Base" href="/llms.txt" />
  )}
  <meta name="generator" content={Astro.generator} />

  {noindex ? (
    <meta
      name="robots"
      content="noindex, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
    />
  ) : (
    <meta
      name="robots"
      content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
    />
  )}

  <!-- Duplicate Content & Crawler Shield for Preview / Secondary Subdomains -->
  <script is:inline>
    (() => {
      const h = window.location.hostname;
      if (h !== 'sahillangoo.in' && h !== 'localhost' && h !== '127.0.0.1') {
        const meta = document.createElement('meta');
        meta.name = 'robots';
        meta.content = 'noindex, nofollow, noarchive';
        document.head.appendChild(meta);
      }
    })();
  </script>
  <!-- Astro View Transitions Router -->
  <ClientRouter />

  <!-- Primary Meta Tags -->
  <title>{formattedTitle}</title>
  <meta name="title" content={formattedTitle} />
  <meta name="description" content={description} />
  <meta name="keywords" content={formattedKeywords} />
  <meta name="author" content={SITE.author} />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content={type} />
  <meta property="og:url" content={formattedCanonical} />
  <meta property="og:title" content={formattedTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:secure_url" content={ogImageSecure} />
  <meta property="og:image:width" content={computedWidth} />
  <meta property="og:image:height" content={computedHeight} />
  <meta property="og:image:alt" content={computedAlt} />
  <meta property="og:image:type" content={computedImageType} />
  <meta property="og:logo" content={ogLogoUrl} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:locale" content="en_US" />
  {type === 'article' && publishDate && (
    <meta property="article:published_time" content={formatIsoDateTime(publishDate)} />
  )}
  {type === 'article' && updatedDate && (
    <meta property="article:modified_time" content={formatIsoDateTime(updatedDate)} />
  )}
  {type === 'article' && <meta property="article:author" content={`${siteUrl}/about/`} />}
  {type === 'article' && articleSection && (
    <meta property="article:section" content={articleSection} />
  )}
  {type === 'article' &&
    articleTags &&
    articleTags.map((tag) => <meta property="article:tag" content={tag} />)}
  {type === 'article' && <meta property="article:publisher" content={`${siteUrl}/#organization`} />}

  <!-- Twitter / X Cards -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@kashurgeek" />
  <meta name="twitter:creator" content="@kashurgeek" />
  <meta name="twitter:url" content={formattedCanonical} />
  <meta name="twitter:title" content={formattedTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={computedAlt} />

  <!-- Linked Data Structured Schema (JSON-LD) -->
  <script is:inline type="application/ld+json" set:html={safeJsonLdString}></script>
  <!-- Theme script for anti-flash and View Transitions sync -->
  <script is:inline>
    const normalizeTheme = (theme) => {
      if (theme === 'editorialLight' || theme === 'light') return 'editorialLight';
      if (theme === 'editorialDark' || theme === 'dark') return 'editorialDark';
      return window.matchMedia('(prefers-color-scheme: dark)').matches
        ? 'editorialDark'
        : 'editorialLight';
    };

    const applyTheme = () => {
      const saved = window.localStorage ? window.localStorage.getItem('theme') : null;
      const targetTheme = normalizeTheme(saved);
      document.documentElement.setAttribute('data-theme', targetTheme);
    };

    applyTheme();
    if (!window.__theme_after_swap_bound__) {
      window.__theme_after_swap_bound__ = true;
      document.addEventListener('astro:after-swap', applyTheme);
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
        const saved = window.localStorage ? window.localStorage.getItem('theme') : null;
        if (
          saved === 'editorialDark' ||
          saved === 'dark' ||
          saved === 'editorialLight' ||
          saved === 'light'
        ) {
          return;
        }
        applyTheme();
      });
    }
  </script>
</head>
