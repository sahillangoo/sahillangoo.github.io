---
import { SITE } from '@/const/site.ts';
import { ClientRouter } from 'astro:transitions';

export interface BreadcrumbItem {
  name: string;
  item: string;
}

export interface Props {
  title?: string;
  description?: string;
  keywords?: string | string[];
  image?: string;
  canonicalUrl?: string;
  type?: 'website' | 'article' | 'profile';
  publishDate?: string;
  updatedDate?: string;
  breadcrumbs?: BreadcrumbItem[];
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
  noindex?: boolean;
}

const {
  title = SITE.title,
  description = SITE.description,
  keywords,
  image = '/og/default.png',
  canonicalUrl = Astro.url.href,
  type = 'website',
  publishDate,
  updatedDate,
  breadcrumbs,
  structuredData,
  noindex = false,
} = Astro.props;

// Format keywords
const formattedKeywords = Array.isArray(keywords)
  ? keywords.join(', ')
  : keywords ||
    'Sahil Langoo, Full Stack Engineer, Systems Architect, Astro 7, TypeScript, Cloudflare Workers, Hono, Web Performance, SquadCoders, Distributed Edge Systems';

// Ensure trailing slash consistency for canonical URLs (unless file with extension)
const formattedCanonical =
  canonicalUrl.endsWith('/') || canonicalUrl.includes('.') ? canonicalUrl : `${canonicalUrl}/`;

const formattedTitle =
  title === SITE.title || title.endsWith(SITE.name) ? title : `${title} — ${SITE.name}`;
const siteUrl = SITE.url;
const ogImage = image.startsWith('http')
  ? image
  : `${siteUrl}${image.startsWith('/') ? '' : '/'}${image}`;

// Core Schema: Person & WebSite
const personSchema = {
  '@type': 'Person',
  '@id': `${siteUrl}/#person`,
  name: SITE.name,
  url: SITE.url,
  image: `${siteUrl}/og/default.png`,
  jobTitle: 'Full Stack Systems Engineer & Co-Founder',
  worksFor: {
    '@type': 'Organization',
    name: 'SquadCoders',
    url: 'https://github.com/SquadCoders',
  },
  hasOccupation: {
    '@type': 'Occupation',
    name: 'Full Stack Systems Engineer & Systems Architect',
    description:
      'Designing high-performance web systems, distributed edge proxies on Cloudflare Workers, and minimalist UI craft.',
  },
  alumniOf: {
    '@type': 'EducationalOrganization',
    name: 'University of Kashmir',
  },
  sameAs: [
    SITE.social.github,
    SITE.social.linkedin,
    SITE.social.twitter,
    SITE.social.facebook,
    SITE.social.instagram,
    SITE.social.devto,
    SITE.social.dailydev,
  ],
  knowsAbout: [
    'TypeScript',
    'Astro',
    'Next.js',
    'React',
    'Cloudflare Workers',
    'Meta Conversions API (CAPI)',
    'Cloudflare Turnstile',
    'Partytown',
    'Tailwind CSS',
    'daisyUI',
    'Bun',
    'Web Performance',
    'Distributed Systems',
    'Zod Type Safety',
  ],
};

const webSiteSchema = {
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  publisher: {
    '@id': `${siteUrl}/#person`,
  },
  inLanguage: 'en-US',
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${siteUrl}/blog/?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};

// Breadcrumb Schema
const breadcrumbSchema =
  breadcrumbs && breadcrumbs.length > 0
    ? {
        '@type': 'BreadcrumbList',
        '@id': `${formattedCanonical}#breadcrumb`,
        itemListElement: breadcrumbs.map((crumb, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: crumb.name,
          item: crumb.item.startsWith('http')
            ? crumb.item
            : `${siteUrl}${crumb.item.startsWith('/') ? '' : '/'}${crumb.item}`,
        })),
      }
    : null;

// Graph aggregation
const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    personSchema,
    webSiteSchema,
    ...(breadcrumbSchema ? [breadcrumbSchema] : []),
    ...(Array.isArray(structuredData) ? structuredData : structuredData ? [structuredData] : []),
  ],
};
---

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href={formattedCanonical} />
  <!-- RSS Feed Autodiscovery -->
  <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
  <!-- AI LLM Discovery -->
  <link rel="alternate" type="text/markdown" title="LLM Knowledge Base" href="/llms.txt" />
  <meta name="generator" content={Astro.generator} />

  {noindex && <meta name="robots" content="noindex, nofollow" />}
  {
    !noindex && (
      <meta
        name="robots"
        content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
      />
    )
  }

  <!-- Duplicate Content & Crawler Shield for Preview / Secondary Subdomains -->
  <script is:inline>
    (() => {
      const h = window.location.hostname;
      if (h !== 'sahillangoo.in' && h !== 'localhost' && h !== '127.0.0.1') {
        const meta = document.createElement('meta');
        meta.name = 'robots';
        meta.content = 'noindex, nofollow, noarchive';
        document.head.appendChild(meta);
        if (h.includes('github.io') || h.includes('pages.dev') || h.startsWith('www.')) {
          window.location.replace(
            'https://sahillangoo.in' +
              window.location.pathname +
              window.location.search +
              window.location.hash
          );
        }
      }
    })();
  </script>

  <!-- Astro View Transitions Router -->
  <ClientRouter />

  <!-- Primary Meta Tags -->
  <title>{formattedTitle}</title>
  <meta name="title" content={formattedTitle} />
  <meta name="description" content={description} />
  <meta name="keywords" content={formattedKeywords} />
  <meta name="author" content={SITE.author} />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content={type} />
  <meta property="og:url" content={formattedCanonical} />
  <meta property="og:title" content={formattedTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={formattedTitle} />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:locale" content="en_US" />
  {publishDate && <meta property="article:published_time" content={publishDate} />}
  {updatedDate && <meta property="article:modified_time" content={updatedDate} />}
  {publishDate && <meta property="article:author" content={SITE.name} />}

  <!-- Twitter / X Cards -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@kashurgeek" />
  <meta name="twitter:creator" content="@kashurgeek" />
  <meta name="twitter:url" content={formattedCanonical} />
  <meta name="twitter:title" content={formattedTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={formattedTitle} />

  <!-- Linked Data Structured Schema (JSON-LD) -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <!-- Theme script for anti-flash and View Transitions sync -->
  <script is:inline>
    const normalizeTheme = (theme) => {
      if (theme === 'editorialLight' || theme === 'light') return 'editorialLight';
      if (theme === 'editorialDark' || theme === 'dark') return 'editorialDark';
      return window.matchMedia('(prefers-color-scheme: dark)').matches
        ? 'editorialDark'
        : 'editorialLight';
    };

    const applyTheme = () => {
      const saved = window.localStorage ? window.localStorage.getItem('theme') : null;
      const targetTheme = normalizeTheme(saved);
      document.documentElement.setAttribute('data-theme', targetTheme);
    };

    applyTheme();
    document.addEventListener('astro:after-swap', applyTheme);
  </script>
</head>
