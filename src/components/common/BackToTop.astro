---
import { Icon } from 'astro-icon/components';
---

<button
  id="back-to-top"
  type="button"
  aria-label="Scroll back to top"
  class="btn btn-circle btn-outline safe-right safe-bottom fixed z-40 hidden size-11 border-neutral bg-base-100 text-base-content hover:bg-base-200 sm:right-6 sm:bottom-6 sm:size-9"
>
  <Icon name="ph:arrow-up-bold" class="h-4 w-4" />
</button>

<script>
  let btnElement: HTMLElement | null = null;
  let isVisible = false;
  let scrollTicking = false;
  let lenisListenerAttached = false;

  function updateButtonVisibility(): void {
    if (!btnElement) return;
    const win = window as unknown as LenisWindow;
    const currentY = win.lenis?.scroll ?? window.scrollY;
    const shouldShow = currentY > 400;

    if (shouldShow !== isVisible) {
      isVisible = shouldShow;
      btnElement.classList.toggle('hidden', !shouldShow);
      btnElement.classList.toggle('flex', shouldShow);
    }
    scrollTicking = false;
  }

  function onScroll(): void {
    if (!scrollTicking) {
      scrollTicking = true;
      requestAnimationFrame(updateButtonVisibility);
    }
  }

  // Delegated click listener registered once at module evaluation
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement | null)?.closest('#back-to-top');
    if (!btn) return;

    e.preventDefault();
    e.stopPropagation();

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const win = window as unknown as LenisWindow;
    if (win.lenis) {
      win.lenis.scrollTo(0, {
        duration: prefersReducedMotion ? 0 : 1.4,
        immediate: prefersReducedMotion,
        easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      });
    } else {
      window.scrollTo({ top: 0, behavior: prefersReducedMotion ? 'auto' : 'smooth' });
    }
  });

  // Native window scroll registered once at module evaluation
  window.addEventListener('scroll', onScroll, { passive: true });

  document.addEventListener('astro:before-swap', () => {
    btnElement = null;
    isVisible = false;
    scrollTicking = false;
  });

  document.addEventListener('astro:page-load', () => {
    btnElement = document.getElementById('back-to-top');
    isVisible = false;
    updateButtonVisibility();

    // Attach to Lenis singleton exactly once
    const win = window as unknown as LenisWindow;
    if (win.lenis && !lenisListenerAttached) {
      win.lenis.on('scroll', onScroll);
      lenisListenerAttached = true;
    }
  });
</script>
