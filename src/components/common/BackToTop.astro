---
import { Icon } from 'astro-icon/components';
---

<button
  id="back-to-top"
  type="button"
  aria-label="Scroll back to top"
  class="btn btn-circle btn-sm border-base-300 bg-base-100/90 text-base-content hover:bg-base-200 hover:text-accent fixed right-6 bottom-6 z-40 hidden shadow-lg backdrop-blur-md transition-all active:scale-99"
>
  <Icon name="ph:arrow-up-bold" class="h-4 w-4" />
</button>

<script>
  type LenisWindow = Window & { lenis?: import('lenis').default };

  const toggleVisibility = () => {
    const btn = document.getElementById('back-to-top');
    if (!btn) return;
    const win = window as unknown as LenisWindow;
    const currentY = win.lenis?.scroll ?? window.scrollY;
    if (currentY > 400) {
      btn.classList.remove('hidden');
      btn.classList.add('flex');
    } else {
      btn.classList.add('hidden');
      btn.classList.remove('flex');
    }
  };

  window.addEventListener('scroll', toggleVisibility, { passive: true });

  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement | null)?.closest('#back-to-top');
    if (btn) {
      e.preventDefault();
      e.stopPropagation();
      const win = window as unknown as LenisWindow;
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (win.lenis) {
        win.lenis.scrollTo(0, {
          duration: prefersReducedMotion ? 0 : 1.4,
          immediate: prefersReducedMotion,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        });
      } else {
        window.scrollTo({ top: 0, behavior: prefersReducedMotion ? 'auto' : 'smooth' });
      }
    }
  });

  document.addEventListener('astro:page-load', () => {
    toggleVisibility();
    const win = window as unknown as LenisWindow;
    if (win.lenis) {
      win.lenis.on('scroll', toggleVisibility);
    }
  });
</script>
