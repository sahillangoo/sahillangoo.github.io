---
import { Icon } from 'astro-icon/components';
---

<div
  id="text-quote-tooltip"
  class="border-base-300 bg-base-100/95 fixed z-50 hidden -translate-x-1/2 -translate-y-full rounded-lg border p-1 text-xs backdrop-blur-md"
  role="tooltip"
  aria-hidden="true"
>
  <div class="flex items-center gap-1">
    <button
      id="quote-copy-link-btn"
      type="button"
      class="btn btn-ghost btn-xs text-base-content hover:bg-base-200/80 px-2.5 font-mono"
      title="Copy direct link to highlighted passage"
    >
      <Icon name="ph:link-bold" class="text-accent size-3.5" />
      <span id="quote-btn-label">Copy Quote Link</span>
    </button>

    <div class="bg-base-300 h-3 w-px"></div>

    <button
      id="quote-share-x-btn"
      type="button"
      class="btn btn-ghost btn-xs text-base-content hover:text-accent hover:bg-base-200/80 gap-1 px-2"
      title="Share quote on X (Twitter)"
      aria-label="Share quote on X"
    >
      <Icon name="ph:x-logo-bold" class="size-3.5" />
    </button>
  </div>
  <!-- Pointer Arrow -->
  <div class="border-base-300 bg-base-100 absolute -bottom-1 left-1/2 size-2 -translate-x-1/2 rotate-45 border-r border-b"></div>
</div>

<script>
  let selectedText = '';
  let copyTimeoutId: ReturnType<typeof setTimeout> | null = null;
  let isInitialized = false;

  async function playAudioClick(type: 'soft' | 'mechanical' | 'toggle' | 'bell' = 'soft') {
    if (typeof window !== 'undefined' && localStorage.getItem('sl_sound_effects') === 'enabled') {
      const { audioEngine } = await import('@utils/audioEngine.ts');
      audioEngine.playClick(type);
    }
  }

  function getTooltip() {
    return document.getElementById('text-quote-tooltip');
  }

  function hideTooltip() {
    const tooltip = getTooltip();
    if (tooltip && !tooltip.classList.contains('hidden')) {
      tooltip.classList.add('hidden');
      tooltip.setAttribute('aria-hidden', 'true');
    }
  }

  function handleSelection() {
    const tooltip = getTooltip();
    if (!tooltip) return;

    const selection = window.getSelection();
    if (!selection || selection.isCollapsed || !selection.rangeCount) {
      hideTooltip();
      return;
    }

    const text = selection.toString().trim();
    if (text.length < 6 || text.length > 300) {
      hideTooltip();
      return;
    }

    const anchorNode = selection.anchorNode;
    const articleEl = anchorNode?.parentElement?.closest('article, .prose');
    if (!articleEl) {
      hideTooltip();
      return;
    }

    selectedText = text;
    const range = selection.getRangeAt(0);
    const rect = range.getBoundingClientRect();
    const tooltipWidth = 180;
    const halfWidth = tooltipWidth / 2;
    const padding = 12;

    const rawLeft = rect.left + rect.width / 2;
    const clampedLeft = Math.max(
      halfWidth + padding,
      Math.min(window.innerWidth - halfWidth - padding, rawLeft)
    );
    tooltip.style.left = `${clampedLeft}px`;

    if (rect.top < 60) {
      tooltip.style.top = `${rect.bottom + 12}px`;
      tooltip.classList.remove('-translate-y-full');
      tooltip.classList.add('translate-y-0');
    } else {
      tooltip.style.top = `${rect.top - 8}px`;
      tooltip.classList.remove('translate-y-0');
      tooltip.classList.add('-translate-y-full');
    }

    tooltip.classList.remove('hidden');
    tooltip.setAttribute('aria-hidden', 'false');
  }

  function scheduleSelection() {
    requestAnimationFrame(() => {
      handleSelection();
    });
  }

  if (!isInitialized) {
    isInitialized = true;

    document.addEventListener('mouseup', scheduleSelection, { passive: true });
    document.addEventListener('touchend', scheduleSelection, { passive: true });
    document.addEventListener('scroll', hideTooltip, { passive: true });
    document.addEventListener('mousedown', (e) => {
      const tooltip = getTooltip();
      if (tooltip && !tooltip.contains(e.target as Node)) {
        hideTooltip();
      }
    });

    document.addEventListener('astro:before-swap', () => {
      if (copyTimeoutId) {
        clearTimeout(copyTimeoutId);
        copyTimeoutId = null;
      }
      hideTooltip();
    });

    document.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;

      const copyBtn = target.closest('#quote-copy-link-btn');
      if (copyBtn && selectedText) {
        e.preventDefault();
        e.stopPropagation();
        const encodedFragment = encodeURIComponent(selectedText.replace(/[\n\r]+/g, ' '));
        const targetUrl = `${window.location.origin}${window.location.pathname}#:~:text=${encodedFragment}`;
        try {
          await navigator.clipboard.writeText(targetUrl);
          await playAudioClick('soft');
          const labelSpan = document.getElementById('quote-btn-label');
          if (labelSpan) {
            labelSpan.textContent = 'Copied!';
            if (copyTimeoutId) clearTimeout(copyTimeoutId);
            copyTimeoutId = setTimeout(() => {
              if (labelSpan) labelSpan.textContent = 'Copy Quote Link';
              hideTooltip();
              copyTimeoutId = null;
            }, 1200);
          }
        } catch {
          // Clipboard fallback
        }
        return;
      }

      const shareXBtn = target.closest('#quote-share-x-btn');
      if (shareXBtn && selectedText) {
        e.preventDefault();
        e.stopPropagation();
        await playAudioClick('soft');
        const excerpt =
          selectedText.length > 180 ? selectedText.slice(0, 177) + '...' : selectedText;
        const tweetText = `"${excerpt}"\n\nby @kashurgeek`;
        const tweetUrl = `https://x.com/intent/post?text=${encodeURIComponent(tweetText)}&url=${encodeURIComponent(window.location.href)}`;
        window.open(tweetUrl, '_blank', 'noopener,noreferrer,width=550,height=420');
        hideTooltip();
      }
    });
  }
</script>
