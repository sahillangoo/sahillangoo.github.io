---
import SeoHead, { type BreadcrumbItem } from '@components/common/SeoHead.astro';
import NavigationBar from '@components/common/NavigationBar.astro';
import MobileNavigation from '@components/common/MobileNavigation.astro';
import SiteFooter from '@components/common/SiteFooter.astro';
import CommandPalette from '@components/common/CommandPalette.astro';
import BackToTop from '@components/common/BackToTop.astro';
import CodeCopyScript from '@components/common/CodeCopyScript.astro';
import TextQuoteTooltip from '@components/blog/TextQuoteTooltip.astro';
import CloudflareEmailDecoder from '@components/common/CloudflareEmailDecoder.astro';
import CloudflareAnalytics from '@components/common/CloudflareAnalytics.astro';
import { cn } from '@utils/cn.ts';
import '@styles/global.css';
import 'lenis/dist/lenis.css';

export interface Props {
  title?: string;
  description?: string;
  keywords?: string | string[];
  image?: string;
  canonicalUrl?: string;
  type?: 'website' | 'article' | 'profile';
  publishDate?: string;
  updatedDate?: string;
  breadcrumbs?: BreadcrumbItem[];
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
  noindex?: boolean;
  hideFooter?: boolean;
  hideNav?: boolean;
}

const {
  title,
  description,
  keywords,
  image,
  canonicalUrl,
  type,
  publishDate,
  updatedDate,
  breadcrumbs,
  structuredData,
  noindex,
  hideFooter = false,
  hideNav = false,
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="editorialDark">
  <SeoHead
    title={title}
    description={description}
    keywords={keywords}
    image={image}
    canonicalUrl={canonicalUrl}
    type={type}
    publishDate={publishDate}
    updatedDate={updatedDate}
    breadcrumbs={breadcrumbs}
    structuredData={structuredData}
    noindex={noindex}
  />
  <body class="bg-base-100 text-base-content relative flex min-h-screen flex-col antialiased">
    <!-- Non-intrusive Tactile Noise Texture Overlay -->
    <div class="noise-overlay" aria-hidden="true"></div>

    {!hideNav && <NavigationBar />}
    <MobileNavigation />
    <CommandPalette />
    <BackToTop />
    <CodeCopyScript />
    <TextQuoteTooltip />
    <CloudflareEmailDecoder />
    <CloudflareAnalytics />

    <main id="main-content" class:list={cn('w-full grow', hideNav ? 'pt-0' : 'pt-20 md:pt-24')}>
      <slot />
    </main>

    {!hideFooter && <SiteFooter />}

    <script>
      import Lenis from 'lenis';

      type LenisWindow = Omit<Window, 'lenis'> & { lenis?: Lenis };

      function getOrCreateLenis(): Lenis {
        const win = window as unknown as LenisWindow;
        if (!win.lenis) {
          win.lenis = new Lenis({
            autoRaf: true, // Managed requestAnimationFrame loop
            lerp: 0.055, // Ultra-Liquid Cinematic Float (buttery Awwwards/Antigravity inertia)
            smoothWheel: true, // Smooth wheel events for physical mice & trackpads
            syncTouch: false, // Strictly false: Preserve native 120Hz mobile compositor momentum
            wheelMultiplier: 0.9, // Balanced luxury wheel travel ratio (prevents runaway acceleration)
            touchMultiplier: 1.0,
            autoResize: true, // Auto-detect container size changes via ResizeObserver
            stopInertiaOnNavigate: true, // Cut momentum immediately when navigating across pages
            respectReducedMotion: true, // Automatically disable smoothing on prefers-reduced-motion
          });
        }
        return win.lenis;
      }

      // Initialize immediately on first script load
      getOrCreateLenis();

      // Lifecycle Coordination for Astro View Transitions (<ClientRouter />)
      let hashClickListener: ((e: MouseEvent) => void) | null = null;

      function setupHashSmoothScroll(): void {
        if (hashClickListener) {
          document.removeEventListener('click', hashClickListener);
        }

        hashClickListener = (e: MouseEvent): void => {
          if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;

          const anchor = (e.target as Element | null)?.closest<HTMLAnchorElement>('a[href*="#"]');
          if (!anchor) return;

          const rawHref = anchor.getAttribute('href');
          if (!rawHref) return;

          let targetUrl: URL;
          try {
            targetUrl = new URL(rawHref, window.location.href);
          } catch {
            return;
          }

          // Only handle same-page hash links; let ClientRouter handle cross-page routes
          const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
          const targetPath = targetUrl.pathname.replace(/\/$/, '') || '/';
          if (targetUrl.origin !== window.location.origin || currentPath !== targetPath) return;

          const hash = targetUrl.hash;
          if (!hash || hash === '#') return;

          const targetEl =
            hash === '#top'
              ? (document.querySelector('#top') as HTMLElement | null) || document.body
              : (document.querySelector(hash) as HTMLElement | null);

          if (!targetEl) return;

          e.preventDefault();

          const lenis = getOrCreateLenis();
          const prefersReducedMotion = window.matchMedia(
            '(prefers-reduced-motion: reduce)'
          ).matches;

          // Programmatic transitions use the signature 1.4s editorial easing curve
          lenis.scrollTo(targetEl, {
            duration: prefersReducedMotion ? 0 : 1.4,
            immediate: prefersReducedMotion,
            easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          });

          if (window.location.hash !== hash) {
            window.history.pushState(null, '', hash);
          }
        };

        document.addEventListener('click', hashClickListener);
      }

      // Teardown Lenis and listeners before Astro swaps the DOM
      document.addEventListener('astro:before-swap', () => {
        document.body.style.overflow = '';
        if (hashClickListener) {
          document.removeEventListener('click', hashClickListener);
          hashClickListener = null;
        }
        const win = window as unknown as LenisWindow;
        if (win.lenis) {
          win.lenis.destroy();
          win.lenis = undefined;
        }
      });

      // Reinitialize and restore hash position on page load
      document.addEventListener('astro:page-load', () => {
        const lenis = getOrCreateLenis();
        setupHashSmoothScroll();

        if (window.location.hash) {
          const hash = window.location.hash;
          const target = hash === '#top' ? 0 : document.querySelector(hash);
          if (target instanceof HTMLElement || target === 0) {
            lenis.scrollTo(target, { immediate: true });
          }
        }
      });
    </script>
  </body>
</html>
