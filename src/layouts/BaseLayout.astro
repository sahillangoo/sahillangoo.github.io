---
import SeoHead, { type BreadcrumbItem } from '@components/common/SeoHead.astro';
import NavigationBar from '@components/common/NavigationBar.astro';
import MobileNavigation from '@components/common/MobileNavigation.astro';
import SiteFooter from '@components/common/SiteFooter.astro';
import CommandPalette from '@components/common/CommandPalette.astro';
import BackToTop from '@components/common/BackToTop.astro';
import CodeCopyScript from '@components/common/CodeCopyScript.astro';
import TextQuoteTooltip from '@components/blog/TextQuoteTooltip.astro';
import CloudflareEmailDecoder from '@components/common/CloudflareEmailDecoder.astro';
import { cn } from '@utils/cn.ts';
import '@styles/global.css';
import 'lenis/dist/lenis.css';

export interface Props {
  title?: string;
  description?: string;
  keywords?: string | string[];
  image?: string;
  canonicalUrl?: string;
  type?: 'website' | 'article' | 'profile';
  publishDate?: string;
  updatedDate?: string;
  breadcrumbs?: BreadcrumbItem[];
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
  noindex?: boolean;
  hideFooter?: boolean;
  hideNav?: boolean;
}

const {
  title,
  description,
  keywords,
  image,
  canonicalUrl,
  type,
  publishDate,
  updatedDate,
  breadcrumbs,
  structuredData,
  noindex,
  hideFooter = false,
  hideNav = false,
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="editorialDark">
  <SeoHead
    title={title}
    description={description}
    keywords={keywords}
    image={image}
    canonicalUrl={canonicalUrl}
    type={type}
    publishDate={publishDate}
    updatedDate={updatedDate}
    breadcrumbs={breadcrumbs}
    structuredData={structuredData}
    noindex={noindex}
  />
  <body class="bg-base-100 text-base-content relative flex min-h-screen flex-col antialiased">
    <!-- Non-intrusive Tactile Noise Texture Overlay -->
    <div class="noise-overlay" aria-hidden="true"></div>

    {!hideNav && <NavigationBar />}
    <MobileNavigation />
    <CommandPalette />
    <BackToTop />
    <CodeCopyScript />
    <TextQuoteTooltip />
    <CloudflareEmailDecoder />

    <main id="main-content" class={cn('w-full grow', hideNav ? 'pt-0' : 'pt-20 md:pt-24')}>
      <slot />
    </main>

    {!hideFooter && <SiteFooter />}

    <script>
      type LenisType = import('lenis').default;
      let lenisInstance: LenisType | null = null;
      let lenisPromise: Promise<LenisType | null> | null = null;

      async function getLenis(): Promise<LenisType | null> {
        if (typeof window === 'undefined') return null;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          return null;
        }
        if (lenisInstance) return lenisInstance;
        if (lenisPromise) return lenisPromise;

        lenisPromise = import('lenis')
          .then(({ default: Lenis }) => {
            lenisInstance = new Lenis({
              autoRaf: true,
              duration: 0.9,
              easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
            });
            return lenisInstance;
          })
          .catch(() => null);

        return lenisPromise;
      }

      getLenis();

      document.addEventListener('astro:before-swap', () => {
        if (lenisInstance) {
          lenisInstance.stop();
        }
      });

      document.addEventListener('astro:after-swap', () => {
        document.body.style.overflow = '';
      });

      document.addEventListener('astro:page-load', async () => {
        const lenis = await getLenis();
        if (lenis) {
          lenis.resize();
          lenis.start();
          if (window.location.hash) {
            const target = document.querySelector(window.location.hash);
            if (target) {
              lenis.scrollTo(target as HTMLElement, { immediate: true });
            }
          }
        }
      });
    </script>
  </body>
</html>
