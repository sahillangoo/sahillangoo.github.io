# ==============================================================================
# Cloudflare Pages Headers - Sahil Langoo Portfolio (sahillangoo.in)
# Security, Caching, Anti-Crawling on Preview & Production Header Configuration
# ==============================================================================

# 1. Global Baseline Security, Privacy & Content Freshness
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  X-Permitted-Cross-Domain-Policies: none
  X-XSS-Protection: 0
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: data: https://static.cloudflareinsights.com https://challenges.cloudflare.com https://www.googletagmanager.com https://www.clarity.ms https://scripts.clarity.ms; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: data:; frame-src 'self' https://challenges.cloudflare.com https://open.spotify.com; worker-src 'self' blob: data:; connect-src 'self' blob: data: https://api.open-meteo.com https://cloudflareinsights.com https://static.cloudflareinsights.com https://challenges.cloudflare.com https://api.github.com https://www.google-analytics.com https://*.google-analytics.com https://analytics.google.com https://*.clarity.ms https://c.bing.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; upgrade-insecure-requests;
  Cache-Control: public, max-age=0, must-revalidate
  Link: </llms.txt>; rel="describedby"; type="text/markdown"
  Content-Signal: ai-train=yes, ai-input=yes, search=yes

# 2. Block Search Engine Crawling on Cloudflare Pages Preview Subdomains & GitHub Pages
https://*.pages.dev/*
  X-Robots-Tag: noindex, nofollow, noarchive

https://sahillangoo-portfolio.pages.dev/*
  X-Robots-Tag: noindex, nofollow, noarchive

https://*.github.io/*
  X-Robots-Tag: noindex, nofollow, noarchive

https://sahillangoo.github.io/*
  X-Robots-Tag: noindex, nofollow, noarchive

# 3. Immutable Astro Bundled Assets (Content-Hashed JS, CSS, Fonts, Images)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# 4. Web Fonts (Immutable Long-Term Cache)
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff

/*.woff
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff

# 5. Static Images & Favicons (30 Days with SWR)
/*.webp
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
  X-Content-Type-Options: nosniff

/*.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
  X-Content-Type-Options: nosniff

/*.svg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
  X-Content-Type-Options: nosniff

/*.ico
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

