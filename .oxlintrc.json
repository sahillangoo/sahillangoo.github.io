{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "jsx-a11y", "promise", "node", "import"],
  "categories": {
    "correctness": "error",
    "perf": "warn",
    "suspicious": "warn"
  },
  "rules": {
    "typescript/triple-slash-reference": "off",
    "no-underscore-dangle": "off",
    "no-await-in-loop": "off",
    "no-empty": "error",
    "no-unused-vars": "warn",
    "no-useless-catch": "error",
    "no-debugger": "error",
    "import/no-unassigned-import": "off",
    "import/no-named-as-default-member": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/no-array-reverse": "off"
  },
  "ignorePatterns": [
    "dist/**",
    ".output/**",
    ".astro/**",
    ".mf/**",
    ".unlighthouse/**",
    "public/pagefind/**",
    ".wrangler/**",
    ".vercel/**",
    ".netlify/**",
    "node_modules/**",
    "**/*.log",
    ".eslintcache",
    ".prettiercache",
    ".oxlintcache",
    ".parcel-cache/**",
    ".turbo/**",
    "test-results/**",
    "playwright-report/**",
    "blob-report/**",
    "playwright/.cache/**",
    "playwright/.auth/**",
    ".playwright-browsers/**",
    ".github/**",
    ".agents/**",
    ".codex/**",
    ".cursor/**",
    "**/*.d.ts"
  ]
}
